#!/usr/bin/env python3
"""helm CLI entry — resolves the package relative to this file (through any
symlink, e.g. ~/.local/bin/helm) so the checkout is runnable with zero install."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from helm.cli import main  # noqa: E402

sys.exit(main())
