@@ -0,0 +1,117 @@
+// Proposed synthetic controls only. NOT_RUN; no credentials, network or capture.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import https from 'node:https';
+process.env.HELM_DEVIN_PRIVACY_PROFILE = '1';
+const { decodeFrame, streamChat, mintUserJwt, DEFAULT_CALL_TAGS,
+  mergeToolCallFragment, validatePrivacyCalls, validatePrivacyToolHistory,
+  __setRequestImpl } = await import('../src/devin-connect.js');
+const { StreamingFrameParser } = await import('../src/connect.js');
+const field = (tag, value) => Buffer.concat([
+  Buffer.from([(tag << 3) | 2, value.length]), value,
+]);
+const call = (fields) => field(6, Buffer.concat(fields));
+const nativeOpts = { toolCallTags: DEFAULT_CALL_TAGS, toolNames: ['read_file'] };
+
+test('bounded response and strict numeric tag/wire/metadata shape', () => {
+  assert.throws(() => decodeFrame(Buffer.alloc(128 * 1024 + 1)),
+    { code: 'ERR_DEVIN_PRIVACY_FRAME_LENGTH' });
+  assert.throws(() => decodeFrame(Buffer.from([0x50, 0x01])),
+    { code: 'ERR_DEVIN_PRIVACY_UNKNOWN_TAG' });
+  assert.throws(() => decodeFrame(Buffer.from([0x1a, 0x04])),
+    { code: 'ERR_DEVIN_PRIVACY_FRAME_PARSE' });
+  assert.throws(() => decodeFrame(Buffer.from([0x3a, 0x02, 0x20, 0x01])),
+    { code: 'ERR_DEVIN_PRIVACY_UNKNOWN_METADATA_TAG' });
+  assert.throws(() => decodeFrame(Buffer.alloc(0), { dumpMeta: true }),
+    { code: 'ERR_DEVIN_PRIVACY_DEBUG' });
+});
+
+test('fragmented calls assemble only while one ID is pinned', () => {
+  const id = field(1, Buffer.from('call_1'));
+  const name = field(2, Buffer.from('read_file'));
+  const args = (s) => field(3, Buffer.from(s));
+  const assembled = [];
+  for (const frag of [call([id, name]), call([args('{"p')]), call([args('ath":"x"}')])]) {
+    for (const tc of decodeFrame(frag, nativeOpts).toolCalls) mergeToolCallFragment(assembled, tc);
+  }
+  assert.equal(validatePrivacyCalls(assembled, ['read_file'])[0].id, 'call_1');
+  // Structural result correlation only; external upstream custody is still unproven.
+  const history = [{ role: 'assistant', tool_calls: [{ id: assembled[0].id,
+    function: { name: assembled[0].name, arguments: assembled[0].arguments } }] },
+  { role: 'tool', tool_call_id: 'call_1', content: 'synthetic' }];
+  assert.doesNotThrow(() => validatePrivacyToolHistory(history));
+  assert.throws(() => validatePrivacyToolHistory([history[0],
+    { ...history[1], tool_call_id: 'call_wrong' }]),
+  { code: 'ERR_DEVIN_PRIVACY_RESULT_ID' });
+  assert.throws(() => decodeFrame(call([id, args('{}')]), nativeOpts),
+    { code: 'ERR_DEVIN_PRIVACY_TOOL_NAME' });
+  assert.throws(() => decodeFrame(call([id, name, args('{}'), field(4, Buffer.from('secret'))]), nativeOpts),
+    { code: 'ERR_DEVIN_PRIVACY_TOOL_TAG' });
+  assert.throws(() => mergeToolCallFragment(assembled, { id: 'call_1', name: 'read_file' }),
+    { code: 'ERR_DEVIN_PRIVACY_CALL_CORRELATION' });
+  mergeToolCallFragment(assembled, { id: 'call_2', name: 'read_file' });
+  assert.throws(() => mergeToolCallFragment(assembled, { arguments: '{"x":1}' }),
+    { code: 'ERR_DEVIN_PRIVACY_AMBIGUOUS_FRAGMENT' });
+  for (const json of ['{broken', '{"x":1e999}', '{"x":[1e999]}', '{"x":{"n":1e999}}']) {
+    assert.throws(() => validatePrivacyCalls([{ id: 'call_1', name: 'read_file', arguments: json }], ['read_file']),
+      { code: 'ERR_DEVIN_PRIVACY_FINAL_JSON' });
+  }
+});
+
+test('Connect frame accounting is chunk independent', () => {
+  const wire = Buffer.concat([Buffer.from([0, 0, 0, 0, 2, 0x1a, 0]),
+    Buffer.from([2, 0, 0, 0, 2, 0x7b, 0x7d])]);
+  const one = new StreamingFrameParser(128 * 1024);
+  one.push(wire);
+  const two = new StreamingFrameParser(128 * 1024);
+  two.push(wire.subarray(0, 3));
+  two.push(wire.subarray(3));
+  assert.equal(one.drain().length, 2);
+  assert.equal(two.drain().length, 2);
+  // One >128KiB Node chunk may hold TWO valid <128KiB Connect frames.
+  const envelope = () => { const header = Buffer.alloc(5); header.writeUInt32BE(70 * 1024, 1);
+    return Buffer.concat([header, Buffer.alloc(70 * 1024)]); };
+  const coalesced = Buffer.concat([envelope(), envelope()]);
+  assert.ok(coalesced.length > 128 * 1024);
+  const whole = new StreamingFrameParser(128 * 1024);
+  whole.push(coalesced);
+  const split = new StreamingFrameParser(128 * 1024);
+  for (let i = 0; i < coalesced.length; i += 997)
+    split.push(coalesced.subarray(i, i + 997));
+  assert.equal(whole.drain().length, 2);
+  assert.equal(split.drain().length, 2);
+  const oversized = new StreamingFrameParser(128 * 1024);
+  oversized.push(Buffer.from([0, 0, 2, 0, 1]));
+  assert.throws(() => oversized.drain(), /frame size/);
+});
