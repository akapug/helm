<div class="view" id="view-quota">
  <div id="attn"></div>
  <div id="attndetail"></div>
  <div id="chartcard">
    <div class="chead"><b>quota</b>
      <span id="qtabs"><span class="qtab on" data-w="7d">weekly</span><span class="qtab" data-w="5h">session</span></span>
      <span id="qsub">remaining % · history + projection to reset</span>
    </div>
    <svg id="chart" viewBox="0 0 1400 430"></svg>
    <div id="tip"></div>
    <div id="zoomhint">scroll = zoom · drag = pan · double-click = reset</div>
  </div>
  <details class="grp" id="burncard">
    <summary>burn ↔ sessions<span class="gmeta">what was active when quota burned — last 48h, temporal join</span></summary>
    <div class="rows" id="burnrows"></div>
  </details>
  <div id="acctcard">
    <div class="afilter">
      <span class="chip on" data-f="all">all</span>
      <span class="chip" data-f="anthropic">claude</span>
      <span class="chip" data-f="codex">codex</span>
      <span style="margin-left:auto;font-size:.78rem;color:var(--mut)">click a row to select it for resumes · hover a row to spotlight its line · click a state to copy its fix</span>
    </div>
    <div class="atscroll"><table class="accts"><thead><tr id="athead"></tr></thead><tbody id="atbody"></tbody></table></div>
  </div>
  <details class="grp" id="homescard">
    <summary>credential homes<span class="gmeta">one home = one login — helm prepares, YOU run every login</span></summary>
    <div id="homeform">
      <input id="hEmail" placeholder="new home: account email (owner@x.com → home owner-x-com)" autocomplete="off">
      <select id="hProv"><option value="claude">claude</option><option value="codex">codex</option></select>
      <button class="chip" id="hCreate">new home</button>
      <div id="hCmd" style="flex-basis:100%"></div>
    </div>
    <div id="homerows"></div>
  </details>
</div>

