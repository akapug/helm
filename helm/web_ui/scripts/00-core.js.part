"use strict";
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
/* (The browser-side identity launder `mpLaunder` lived here. It existed
   because the retired cave panel folded the BLIND relay's opaque updates in
   the CLIENT, so the server structurally could not launder a decoded cell —
   the browser had to. Nothing folds an opaque update here any more: every
   surface on this page is server-rendered JSON that chat._dsan / fleetnotes'
   own refusal-at-the-seam already laundered, so the client-side copy went
   with the panel rather than sitting unused and drifting.) */
let TOKEN = "__HELM_TOKEN__"; // per-process anti-CSRF bearer, templated in by the server — every POST carries it
/* The bearer is PER-PROCESS and this tab is LONG-LIVED: the web unit recycles
   under it (RuntimeMaxSec=1h bound-staleness expiry, `helm rearm`), minting a
   fresh token while the open page still holds the dead one — the owner's first
   post after coming back then 403'd until a manual reload. Recovery: re-read
   our own served page (same-origin — a hostile origin cannot; _same_origin
   gates the GET) and lift the live token from the templated declaration above.
   The marker literal is split below so serve-time substitution (_ui) cannot
   rewrite this guard into comparing against the live token. */
async function refreshToken() {
  const html = await (await fetch("/", {cache: "no-store"})).text();
  const key = 'let TOKEN = "', i = html.indexOf(key);
  if (i === -1) return;
  const j = html.indexOf('"', i + key.length);
  if (j === -1) return;
  const t = html.slice(i + key.length, j);
  if (t && t !== "__HELM" + "_TOKEN__") TOKEN = t;
}
const KNOWN_H = ["claude", "codex", "opencode", "pi"];
const STORE_ORDER = ["premise", "prior", "lexicon", "heuristic", "reference", "episodic"];

let projects = [], showRetired = false;

/* one unit per magnitude so the column stays tabular (was today/1d/13d/9w/2mo,
   ragged widths that defeated tabular-nums). null stays "never" — a state,
   not a duration. */
function age(epoch) {
  if (!epoch) return "never";
  const d = Math.max(0, (Date.now() / 1000 - epoch) / 86400);  // clamp future stamps to 0d
  if (d < 14) return Math.floor(d) + "d";
  if (d < 70) return Math.floor(d / 7) + "w";
  return Math.floor(d / 30) + "mo";
}

/* `ms` is OPTIONAL and every existing caller omits it, keeping the old
   unbounded behaviour. A poll whose card must say UNKNOWN when it cannot read
   passes one: without a deadline a hung endpoint never rejects, the catch that
   renders UNKNOWN never runs, and the surface sits on whatever it last drew —
   or on nothing at all. A timeout is how "no answer" becomes an answer. */
async function j(url, ms, init) {
  /* THE THIRD ARGUMENT IS REFUSED, NEVER PASSED THROUGH (task/2621). The work
     tab's task composer called `j(url, 8000, {method: "POST", body})`. This
     helper took TWO parameters, dropped the init on the floor and issued a
     plain GET at a POST-only route — so the owner's note never left the page
     and the server answered `not found: /api/tasks/comment`, which the line
     below drew as "✗ /api/tasks/comment -> 404". Every layer downstream was
     innocent: the route is registered, the handler is correct, the bearer is
     minted. That is what a silently ignored argument buys — a defect with no
     surface anywhere except the owner's toast. So the ignoring stops: `j`
     READS, `post()` MUTATES (it carries the bearer and the stale-bearer
     retry), and a caller that hands this one a request body is told so
     instead of being quietly downgraded to a GET. */
  if (init !== undefined)
    throw new Error("j() only reads — it cannot "
      + String((init && init.method) || "mutate") + " " + url
      + "; mutations ride post(), which carries the bearer token");
  const ctl = ms ? new AbortController() : null;
  const t = ctl ? setTimeout(() => ctl.abort(), ms) : 0;
  try {
    const r = await fetch(url, ctl ? {signal: ctl.signal} : undefined);
    if (!r.ok) {
      /* THE SERVER'S OWN SENTENCE, not a bare path and a number. Every helm
         endpoint answers `{"error": ...}` and that text is the only part of
         the response that says WHY; `post()` has always read it, and a reader
         that discards it sends the owner to a browser network tab to learn
         what the body already told him. The status stays because the tier is
         a fact about the failure too. */
      const d = await r.json().catch(() => null);
      throw new Error(url + " -> " + r.status
        + (d && d.error ? ": " + d.error : ""));
    }
    return await r.json();
  } catch (e) {
    if (ctl && ctl.signal.aborted)
      /* THE PATH, on the timeout too. `timed out after 8s` names no call, so
         the owner learns that SOMETHING hung and nothing about what — the
         same browser-network-tab errand the refusal path two branches up
         exists to spare him. Found sweeping this file for siblings of the
         `post` defect (task/2650): the same question, "does this failure say
         WHERE", answered differently three lines apart. */
      throw new Error(url + " -> timed out after "
        + Math.round(ms / 1000) + "s");
    throw e;
  } finally {
    if (t) clearTimeout(t);
  }
}

function toast(m, ms) {
  const h = $("#hint");
  h.textContent = m;
  h.classList.add("show");
  clearTimeout(h._t);
  h._t = setTimeout(() => h.classList.remove("show"), ms || 2600);
}

/* ---------- nav (the predecessor's navtab pattern; helm is the default view) ---------- */
const VIEWS = ["work", "chat", "quota", "roster", "sessions", "configs", "boxes", "history"];
function canonView(v) {
  /* A RETIRED VIEW ID LANDS ON THE PAGE THAT TOOK IT OVER, so an old bookmark
     hash or a saved helm.view keeps working. Each rename ships its migration:
     storage -> boxes; the overview helm -> board -> work, when the board, the
     work tab and the scheduler became one Work page; and ledger -> history,
     the signing ledger it now is. The map lives inside the function so the
     function is whole wherever it is lifted. */
  const moved = {storage: "boxes", helm: "work", board: "work",
                 scheduler: "work", ledger: "history"};
  return Object.prototype.hasOwnProperty.call(moved, v) ? moved[v] : v;
}
/* THE OLD TABS THAT BECAME SECTIONS OF A PAGE. canonView answers which PAGE
   an old hash opens; this brings that tab's section into view, opened when it
   is a fold. Called after showView, so the page is already shown. */
function goOldSection(raw) {
  const id = {scheduler: "schedfold"}[raw];
  const el = id ? $("#" + id) : null;
  if (!el) return null;
  el.open = true;
  el.scrollIntoView({block: "start"});
  return id;
}
/* FOUR AREAS, the owner's words: "what if it was just work and history and
   history focuses on signing stuff" and "since chat already needs no sub menu,
   maybe board needs no submenu either and history just moves to the 4th item
   in the top level menu". This is a GROUPING, NOT A ROUTE: the keys are the
   view ids VIEWS carries, so canonView and every #hash still decide what
   renders; an area only decides which section row is on screen. Work, Chat
   and History are one page each and have no section row; Fleet keeps five.
   Declaration ORDER is load-bearing: the first key of an area is the section
   that area opens on, which is why firstSection() can read it off this one map
   instead of a second list that would drift from it. */
const AREA_OF = {
  work: "work",
  chat: "chat",
  quota: "fleet", roster: "fleet", sessions: "fleet", configs: "fleet",
  boxes: "fleet",
  history: "history"
};
/* the section an area REOPENS on: the last one you were on there. Clicking
   Fleet after reading the scheduler must not throw you back to quota. */
const AREA_LAST = {};
/* the badge values navBadge was GIVEN, per view, so an area can roll up the
   badges of the sections it is hiding. */
const NAV_BADGE = {};
function firstSection(area) {
  return Object.keys(AREA_OF).find(v => AREA_OF[v] === area);
}
/* A SCROLLING TAB STRIP CAN HIDE THE SELECTED TAB, which a wrapped row never
   could. Measured by a probe at 390px on #ledger: the strip opened at
   scrollLeft=0 showing x14..361 while the active Ledger tab sat at x654..727 —
   the page was ON Ledger with no selected tab in sight, which reads as "no tab
   selected" rather than "scroll right".

   Rect deltas, not offsetLeft: #nav is position:sticky, so it is the
   offsetParent and offsetLeft is measured against IT, not against the strip.
   The strip is a real box at every width since the sections moved onto their
   own row, so this runs on desktop too — and is a NO-OP there because a row
   that fits has scrollWidth == clientWidth. The no-op falls out of the
   geometry rather than needing a width test, which is also why a zero-sized
   strip (no box at all) returns immediately instead of computing against a
   zero-width rect. */
function revealActiveTab() {
  const strip = document.querySelector(".navtabs");
  const on = strip && strip.querySelector(".navtab.on");
  if (!on || strip.scrollWidth <= strip.clientWidth) return;
  const sr = strip.getBoundingClientRect(), tr = on.getBoundingClientRect();
  const pad = 12;
  if (tr.left < sr.left) strip.scrollLeft += tr.left - sr.left - pad;
  else if (tr.right > sr.right) strip.scrollLeft += tr.right - sr.right + pad;
}

/* THE NAVIGATION'S OWN HEIGHT, PUBLISHED FOR WHATEVER STICKS UNDER IT.
   #nav is sticky at top:0, so its height IS the strip of viewport a second
   sticky element has to clear. A view that hard-coded that clearance as a
   constant was correct for a one-row nav and wrong the moment the sections
   moved onto a second row: measured at 1400x900 the nav ends at 102.2 while
   the Sessions controls stick at 48, so the navigation covers the search input
   and a pointer inside the input lands on a navigation button instead. That is
   the input the view exists to type into.

   IT IS A MEASUREMENT, NOT A SECOND CONSTANT. The nav wraps at narrow widths
   and the section strip is its own row at every width, so the number changes
   with the viewport and with which area is open — every one of those is a
   render this runs after. A missing element leaves the CSS fallback in place
   rather than writing 0, because a zero clearance is the same defect again. */
function publishNavHeight() {
  const nav = $("#nav");
  if (!nav) return null;
  const h = Math.round(nav.getBoundingClientRect().height);
  if (!h) return null;
  document.documentElement.style.setProperty("--navh", h + "px");
  return h;
}
window.addEventListener("resize", publishNavHeight);

function showView(v) {
  /* the area comes FIRST: a section in a closed area is display:none, so the
     strip has to be open before the reveal below measures anything in it. */
  const area = AREA_OF[v] || "work";
  const was = showView.cur;
  showView.cur = v;
  AREA_LAST[area] = v;
  $$(".navarea").forEach(b => b.classList.toggle("on", b.dataset.a === area));
  $$(".navsec").forEach(s => s.classList.toggle("on", s.dataset.a === area));
  $$(".navtab").forEach(t => t.classList.toggle("on", t.dataset.v === v));
  // AN AREA OF ONE PAGE HAS NO SECTION ROW, so the empty row is hidden rather
  // than left as a blank band under the areas
  const strip = $(".navtabs");
  if (strip) strip.classList.toggle("solo", !$$('.navsec[data-a="' + area + '"]').length);
  $$(".view").forEach(p => p.classList.toggle("on", p.id === "view-" + v));
  localStorage.setItem("helm.view", v);
  if (location.hash !== "#" + v) history.replaceState(null, "", "#" + v);
  if (v === "quota") initQuota();
  if (v === "boxes") initStorage();
  if (v === "sessions") initSessions();
  if (v === "configs") { cfgInit(); srevInit(); }
  /* COMING BACK to Work refreshes its two queues. Not at boot: the page
     opens on Work, their always-on polls fire at load already, and a second
     fetch queued behind the page's long reads outlived its own deadline and
     drew the queue UNKNOWN (measured: the first answered in 1.3s, the
     duplicate that owned the surface timed out at 8s). */
  if (v === "work" && was && was !== "work") { odqInit(); tqInit(); }
  if (v === "chat") initChat();
  if (v === "roster") initRoster();
  if (v === "history") initLedger();
  // AFTER .on MOVES, like the reveal: opening an area changes which section
  // strip is displayed, which is one of the two things that changes the nav's
  // height. Anything sticking below it is measured against this number.
  publishNavHeight();
  revealActiveTab();   // after .on moves, so it reveals the NEW tab
}
$$(".navtab").forEach(t => t.onclick = () => showView(t.dataset.v));
/* an area opens the section you last read there, else its first. It routes
   through showView like every other selecting path, so the reveal still runs
   and the hash still ends up naming the view that is actually rendered. */
$$(".navarea").forEach(b => b.onclick = () => {
  const a = b.dataset.a;
  const v = AREA_LAST[a] || firstSection(a);
  if (v) showView(v);
});
window.addEventListener("hashchange", () => {
  const raw = location.hash.slice(1), v = canonView(raw);
  if (VIEWS.includes(v)) { showView(v); goOldSection(raw); }
});
$("#themetog").onclick = () => {
  const r = document.documentElement;
  const cur = r.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light");
  r.setAttribute("data-theme", cur === "dark" ? "light" : "dark");
};

/* ---------- greeting ---------- */
/* helm web has TWO deployment lifetimes: this file is read per REQUEST and is
   always current, while web.py is imported ONCE and frozen for the process's
   life. So a change touching both goes HALF-LIVE — new template, old server —
   and the page gives no sign. This says so. */
function staleBanner(d) {
  const el = $("#stalebanner");
  if (!el) return;
  if (!d || !d.note) { el.classList.remove("show"); return; }
  const h = Math.round((d.stale_seconds || 0) / 3600);
  const age = h >= 1 ? h + "h" : Math.max(1, Math.round((d.stale_seconds || 0) / 60)) + "m";
  el.innerHTML = "⚠ <b>this server is " + esc(age) + " behind its own source</b> — "
    + esc(d.note) + " <span style=\"opacity:.75\">(loaded " + esc(d.loaded || "?")
    + ", source " + esc(d.on_disk || "?") + ")</span>";
  el.classList.add("show");
}

function greet(w) {
  if (!w || w.unavailable) return;
  // BEFORE the name checks below, which return early. A server-age warning
  // that only appears for named operators is a warning that hides exactly
  // when the console is least configured.
  staleBanner(w.code_drift);
  const p = (w.profile && typeof w.profile === "object") ? w.profile : w;
  const name = ["name", "display_name", "operator", "user", "owner"]
    .map(k => p[k]).find(v => typeof v === "string" && v.trim());
  if (!name) return;
  const h = new Date().getHours();
  const tod = h < 5 ? "up late" : h < 12 ? "good morning" : h < 18 ? "good afternoon" : "good evening";
  const notes = Array.isArray(w.notes) ? w.notes.length : 0;
  $("#hello").innerHTML = esc(tod) + ", <b>" + esc(name.trim().split(/\s+/)[0]) +
    "</b> — your projects, remembered." + (notes ? " <span style='color:var(--sub)'>" + notes + " note" + (notes === 1 ? "" : "s") + " on file.</span>" : "");
}

/* ---------- fleet notes strip ----------
   The fleet's durable notes TO YOU (helm/fleetnotes.py; `helm note set|list|rm`).
   One note per key, replaced by whoever writes it next, newest first — the
   order "what happened overnight" is actually asked in. Predecessor: the cave
   tab's demo board, which lived in tmpfs and died on every reboot. */
const noteAgo = iso => {
  const e = Date.parse(iso || "");
  if (isNaN(e)) return "unknown time";
  const s = Math.max(0, (Date.now() - e) / 1e3);
  return s < 90 ? "just now" : s < 3600 ? Math.round(s / 60) + "m ago"
    : s < 86400 ? Math.round(s / 3600) + "h ago" : Math.round(s / 86400) + "d ago";
};
function noteGoto(raw) {
  // THE VOCABULARY IS THE FLEET'S (`helm note set --goto`), so the keys stay
  // as agents write them; each points at the page that holds it now. "board"
  // is the LAND board, the kanban on Work.
  const tabs = {
    ledger: {href: "#history", tab: "ledger", label: "go to history →"},
    chat: {href: "#chat", tab: "chat", label: "go to chat →"},
    roster: {href: "#roster", tab: "roster", label: "go to roster →"},
    board: {href: "#work", tab: "board", label: "go to board →"},
  };
  if (tabs[raw]) return tabs[raw];
  if (typeof raw === "string" && /^https?:\/\/[^\s]+$/i.test(raw))
    return {href: raw, external: true, label: "open destination ↗"};
  return null;                          // hand-planted unsafe schemes fail closed
}
function noteRowHTML(n) {
  const detail = typeof n.detail === "string" ? n.detail : "";
  const dest = noteGoto(n.goto);
  const pointer = !dest ? "" : dest.external
    ? '<a class="ngoto" href="' + esc(dest.href) + '" target="_blank" rel="noopener noreferrer">' + esc(dest.label) + '</a>'
    : '<a class="ngoto" href="' + esc(dest.href) + '" data-note-tab="' + esc(dest.tab) + '">' + esc(dest.label) + '</a>';
  return '<div class="nrow"><span class="nkey">' + esc(n.key) + '</span> ' +
    '<span class="nmeta">' + esc(n.by || "?") + " · " + esc(noteAgo(n.ts)) + '</span>' +
    '<div class="nheadline">' + esc(n.headline || n.text || "") + '</div>' +
    (detail ? '<details><summary>details</summary><div class="ndetail">' + esc(detail) + '</div></details>' : "") +
    pointer + '</div>';
}
function notesSec(d) {
  const el = $("#notesec");
  const notes = (d && !d.unavailable && Array.isArray(d.notes)) ? d.notes : [];
  if (!notes.length) { el.classList.remove("show"); el.innerHTML = ""; return; }
  // FRESH ON TOP, OLDER FOLDED — the owner asked twice why a live note was not
  // visible. Measured that night: one note 2 minutes old, five 5-8 DAYS old,
  // all rendered as equal rows under "6 left for you". Order was already
  // newest-first and each row already showed its age; what was missing is that
  // nothing SEPARATED them. `stale` is computed server-side off ONE boundary
  // (fleetnotes.FRESH_WINDOW_S) so this card and the CLI cannot disagree.
  const fresh = notes.filter(n => !n.stale);
  const older = notes.filter(n => n.stale);
  // WHEN EVERYTHING IS STALE THE FOLD OPENS. Collapsing every note would leave
  // a card that reads empty while six notes exist — the same disappearance this
  // lane exists to end, arrived at from the other side.
  const openOlder = fresh.length === 0;
  const count = fresh.length
    ? fresh.length + (fresh.length === 1 ? " new note" : " new notes")
    : "nothing new";
  el.innerHTML = '<div class="nhead"><span class="slabel">fleet notes</span>' +
    '<span class="ncount">' + count +
    (older.length ? " · " + older.length + " older" : "") +
    (d.cap ? " · " + notes.length + "/" + d.cap + " keys" : "") + '</span>' +
    '<span class="nhow"><code>helm note set &lt;key&gt; &lt;headline&gt; --detail … --goto …</code></span></div>' +
    '<div class="nrows">' + fresh.map(noteRowHTML).join("") + '</div>' +
    (older.length ? '<details class="nolder"' + (openOlder ? " open" : "") + '>' +
      '<summary>' + older.length + (older.length === 1 ? " older note" : " older notes") +
      ' · kept, not deleted</summary><div class="nrows">' +
      older.map(noteRowHTML).join("") + '</div></details>' : "");
  el.querySelectorAll("[data-note-tab]").forEach(a => a.onclick = ev => {
    ev.preventDefault();
    const dest = a.dataset.noteTab;
    // a note bound for "board" means the LAND board, the kanban on Work
    showView(dest === "board" ? "work" : canonView(dest));
    if (dest === "board") setTimeout(() => $("#tierpipeline").scrollIntoView({block: "start"}), 0);
  });
  el.classList.add("show");
}

/* ---------- store strip ---------- */
function storeStrip(s) {
  if (!s || s.unavailable || !s.counts) return;
  const c = (s.counts.by_type && typeof s.counts.by_type === "object") ? s.counts.by_type : s.counts;
  const types = Object.keys(c).filter(k => typeof c[k] === "number" && k !== "total");
  types.sort((a, b) => (STORE_ORDER.indexOf(a) + 99 || 999) - (STORE_ORDER.indexOf(b) + 99 || 999) || a.localeCompare(b));
  if (!types.length) return;
  const total = typeof c.total === "number" ? c.total :
    (typeof s.counts.total === "number" ? s.counts.total : types.reduce((n, k) => n + c[k], 0));
  $("#store").innerHTML = '<span class="slabel">store</span>' +
    types.map(k => '<span class="stype"><b>' + c[k] + "</b>" + esc(k) + "</span>").join("") +
    '<span class="stot">' + total + " entries</span>";
  $("#store").classList.add("show");
}

/* ---------- sessions strip ---------- */
function sessStrip(s) {
  if (!s || s.unavailable || !Array.isArray(s.sessions) || !s.sessions.length) return;
  const rows = s.sessions.slice(0, 12).map(r =>
    '<div class="srow" data-cmd="' + esc(r.cmd || "") + '" title="click to copy the resume command">' +
    '<span class="sage">' + esc(age(r.mt)) + '</span>' +
    '<span class="hchip h-' + esc(r.h) + '">' + esc(r.h) + '</span>' +
    '<span class="sproj">' + esc(r.project || "–") + '</span>' +
    '<span class="stitle">' + esc((r.t || "(untitled)").slice(0, 80)) + '</span></div>').join("");
  $("#sessions").innerHTML = '<span class="slabel">sessions</span><div class="srows">' + rows + "</div>";
  $("#sessions").classList.add("show");
  $("#sessions").querySelectorAll(".srow").forEach(el => el.addEventListener("click", async () => {
    const cmd = el.dataset.cmd;
    if (!cmd) return;
    try { await navigator.clipboard.writeText(cmd); } catch (e) {}
    el.classList.add("copied");
    setTimeout(() => el.classList.remove("copied"), 900);
  }));
}

/* ---------- skills strip ---------- */
async function post(url, body) {
  const go = () => fetch(url, {method: "POST", headers: {"Content-Type": "application/json", "Authorization": "Bearer " + TOKEN}, body: JSON.stringify(body)});
  let r = await go();
  if (r.status === 403) {
    // stale per-process bearer (the web unit recycled under this open tab):
    // re-read the live token from our own page and retry ONCE. A refresh that
    // yields the token we already held retries nothing, and a failed refresh
    // changes nothing — either way the 403 below still throws LOUDLY.
    const held = TOKEN;
    await refreshToken().catch(() => {});
    if (TOKEN !== held) r = await go();
  }
  const d = await r.json().catch(() => ({}));
  if (!r.ok) {
    /* BOTH TIERS, THE SAME WAY `j` DRAWS THEM. This read `d.error || url +
       " -> " + r.status`, and the OR is the defect: whenever the server
       answered with a sentence, the owner lost the path and the number.
       So the MUTATION door told him less than the READ door about the same
       failure — and the mutation door is the one he was standing at when
       task/2621 sent him here, pressing comment on a task row.

       task/2621 cured `j` to carry the status beside the reason and argued
       why in its own rationale: the status tier is a fact about the failure
       too. That argument was always about both helpers; only one of them
       got the change. This is the sibling, one function over. */
    const d2 = d && d.error ? ": " + d.error : "";
    const err = new Error(url + " -> " + r.status + d2);
    /* THE PARSED BODY RIDES THE ERROR. The message is a RENDERING — path,
       status, sentence — and a caller that needs the server's own fields
       (`code`, say) cannot get them back out of it. The accounts card branched
       on `r.code === "conflict"` and that branch was dead code in production
       for exactly this reason: post() threw, the catch saw only a string, and
       every refusal reached the owner as "/api/x -> 400: <sentence>" instead
       of the sentence. Additive on purpose — the message is unchanged, so
       every caller that renders e.message behaves exactly as before. */
    err.status = r.status;
    err.body = d && typeof d === "object" ? d : null;
    throw err;
  }
  return d;
}

let skillsOpen = false;

function skillFlags(s) {
  let out = "";
  if (s.disabled) out += '<span class="skflag off">disabled</span>';
  if (s.diverged) out += '<span class="skflag diverged" title="same name, different content across homes">diverged</span>';
  else if (s.shadowed) out += '<span class="skflag shadowed" title="same name in multiple homes">shadowed</span>';
  if (!s.has_manifest) out += '<span class="skflag off">no SKILL.md</span>';
  return out;
}

function skillsSec(d) {
  if (!d || d.unavailable || !Array.isArray(d.skills) || !d.skills.length) return;
  const el = $("#skillsec");
  const home = h => h.replace(/^\/home\/[^/]+|^\/Users\/[^/]+/, "~");
  const rows = d.skills.map(s =>
    '<div class="skrow' + (s.disabled ? " off" : "") + '">' +
    '<span class="skname" title="' + esc(s.real) + '">' + esc(s.name) + '</span>' +
    skillFlags(s) +
    '<span class="skhome">' + esc(home(s.home)) + '</span>' +
    '<button class="skbtn" data-act="toggle" data-path="' + esc(s.path) + '">' + (s.disabled ? "enable" : "disable") + '</button>' +
    '<button class="skbtn" data-act="delete" data-path="' + esc(s.path) + '" title="moved to ~/.cache/helm/skills-trash — nothing is destroyed">delete</button></div>').join("");
  const nbad = (d.bad || []).length;
  el.innerHTML = '<div class="shead"><span class="slabel">skills</span>' +
    '<span class="scount">' + d.skills.length + (nbad ? " · " + nbad + " hygiene flag" + (nbad === 1 ? "" : "s") : "") + '</span>' +
    '<span class="chev">▶</span></div><div class="skrows">' + rows + "</div>";
  el.classList.add("show");
  el.classList.toggle("open", skillsOpen);
  el.querySelector(".shead").addEventListener("click", () => {
    skillsOpen = !skillsOpen;
    el.classList.toggle("open", skillsOpen);
  });
  // two-click arm: first click arms ("sure?"), second executes; a pause disarms.
  el.querySelectorAll(".skbtn").forEach(b => b.addEventListener("click", async ev => {
    ev.stopPropagation();
    if (!b.classList.contains("armed")) {
      b.dataset.label = b.textContent;
      b.classList.add("armed");
      b.textContent = b.dataset.act === "delete" ? "sure? → trash" : "sure?";
      b._disarm = setTimeout(() => { b.classList.remove("armed"); b.textContent = b.dataset.label; }, 3500);
      return;
    }
    clearTimeout(b._disarm);
    try {
      await post("/api/skills/" + b.dataset.act, {path: b.dataset.path});
    } catch (e) {
      b.classList.remove("armed");
      b.classList.add("failed");
      b.textContent = "failed";
      setTimeout(() => { b.classList.remove("failed"); b.textContent = b.dataset.label; }, 2000);
      return;
    }
    j("/api/skills").then(skillsSec).catch(() => {});
  }));
}

/* ---------- the project light (drawn on each board row) ---------- */
/* THE FOUR THINGS ONLY A PERSON CAN SAY, in the words the row shows him. */
const LIGHTS = [["green", "open more lanes for work that is already built up; never speculative"],
                ["yellow", "normal work, no extra lanes"],
                ["orange", "work, constrained: critical path only, one delegate at a time"],
                ["red", "start nothing new here; finish or park what is running"]];

/* THE REGISTRY KEY, WRITTEN ONCE. It is what `light.key` carries, what the
   light-setter POSTs, and what the detail door is keyed by — three places that
   must never disagree, because a row that resolves the key differently on one
   of them opens one project's pane while writing another project's colour. */
function pkey(p) { return (p.light && p.light.key) || p.name; }

/* HOW MUCH LINEAGE, FROM WHICHEVER DOOR ANSWERED. A door that moved the pane
   off the list sends `edges_n` and no `edges`; one that still sends whole
   records has the array and no count. Absent-and-zero are the same answer for
   BOTH spellings — a project with no lineage carries neither key — and this
   asks only the question the row's lineage mark asks: is there any. */
function lineageN(p) {
  return typeof p.edges_n === "number" ? p.edges_n : (p.edges || []).length;
}

function lightset(p) {
  const lit = light(p), key = pkey(p);
  return "<div class='dsec lightset' data-key='" + esc(key) + "'><h4>light</h4>" +
    "<div class='dline'><b>" + esc(lit.colour) + "</b> · " + esc(lit.why) + "</div>" +
    "<div class='lightrow'>" + LIGHTS.map(c =>
      "<button type='button' class='setlight" + (lit.authored && lit.colour === c[0] ? " on" : "") +
      "' data-colour='" + c[0] + "' title='" + esc(c[1]) + "'><span class='dot " + c[0] + "'></span>" + c[0] + "</button>").join("") +
    (lit.authored ? "<button type='button' class='setlight' data-colour='clear' title='nobody decides; the dot shows what the scan saw'>hand back to the scan</button>" : "") +
    "</div>" +
    "<input class='lightwhy' id='lightwhy-" + esc(key) + "' type='text' autocomplete='off' placeholder='why, and what would change it back'>" +
    "<div class='dline lightmsg' role='status'></div></div>";
}

async function setLight(box, colour) {
  const msg = box.querySelector(".lightmsg"), key = box.dataset.key;
  const reason = box.querySelector(".lightwhy").value.trim();
  if (colour !== "clear" && !reason) {
    msg.textContent = "Say why first: what decided it, and what would change it back.";
    box.querySelector(".lightwhy").focus();
    return;
  }
  msg.textContent = "setting…";
  try {
    await post("/api/projects/state", {name: key, colour, reason});
    // BOTH READS, because the row draws the light off the registry and the
    // headline counts green off the board. The rows he had open stay open:
    // that is state the board keeps, not something a redraw can drop.
    await boardReload();
  } catch (e) {
    msg.textContent = (e.body && e.body.error) || e.message;
  }
}

/* ---------- what is on file, drawn in an OPEN board row ----------
   IT IS FETCHED, NOT SHIPPED. Before the split the project list shipped this
   pane for all 234 projects on every load of the home tab — ~18 KB of
   lineage, pointers, working dirs and notes for the 233 the owner did not
   open. The list now carries what a board ROW draws and `detail_route` names
   where a row's own weight lives; this is the same shape `/api/task/notes`
   set for task prose one surface over.

   `d` IS A SEPARATE OBJECT FROM `p` ON PURPOSE. `p` is the registry row and
   is always present; `d` is what the detail door answered and may not be. The
   two fields read off `p` here — `path` and `sessions` — are already on the
   row, so nothing is shipped twice to draw this.

   ONE FUNCTION, BOTH DOORS: a door that still sends whole records is drawn by
   passing the record as its own detail (`detailBody(p, p)`), so the old and new
   payloads go through the same renderer rather than two that can drift. */
function detailBody(p, d) {
  const secs = [];
  if ((d.edges || []).length)
    secs.push("<div class='dsec'><h4>lineage</h4>" + d.edges.map(e =>
      "<div class='dline edge'><span class='rel'>" + esc(e.rel || "?") + "</span> <b>" + esc(e.to || "?") + "</b>" +
      (e.note ? " <span class='enote'>— " + esc(e.note) + "</span>" : "") +
      (e.confirmed === false ? " <span class='unconf'>unconfirmed</span>" : "") + "</div>").join("") + "</div>");
  if (d.notes)
    secs.push("<div class='dsec'><h4>notes</h4><div class='dline'>" + esc(d.notes) + "</div></div>");
  const sess = p.sessions || {}, refs = d.harness_refs || {};
  const hlines = Object.keys(sess).map(h => {
    const r = refs[h] || [];
    const shown = r.slice(0, 3).map(esc).join(", ");
    return "<div class='dline'><b>" + esc(h) + "</b> · " + sess[h] + " session" + (sess[h] === 1 ? "" : "s") +
      (shown ? " <span class='mono'>" + shown + (r.length > 3 ? " +" + (r.length - 3) : "") + "</span>" : "") + "</div>";
  });
  if (hlines.length) secs.push("<div class='dsec'><h4>harnesses</h4>" + hlines.join("") + "</div>");
  const cwds = (d.cwds || []).filter(c => c !== p.path);
  if (cwds.length)
    secs.push("<div class='dsec'><h4>working dirs</h4>" + cwds.map(c =>
      "<div class='dline mono copy' data-copy='" + esc(c) + "'>" + esc(c) + "</div>").join("") + "</div>");
  const ptr = [["home", d.home], ["memory", d.memory_dir], ["cv scope", d.cv_scope && d.cv_scope.cwd_prefix]]
    .filter(x => x[1]).map(x =>
      "<div class='dline'><b>" + x[0] + "</b> <span class='mono copy' data-copy='" + esc(x[1]) + "'>" + esc(x[1]) + "</span></div>");
  if (ptr.length) secs.push("<div class='dsec'><h4>pointers</h4>" + ptr.join("") + "</div>");
  const days = d.active_days ? "<div class='dline'>" + d.active_days + " active day" + (d.active_days === 1 ? "" : "s") +
    (d.first_seen ? " · first seen " + age(d.first_seen) + " ago" : "") + "</div>" : "";
  if (days) secs.push("<div class='dsec'><h4>activity</h4>" + days + "</div>");
  return secs.join("");
}

/* WHAT THE DETAIL DOOR HAS ANSWERED, PER PROJECT. `renderBoard()` rebuilds
   every row on every keystroke in the filter box, so without this a fetched
   pane would be thrown away and re-fetched on each letter typed. Keyed by the
   registry key, and the three things it can hold are three DIFFERENT answers:
     · not in the map   — nobody has asked yet
     · an object        — read; `{}` means there is nothing else on file
     · false            — asked, and the door did not answer
   `{}` and `false` are the pair that must never draw the same thing, because
   "this project has nothing else" and "I could not find out" are not the same
   sentence, and only one of them is worth clicking again. */
const DETAIL_HAVE = new Map();

/* Set from `reg.detail_route` on every load — see `load()`. Null means the door
   sent whole records, and the pane is drawn straight from the row. */
let DETAIL_ROUTE = null;

/* A PANE THAT IS NOT THE PANE, saying which of the three it is — in the
   markup, not only in the words, so a test can read the state as directly as
   the owner reads the sentence. */
function dmsg(state, text) {
  return "<div class='dsec dmore' data-state='" + state + "'><div class='dline'>"
    + esc(text) + "</div></div>";
}

/* THE PANE, IN WHICHEVER OF THE FOUR STATES IT IS IN. It never returns an
   empty string for a project that has not been read: an empty pane under an
   open row reads as "there is nothing here", which is an answer, and it is
   not one this function is always entitled to give. */
function detailPane(p) {
  if (!DETAIL_ROUTE) return detailBody(p, p);   // whole-record door: draw it
  const key = pkey(p);
  if (!DETAIL_HAVE.has(key)) return dmsg("pending", "loading…");
  const d = DETAIL_HAVE.get(key);
  if (d === false)
    return dmsg("failed", "could not read this project's detail — click to retry");
  const body = detailBody(p, d);
  return body || dmsg("none", "nothing else on file for this project");
}

/* Fetch one row's pane and redraw just that row's wrapper. Never throws into
   the click handler: a failure is a STATE, recorded and drawn, not a console
   line the owner cannot see. */
async function loadDetail(c, p) {
  const key = pkey(p), wrap = c.querySelector(".dwrap");
  if (!DETAIL_ROUTE || !wrap) return;
  const have = DETAIL_HAVE.get(key);
  if (have && have !== false) return;           // read already; `{}` counts
  try {
    const r = await j(DETAIL_ROUTE + "?name=" + encodeURIComponent(key), 8000);
    /* A DOOR THAT CANNOT SEE THE REGISTRY SAID SO, and that is not an empty
       project. `unavailable` is the store's word and the pane must not
       launder it into "nothing on file". */
    DETAIL_HAVE.set(key, (r && r.unavailable) || !r || typeof r.detail !== "object"
      ? false : r.detail);
  } catch (e) {
    DETAIL_HAVE.set(key, false);
  }
  wrap.innerHTML = detailPane(p);
}

/* THE LIGHT: an authored colour, else what the scan saw.
   One dot, one meaning — "what is this project's state right now" — because
   the derived words were never a different axis from the stoplight, only an
   incomplete one: `active` already meant green and `dormant` already meant
   nothing-happening. What a scan can never say is anything DECIDED (frozen,
   constrained, maintenance-only), so an authored colour supersedes it here
   exactly as it supersedes a credential flag in routing.
   The tooltip carries the provenance because the colour alone cannot: green
   the owner declared is a standing permission, green a scan inferred is an
   observation that may already be stale. */
/* `age` is day-granular and answers "0d" for anything under a day, which reads
   as a number where a person wants a word. */
function ago(epoch) { const a = age(epoch); return a === "0d" ? "today" : a + " ago"; }

function light(p) {
  // DRAWN HERE, DECIDED ON THE SERVER: `p.light` is registry.light's answer.
  // Reading `p.state` off the merged record would let a projection byte pass
  // for the owner's word, which is the one thing this mark exists to prevent.
  const lit = p.light || {colour: p.status || "dormant", authored: false};
  return {colour: lit.colour, authored: !!lit.authored,
          why: lit.authored
            ? "set" + (lit.by ? " by " + lit.by : "") + (lit.ts ? " " + ago(lit.ts) : "")
              + (lit.reason ? " — " + lit.reason : "")
            : "what the scan saw — nobody has set this project's light"};
}

/* ---------- wiring ---------- */
document.addEventListener("click", ev => {
  const cp = ev.target.closest(".copy");
  if (cp) {
    ev.stopPropagation();
    navigator.clipboard && navigator.clipboard.writeText(cp.dataset.copy || cp.textContent);
    cp.classList.add("did");
    setTimeout(() => cp.classList.remove("did"), 600);
    return;
  }
  const box = ev.target.closest(".lightset");
  if (box) {                       // a control inside the row, not the row
    const b = ev.target.closest(".setlight");
    if (b) setLight(box, b.dataset.colour);
    return;
  }
  /* A BOARD ROW OPENS FROM ITS SUMMARY LINE and never from inside its own
     detail: a tap on a task title or a seat name is reading, not closing. The
     light itself is part of that line, and a tap on it opens the row at its
     setter. */
  const line = ev.target.closest(".bline");
  // a link inside the row (a repository badge) goes where it points
  if (line && !ev.target.closest("a")) boardToggle(line.closest(".brow"), !!ev.target.closest(".blight"));
});
document.addEventListener("keydown", ev => {
  if (ev.key === "/" && document.activeElement !== $("#q") && $("#view-work").classList.contains("on")) {
    ev.preventDefault();
    $("#q").focus();
  }
  if (ev.key === "Escape" && BOARD_OPEN.size) {
    BOARD_OPEN.clear();
    renderBoard();
  }
});
$("#q").addEventListener("input", renderBoard);
$("#togRetired").addEventListener("click", () => {
  showRetired = !showRetired;
  $("#togRetired").classList.toggle("on", showRetired);
  renderBoard();
});

function foot(reg) {
  const ts = reg.generated_ts ? new Date(reg.generated_ts) : null;
  const when = ts && !isNaN(ts) ? age(ts.getTime() / 1000) : null;
  $("#foot").innerHTML = '<span class="fmark">⎈</span> ~/.helm' +
    (when ? " · synced " + (when === "0d" ? "today" : when + " ago") : " · never synced — run <code>helm sync</code>") +
    " · localhost surface — the CLI is the helm";
}

function homeStats() {
  const sess = projects.reduce((n, p) => n + Object.values(p.sessions || {}).reduce((a, b) => a + b, 0), 0);
  $("#stats").innerHTML = statCell(projects.length, "projects") + statCell(sess, "sessions");
}

/* THE REGISTRY: the rows the board draws, the footer, and where a row's pane
   lives. Read at boot, after every light he sets, and on the board's own poll,
   so a light somebody else set reaches his screen without a reload. Throws on
   a failed read: the boot path turns that into the banner, the poll into
   nothing, because a board that could not re-read keeps the rows it has and
   its sections say how old they are. */
async function loadRegistry() {
  const reg = await j("/api/registry");
  $("#banner").classList.remove("show");
  /* WHERE A ROW'S PANE LIVES, IF IT IS NOT ON THE ROW. A door that still
     sends whole records sends no `detail_route`, and the pane is drawn from
     the row exactly as it always was — so the page is never guessing that
     something was withheld, it is told, and an old server cannot turn a
     full record into a blank pane. */
  DETAIL_ROUTE = typeof reg.detail_route === "string" ? reg.detail_route : null;
  projects = Object.values(reg.projects || {});
  projects.sort((a, b) => (b.last_seen || 0) - (a.last_seen || 0));
  homeStats();
  renderBoard();
  foot(reg);
}

async function load() {
  try {
    await loadRegistry();
  } catch (e) {
    $("#banner").classList.add("show");
    setTimeout(load, 8000);
    return;
  }
  j("/api/whoami").then(greet).catch(() => {});
  j("/api/notes").then(notesSec).catch(() => {});
  j("/api/store").then(storeStrip).catch(() => {});
  j("/api/sessions").then(sessStrip).catch(() => {});
  j("/api/skills").then(skillsSec).catch(() => {});
}
load();
// fleet notes are the one home-tab strip agents write WHILE you are looking at
// it, so it refreshes on its own timer (cheap read, board tab only, only when
// the page is visible). The other strips are boot-time state.
setInterval(() => {
  if ($("#view-work").classList.contains("on") && !document.hidden)
    j("/api/notes").then(notesSec).catch(() => {});
}, 60000);

/* ================= READINESS card (GET /api/ready) =================
   `helm ready`'s five signals — may forward work resume after a crash or
   reboot? ADVISORY by ratification (#163): the card renders, it never gates.
   COLOUR IS A CLASS: green is spent only on a signal MEASURED green; UNKNOWN
   is loud warn, because a gauge that could not measure must never look like
   one that measured healthy. The server caches the gauge behind a 30s
   single-flight, so this poll can stay dumb. */
const READY_POLL_MS = 60000;
const READY_FETCH_MS = 15000;
function readyCardHTML(d) {
  const head = h => '<div class="rhead"><span class="slabel">ready</span>' + h +
    '<span class="rhow"><code>helm ready</code> — advisory: renders, never gates</span></div>';
  if (!d || d.pending) return head('<span class="rverdict rmut">not read yet</span>');
  if (d.unavailable) return head('<span class="rverdict runk">UNKNOWN</span>') +
    '<div class="rrows"><div class="rrow rsunk"><span class="rev">' + esc(d.unavailable) + '</span></div></div>';
  const vk = d.ready === "READY" ? "ok" : d.ready === "NOT READY" ? "bad" : "unk";
  const rows = (d.signals || []).map(s => {
    const k = s.state === "GREEN" ? "ok" : s.state === "RED" ? "bad" : "unk";
    return '<div class="rrow rs' + k + '">' +
      '<span class="rstate r' + k + '">' + esc(s.state) + '</span>' +
      '<span class="rsig">' + esc(s.signal) + '</span>' +
      '<span class="rev">' + esc(s.evidence) + '</span>' +
      (s.note ? '<div class="rnote">' + esc(s.note) + '</div>' : "") +
      (s.repair && s.state !== "GREEN" ? '<div class="rfix">→ ' + esc(s.repair) + '</div>' : "") +
      '</div>';
  }).join("");
  return head('<span class="rverdict r' + vk + '">' + esc(d.ready) + '</span>') +
    '<div class="rrows">' + rows + '</div>';
}
function readyShow(d) { $("#readysec").innerHTML = readyCardHTML(d); }

/* ================= GUARD REFUSALS card (GET /api/friction) =================
   How often a guard stopped an agent this week, and THE OWNER'S DIAL: the one
   number that decides when an agent is told it may stop and repair a guard.
   He turns it here because he does not type verbs; `helm friction dial` is the
   same read and the same write.

   THE CARD COUNTS NOTHING. Every number is `helm friction`'s own, handed over
   by the server; this file only chooses the words. The words are plain,
   complete sentences on purpose: he reads this card, he does not decode it.

   AN UNREADABLE RECORD IS NEVER DRAWN AS ZERO, and a failed or stale press is
   never drawn as saved: the status line carries the server's own sentence, and
   the number on the card is whatever the server last said is in force.

   NOTHING MOVES WHEN HE PRESSES. The status line keeps its height when empty
   and the value keeps its width, so the button stays under his finger; and a
   redraw hands keyboard focus back to the button he was on, because replacing
   the markup would otherwise drop it after every press.

   frictionTimes/frictionWhen/frictionCardHTML are PURE (data in, string out)
   so tests/test_friction.py runs this exact source under node. */
const FRICTION_POLL_MS = 60000;
const FRICTION_FETCH_MS = 15000;
let FRICTION = {pending: true};
let FRICTION_MSG = null;          // {text, kind, at}: the last thing a press said
const FRICTION_MSG_MS = 20000;    // how long a press's answer outlives the press
let FRICTION_BUSY = false;
function frictionTimes(n) { return n + (n === 1 ? " time" : " times"); }
function frictionWhen(ts, now) {
  const days = Math.max(0, Math.floor((now - ts) / 86400));
  return days === 0 ? "today" : days === 1 ? "yesterday" : days + " days ago";
}
function frictionCardHTML(d, msg, now) {
  const TOP = 6;
  const head = '<div class="fhead"><span class="slabel">guard refusals</span>' +
    '<span class="fhow">A guard is a safety check that stops an agent before it does something risky.</span></div>';
  if (!d || d.pending) return head + '<p class="fline fmut">Not read yet.</p>';
  if (d.unavailable || !d.dial) return head +
    '<p class="fline fwarn">The console could not read this card just now. It tries again every minute.</p>';
  const rep = d.report || {}, dial = d.dial;
  let census;
  if (rep.unreadable || typeof rep.total !== "number") {
    census = '<p class="fline fwarn">The record of refusals could not be read, so this card cannot say how many there were. This is not the same as zero.</p>';
  } else if (!rep.total) {
    census = '<p class="fline">Guards did not refuse any agent this week.</p>';
  } else {
    const guards = rep.guards || [], rest = guards.slice(TOP);
    const restN = rest.reduce((n, g) => n + g.refusals, 0);
    census = '<p class="fline">Guards refused agents ' + frictionTimes(rep.total) + ' this week.</p>' +
      '<ul class="fguards">' + guards.slice(0, TOP).map(g =>
        '<li><span class="fguard">' + esc(g.guard) + '</span>: ' + g.refusals + '.</li>').join("") +
      (rest.length ? '<li>' + (rest.length === 1 ? "One other guard" : "The other " + rest.length + " guards") +
        ' refused agents ' + frictionTimes(restN) + (rest.length === 1 ? "." : " in total.") + '</li>' : "") +
      '</ul>';
    if (rep.invalid) census += '<p class="fline fmut">' + (rep.invalid === 1 ? "1 entry" : rep.invalid + " entries") +
      ' in the record could not be counted.</p>';
  }
  const who = dial.problem ? esc(dial.problem)
    : !dial.authored ? "Nobody has changed this number yet."
    : (dial.by === "owner" ? "You" : esc(dial.by || "Someone")) + " set this number" +
      (typeof dial.ts === "number" ? " " + frictionWhen(dial.ts, now) : "") + ".";
  const step = (by, glyph, label, stop) => {
    const off = by < 0 ? dial.value <= dial.min : dial.value >= dial.max;
    return '<button type="button" class="fstep" data-step="' + by + '"' + (off ? " disabled" : "") +
      ' aria-label="' + esc(off ? stop : label + " " + (dial.value + by) + ".") + '" title="' +
      esc(off ? stop : label + " " + (dial.value + by) + ".") + '">' + glyph + '</button>';
  };
  return head + census +
    '<p class="fline">An agent is told to consider fixing a guard after <b>' + dial.value +
    '</b> refusals by the same guard in one day.</p>' +
    '<div class="fdial" role="group" aria-label="Change how many refusals it takes">' +
    step(-1, "−", "Tell agents sooner. Lower the number to", dial.min + " is the lowest setting.") +
    '<output class="fval">' + dial.value + '</output>' +
    step(1, "+", "Tell agents later. Raise the number to", dial.max + " is the highest setting.") +
    '<span class="fwho' + (dial.problem ? " fwarn" : "") + '">' + who + '</span></div>' +
    '<p class="fline fmut">A lower number means agents stop to fix a guard sooner and are interrupted more often. ' +
    'A higher number means a mistaken guard is put up with for longer.</p>' +
    '<p class="fmsg' + (msg && msg.kind ? " f" + esc(msg.kind) : "") + '" role="status">' +
    (msg && msg.text ? esc(msg.text) : "") + '</p>';
}
function frictionShow(d) {
  if (d) FRICTION = d;
  const sec = $("#frictionsec");
  if (!sec) return;
  const held = sec.contains(document.activeElement) ? document.activeElement.dataset.step : null;
  sec.innerHTML = frictionCardHTML(FRICTION, FRICTION_MSG, Date.now() / 1000);
  if (held) {
    const again = sec.querySelector('.fstep[data-step="' + held + '"]:not([disabled])') ||
      sec.querySelector(".fstep:not([disabled])");
    if (again) again.focus();
  }
}
async function frictionStep(by) {
  const dial = FRICTION && FRICTION.dial;
  if (!dial || FRICTION_BUSY) return;
  const want = dial.value + by;
  if (want < dial.min || want > dial.max) return;
  FRICTION_BUSY = true;
  FRICTION_MSG = {text: "Saving…", kind: "mut", at: Date.now()};
  frictionShow();
  try {
    const r = await post("/api/friction/dial", {value: want, expected: dial.value});
    FRICTION = Object.assign({}, FRICTION, {dial: r.dial});
    FRICTION_MSG = {text: "Saved.", kind: "ok", at: Date.now()};
  } catch (e) {
    /* THE SERVER'S OWN SENTENCE, and the dial it says is in force. A `stale`
       or `failed` answer already says what happened to the press; every other
       failure is told "Not saved" here, because silence after a press reads
       as success. */
    const b = e.body || {};
    if (b.dial) FRICTION = Object.assign({}, FRICTION, {dial: b.dial});
    const told = (b.code === "stale" || b.code === "failed") && b.error;
    FRICTION_MSG = {kind: "bad", at: Date.now(), text: told ? b.error
      : "Not saved. " + (b.error || "The console could not reach helm. Try again in a moment.")};
  } finally {
    FRICTION_BUSY = false;
  }
  frictionShow();
}
async function pollFriction() {
  if (FRICTION_BUSY) return;
  /* A PRESS'S ANSWER IS ABOUT THAT PRESS. Left standing under later reads it
     would describe a dial that has since moved again; the space it held stays
     reserved, so clearing it moves nothing. */
  if (FRICTION_MSG && Date.now() - FRICTION_MSG.at > FRICTION_MSG_MS) FRICTION_MSG = null;
  try {
    const d = await j("/api/friction", FRICTION_FETCH_MS);
    if (!FRICTION_BUSY) frictionShow(d);
  } catch (e) {
    if (!FRICTION_BUSY) frictionShow({unavailable: true});
  }
}

/* ================= AWAY MODE card (GET/POST /api/owner/posture) ============
   task/3018: the owner sets away mode and a notice to every agent from here,
   because he does not type verbs. `helm away` / `helm back` write the same
   flag and `helm away status` reads the same card.

   NOBODY IS WOKEN, AND THE CARD SAYS SO. The server writes two files; no chat
   row, no mention. Each agent is shown the change once, at the next turn it
   was already going to take (the per-turn inject), so a press here never
   pages an idle seat.

   AN UNREADABLE FLAG IS NEVER DRAWN AS "HERE", and an unreadable notice is
   never drawn as "no notice": both say they could not be read. A press is
   never drawn as saved unless the server's answer carries the card showing
   it.

   THE DRAFT SURVIVES THE POLL. The text box is redrawn with the card, so what
   he has typed lives in POSTURE_DRAFT and is written back on every redraw,
   and a poll that lands while he is typing is held until he leaves the box.

   postureAgo/postureCardHTML are PURE (data in, string out), so
   tests/test_ownernotice.py runs this exact source under node. */
const POSTURE_POLL_MS = 30000;
const POSTURE_FETCH_MS = 15000;
const POSTURE_MSG_MS = 20000;
let POSTURE = {pending: true};
let POSTURE_MSG = null;          // {text, kind, at}: the last thing a press said
let POSTURE_DRAFT = "";
let POSTURE_BUSY = false;
function postureAgo(t, now) {
  if (typeof t !== "number") return "at a time the record does not say";
  const m = Math.max(0, Math.floor((now - t) / 60));
  if (m < 1) return "just now";
  if (m < 60) return m + (m === 1 ? " minute ago" : " minutes ago");
  const h = Math.floor(m / 60);
  if (h < 36) return h + (h === 1 ? " hour ago" : " hours ago");
  const days = Math.floor(h / 24);
  return days + (days === 1 ? " day ago" : " days ago");
}
function postureCardHTML(d, msg, now, draft) {
  const head = '<div class="phead"><span class="slabel">away mode</span>' +
    '<span class="phow">Agents learn what you set here at their next turn. Nobody is woken.</span></div>';
  if (!d || d.pending) return head + '<p class="pline pmut">Not read yet.</p>';
  if (d.unavailable) return head +
    '<p class="pline pwarn">The console could not read this card just now. It tries again shortly.</p>';
  const a = d.away || {}, n = d.notice || {};
  const btn = (act, label, cls) => '<button type="button" class="pbtn' + (cls ? " " + cls : "") +
    '" data-act="' + act + '">' + label + '</button>';
  let away, buttons;
  if (a.state === "away") {
    const who = a.owner_door ? "You set this here."
      : "This was not set from your console: " + esc(a.by || "an unnamed process") +
        " set it (" + esc(a.via || "no provenance") + ").";
    away = '<p class="pline"><b>You are marked away</b>, since ' + esc(postureAgo(a.t, now)) +
      '. ' + who + ' Agents are asked to coordinate through helm chat and dispatch and to keep local chat short.</p>';
    buttons = btn("back", "I’m back");
  } else if (a.state === "present") {
    away = '<p class="pline">You are not marked away.</p>';
    buttons = btn("away", "I’m away");
  } else {
    away = '<p class="pline pwarn">Whether you are marked away could not be read: ' +
      esc(a.why || "no reason was given") + '. This is not the same as being here.</p>';
    buttons = btn("away", "I’m away") + btn("back", "I’m back", "psec");
  }
  let notice;
  if (n.state === "set") {
    notice = '<p class="pline">Every agent is shown your notice: <q class="ptext">' + esc(n.text) +
      '</q> <span class="pmut">Set ' + esc(postureAgo(n.t, now)) + '.</span></p>';
  } else if (n.state === "none") {
    notice = '<p class="pline pmut">No notice is set.</p>';
  } else if (n.state === "ignored") {
    notice = '<p class="pline pwarn">A notice you did not write is on disk, and agents are not shown it' +
      (n.why ? ": " + esc(n.why) : "") + '. Clear notice removes it.</p>';
  } else {
    notice = '<p class="pline pwarn">Your notice could not be read: ' + esc(n.why || "no reason was given") +
      '. This is not the same as no notice.</p>';
  }
  const max = typeof d.notice_max === "number" ? d.notice_max : 240;
  const presets = (Array.isArray(d.presets) ? d.presets : []).map(p =>
    '<button type="button" class="ppre" data-preset="' + esc(p.id) + '" title="' + esc(p.text) + '">' +
    esc(p.label) + '</button>').join("");
  const clear = n.state === "set" || n.state === "ignored" ? btn("clear", "Clear notice", "psec") : "";
  return head + away + '<div class="prow">' + buttons + '</div>' +
    '<div class="psub"><span class="slabel">notice to every agent</span></div>' + notice +
    '<textarea class="pnote" maxlength="' + max + '" rows="2" aria-label="Notice to every agent"' +
    ' placeholder="A short notice. Every agent is shown it once, at its next turn.">' + esc(draft || "") +
    '</textarea><div class="prow">' + btn("notice", "Show this notice") + clear +
    (presets ? '<span class="ppres"><span class="pmut">Fill in:</span> ' + presets + '</span>' : "") + '</div>' +
    '<p class="pmsg' + (msg && msg.kind ? " p" + esc(msg.kind) : "") + '" role="status">' +
    (msg && msg.text ? esc(msg.text) : "") + '</p>';
}
function postureShow(d) {
  if (d) POSTURE = d;
  const sec = $("#posturesec");
  if (!sec) return;
  const act = sec.contains(document.activeElement) && document.activeElement.dataset
    ? document.activeElement.dataset.act : null;
  sec.innerHTML = postureCardHTML(POSTURE, POSTURE_MSG, Date.now() / 1000, POSTURE_DRAFT);
  if (act) {
    const again = sec.querySelector('.pbtn[data-act="' + act + '"]');
    if (again) again.focus();
  }
}
async function posturePress(act) {
  if (POSTURE_BUSY) return;
  const body = {action: act};
  if (act === "notice") {
    const text = POSTURE_DRAFT.trim();
    if (!text) {
      POSTURE_MSG = {text: "Type a notice first, or tap a Fill in button.", kind: "bad", at: Date.now()};
      postureShow();
      return;
    }
    body.text = text;
  }
  POSTURE_BUSY = true;
  POSTURE_MSG = {text: "Saving…", kind: "mut", at: Date.now()};
  postureShow();
  try {
    const r = await post("/api/owner/posture", body);
    if (r.posture) POSTURE = r.posture;
    let said = r.said || "Saved.";
    if (act === "back" && POSTURE.notice && POSTURE.notice.state === "set")
      said += " Your notice is still shown to agents; clear it below if it no longer applies.";
    if (act === "notice") POSTURE_DRAFT = "";
    POSTURE_MSG = {text: said, kind: "ok", at: Date.now()};
  } catch (e) {
    /* THE SERVER'S OWN SENTENCE, and the card as it now reads. Silence after
       a press reads as success, so every failure says "Not saved". */
    const b = e.body || {};
    if (b.posture) POSTURE = b.posture;
    POSTURE_MSG = {kind: "bad", at: Date.now(),
      text: b.error || "Not saved. The console could not reach helm. Try again in a moment."};
  } finally {
    POSTURE_BUSY = false;
  }
  postureShow();
}
async function pollPosture() {
  if (POSTURE_BUSY) return;
  if (POSTURE_MSG && Date.now() - POSTURE_MSG.at > POSTURE_MSG_MS) POSTURE_MSG = null;
  let d;
  try {
    d = await j("/api/owner/posture", POSTURE_FETCH_MS);
  } catch (e) {
    d = {unavailable: true};
  }
  if (POSTURE_BUSY) return;
  const sec = $("#posturesec");
  /* HE IS TYPING: keep the read, draw it when he leaves the box. */
  if (sec && sec.contains(document.activeElement) && document.activeElement.tagName === "TEXTAREA") {
    POSTURE = d;
    return;
  }
  postureShow(d);
}

/* ── THE STALE-PAGE TELL ──────────────────────────────────────────────────
   THE BUILD THIS PAGE IS. Templated in by the server from the bytes it
   assembled; the marker literal is split on the comparison below so serve-time
   substitution cannot rewrite the guard into comparing against itself, which is
   `refreshToken`'s law one line up for the same reason.

   WHY THIS EXISTS. The console is assembled fresh per request and sent
   no-store, so the SERVER is always current and this tab is whatever was
   assembled the moment it was opened. The owner keeps it open for hours while
   the tree under it lands change after change — he read a card for hours that a
   newer build had already moved, and told us what the old page showed. Every
   part of that was reasonable and nothing on the console could correct it.

   IT OFFERS AND IT NEVER ACTS. A page that reloaded itself would throw away a
   half-typed account row, or the box he was tabbed into; and "not now" has to
   keep working for the rest of that build, or the offer becomes the nag that
   trains him to ignore the one that matters. */
let BUILD = "__HELM_BUILD__";
let BUILD_SEEN = "";          // the build the SERVER last reported
let BUILD_DISMISSED = "";     // the build he said "not now" to
function buildIsUnstamped(id) { return !id || id === "__HELM" + "_BUILD__"; }
function staleBuildShow(server) {
  const bar = $("#stalebuild");
  if (!bar) return;
  /* AN UNSTAMPED PAGE NEVER ACCUSES. The tests lift this page as source and
     the template is only applied at serve time, so an unsubstituted marker
     means "nobody stamped this", which is not news about the server. Adopting
     the first id we are told keeps it quiet from then on. */
  if (buildIsUnstamped(BUILD)) { BUILD = server || BUILD; return; }
  const stale = !buildIsUnstamped(server) && server !== BUILD
    && server !== BUILD_DISMISSED;
  bar.hidden = !stale;
}
if ($("#stalereload")) $("#stalereload").onclick = () => location.reload();
if ($("#stalehide")) $("#stalehide").onclick = () => {
  /* dismissing is about THIS build, not about the tell: the next one after it
     asks again, because that is a different page he has not seen. */
  const bar = $("#stalebuild");
  BUILD_DISMISSED = BUILD_SEEN;
  if (bar) bar.hidden = true;
};
async function pollReady() {
  try {
    const d = await j("/api/ready", READY_FETCH_MS);
    readyShow(d);
    BUILD_SEEN = (d && d.build) || "";
    staleBuildShow(BUILD_SEEN);
  }
  catch (e) { readyShow({unavailable: "/api/ready did not answer — the console cannot see the gauge"}); }
}

/* ================= LAND PIPELINE card (GET /api/lr) =================
   The owner is GUI-first and reads on a phone. roster answers "who", the
   ledger answers "what turns", chat answers "what am I being told" — and until
   this card NOTHING answered "what does the record say about the lanes". So
   every claim about a land loop reached him as an agent's prose that nothing
   on screen could contradict.

   THREE RULES, and they are the whole design:

   1. AN UNREADABLE LEDGER RENDERS LOUDLY. `unavailable` replaces the entire
      body with a strip that names the reason. There is no path from a failed
      read to a rendered row, and the honest-empty state ("no land loops in
      flight") says in words that the read SUCCEEDED, so the two can never be
      confused for one another.
   2. AN ABSENT FIELD SAYS SO. `gate`/`ungated` do not exist until the gate
      lane lands, so today every row's verification chip reads UNVERIFIED —
      literally true, and it upgrades itself the day receipts start minting.
      No field here has a fallback that flatters the row.
   3. COLOUR IS A CLASS. Green is spent only on a landing GIT observed;
      everything unproven is neutral. Only CONTRARY and STALLED alarm, and
      only they reach the nav badge.

   lrCardHTML/lrRowHTML/lrNav are PURE (data in, string/object out) so
   tests/test_web_lr.py (CardRuntimeBase and its subclasses) runs this exact
   source under node. */
const LR_POLL_MS = 45000;
// The read's DEADLINE. A poll with no deadline cannot report "no answer": the
// promise stays pending, the UNKNOWN branch never runs, and the card holds
// whatever it drew last. 12s is well inside the 45s poll, so a slow read is
// reported as unread rather than queued behind itself.
const LR_FETCH_MS = 30000;
// "?" until the FIRST read completes — never 0, which is a count.
let NAV_LR = "?", NAV_LR_TITLE = "";
// The last answer lrShow drew, whatever it was — board, UNKNOWN, pending. The
// view toggle re-renders from it instantly instead of waiting out the 45s
// poll, and re-rendering the LAST ANSWER (not the last BOARD) means a toggle
// during an outage keeps the honest UNKNOWN strip on screen.
let LR_LAST = null;

/* The owner's stored view choice for the pipeline wall. KANBAN IS THE DEFAULT
   (owner 2026-08-03): only the stored word "list" picks the list, so an
   absent, ancient or mangled value can never flip the wall silently. */
function lrViewPref() {
  return localStorage.getItem("helm.lrview") === "list" ? "list" : "kanban";
}

/* mirrors landreq._fmt_dwell — one unit per magnitude, tabular */
function lrDwell(s) {
  s = Math.max(0, Math.round(Number(s) || 0));
  if (s < 3600) return Math.floor(s / 60) + "m";
  const p = n => String(n).padStart(2, "0");
  if (s < 86400) return Math.floor(s / 3600) + "h" + p(Math.floor((s % 3600) / 60)) + "m";
  return Math.floor(s / 86400) + "d" + p(Math.floor((s % 86400) / 3600)) + "h";
}
/* ONE owner for the magnitude, two callers for the direction. `lrAgo` says how
   long AGO; the building band says how much lease is LEFT, and this card's own
   history is what makes that split worth writing down: `helm work list` printed
   a bare "<seat> 13378s" that reads equally well as "held for" and as "left",
   and two seats misread it in the same hour. The number is formatted once here
   so the two directions cannot drift apart in their rounding; the WORD that
   says which direction it runs is the caller's. Null is not a duration —
   callers choose their own word for an absent reading. */
function lrDur(s) {
  if (s === null || s === undefined || s === "" || isNaN(Number(s))) return null;
  const n = Math.max(0, Math.round(Number(s)));
  return n < 60 ? n + "s" : n < 3600 ? Math.round(n / 60) + "m"
    : n < 86400 ? Math.round(n / 3600) + "h" : Math.round(n / 86400) + "d";
}

/* a SERVER-sent age in seconds. null/NaN is "unknown", never "0s" — the
   freshness line is the one place a fabricated zero would be worst. */
function lrAgo(s) {
  const d = lrDur(s);
  return d === null ? "unknown" : d + " ago";
}

/* THE one display predicate for a contrary whose verdict was HONORED through
   succession (contrary_discharge "a"/"b") or which IS the succession
   instrument itself ("c" — the resolved door's confirmation round, rendered
   as a quiet "confirmation") — the JS twin of landreq.honored_display, and
   the ONLY place this page answers the question (marks, header counts, nav
   badge and the home band all ask it). It exists because the first cut
   answered inline per surface and the surfaces disagreed at once
   (dispatch 97d8899a): an honored row with `stalled` true was quiet on the
   home band and STALLED-loud everywhere else. Honored wins over the stalled
   ALARM: the successor already landed, so a "stall" nobody can unstall is
   noise — and a confirmation round's landed tip is its healthy shape by
   design, so nothing is unstallable there either. Display only — `stalled`,
   `owed_by` and every server field are untouched; "unverified" and an
   absent stamp (old server) both answer false, fail-closed. */
function lrHonored(c) {
  /* A PURE READER. This used to re-derive the classification from `contrary`
     and `contrary_discharge` — a second implementation of honored_display,
     kept equal by parity tests. The server ships the answer now, so there is
     one implementation and the browser renders it. An old server without the
     field answers undefined, which is falsy, so the fail-closed reading that
     the derivation guaranteed is preserved. */
  return !!(c && c.honored);
}

/* The alarm classes + every honest annotation for one row. Mirrors the marks
   landreq._line prints in the terminal, so the card and `helm lr list` cannot
   describe the same row differently. */
/* WHY A ROW IS NOT OBSERVABLE, in the same words the terminal uses. This
   surface printed "git could not be read for this repo" for every
   non-observable READY row, which is TRUE of exactly one of the four causes
   `landreq` distinguishes and is a false accusation against the repository
   for the other three. UNDERIVED is the one the owner kept hitting and the
   one the old sentence libelled hardest: git was never asked, because the
   reader ran out of the budget it declared, so the row is undetermined and
   nothing was found wrong with it.

   THESE STRINGS ARE PINNED TO `landreq.OBSERVE_REASON` BY A TEST, not by
   anyone remembering. Two renderers of one datum is exactly how a board and a
   terminal come to describe one row differently, and this file is not
   imported by the Python that owns the vocabulary. */
const LR_OBSERVE_REASON = {
  "underived": "BUDGET EXPIRED — the reader ran out of its derive budget before this row; git was not asked and this is not a claim about the work",
  "no-repo-or-tip": "git could not be read for this repo",
  "no-trunk-or-tip": "no trunk or tip to compare against",
  "not-asked": "not asked — no verdict yet, so nothing could have landed",
};

function lrObserveReason(why) {
  /* An UNRECOGNISED value renders as unrecorded rather than as any of the
     four: a word this build does not know is exactly the case where naming a
     cause would be inventing one. */
  return LR_OBSERVE_REASON[String(why)] || "reason unrecorded";
}

function lrMarks(c, reason) {
  const marks = [];
  const standing = c.owed_seat_standing;
  if (standing && standing.state === "ORPHANED")
    marks.push({k: "warn", t: "ORPHANED — "
      + String(standing.why || "no roster row answers to its holder")
      + ". The work is NOT reassigned and this row is NOT expired; "
      + "helm seat reassign moves it."});
  else if (standing && standing.state === "RENAMED")
    marks.push({k: "mut", t: "RENAMED — "
      + String(standing.why || "its lineage names a successor")});
  const delivered = c.close_reason === "delivered-report";
  if (c.abandoned)
    marks.push({k: "mut", t: "ABANDONED — LAND STATE UNKNOWN; reviewed work written off: "
      + String(c.abandon_reason || "reason unavailable")});
  if (c.contrary) {
    // WHICH physical fact contradicts the verdict. An unread contrary_state
    // says so rather than guessing the friendlier of the two.
    // MIRRORS landreq.contrary_fact EXACTLY — same three states, same
    // provenance words, same "(...)" shape. The python side is the one door
    // its two terminal renderers share; this is the third renderer and it
    // cannot import that door, so the words are duplicated here deliberately
    // and a seam arm asserts the two agree rather than trusting this comment.
    // TWO VALUES ONLY, matching landreq._CONTRARY_PROVENANCE_WORDS — a seat arm
    // reads both tables and fails if they drift. `discharged` was dropped as a
    // lifecycle label in an evidence field; the `discharged` row field names it.
    const PROV = {observed: "observed on trunk",
                  recorded: "recorded when closed"};
    const base = c.contrary_state === "landed" ? "LANDED"
      : c.contrary_state === "merged-local" ? "MERGED_LOCAL" : "STATE UNREAD";
    // Provenance renders ONLY inside this `if (c.contrary)` gate: contrary_state
    // is populated on rows whose contrary is FALSE (a routine approve-then-land
    // reads contrary=false, contrary_state="landed"), so the state and its
    // provenance are meaningful only where the alarm is.
    // A TRAILING CLAUSE, NEVER SPLICED INTO THE FACT. Mirrors
    // landreq.contrary_provenance_clause. The first version put it inside the
    // fact and turned "MERGED_LOCAL on local trunk" into "MERGED_LOCAL
    // (observed on trunk) on local trunk", reddening ten arms that assert a
    // contiguous phrase. The fact is the fact; provenance annotates the claim.
    const prov = PROV[c.contrary_provenance];
    const provClause = prov ? " [" + prov + "]" : "";
    const fact = base;
    const pol = String(c.polarity || "unknown").toUpperCase();
    // `contrary_discharge` is the server's DISPLAY-TRUTH stamp: "a"/"b" mean
    // an on-trunk APPROVE in this row's chain HONORED the verdict through
    // succession, and "c" means this row IS the resolved door's confirmation
    // round — the discharge instrument, whose landed tip is its healthy
    // shape by design — so the alarm would claim a defiance that never
    // happened. The same words `helm lr list` prints, or one row reads two
    // ways. "unverified" and an absent stamp (old server) both stay LOUD: an
    // uncomputed ancestry pair is never guessed quiet. Display only —
    // `contrary` itself and `owed_by` are untouched.
    const disch = c.contrary_discharge;
    if (disch === "c" && lrHonored(c))
      marks.push({k: "mut", t: "CONFIRMATION: " + fact + " by design — the "
        + "resolution verified on trunk; the discharge instrument, never a debt"
        + provClause});
    else if (lrHonored(c))
      marks.push({k: "mut", t: "SUPERSEDED-CLOSED: " + fact + ", and the " + pol
        + " verdict was HONORED through succession ("
        + (disch === "a" ? "continuation" : "ladder discharge") + ")"
        + provClause});
    else if (disch === "unverified")
      marks.push({k: "bad", t: "CONTRARY? " + fact + " despite " + pol
        + " verdict — succession UNVERIFIED ("
        + String(c.succession_unknown_reason
          || "carrier relation or landing proof is unreadable")
        + "; no discharge was inferred)" + provClause});
    else
      marks.push({k: "bad", t: "CONTRARY: " + fact + " despite " + pol + " verdict"
        + (c.discharged ? " — DISCHARGED by " + String(c.superseding_tip || "-").slice(0, 12)
                        : " — owed by the integrator") + provClause});
  }
  if (c.withdraw_contradicted)
    marks.push({k: "bad", t: "WITHDRAWN, yet the change is on trunk — the withdrawal's premise no longer holds"});
  // THE SAME WORDS `helm lr list` PRINTS (landreq_cli._line) for a row whose
  // pinned tip main already holds with no verdict recorded — without them
  // this card draws it as a plain AWAITING_REVIEW row. Tri-state on the
  // wire: only a proven true says it.
  if (c.trunk_contains_tip === true)
    marks.push({k: "warn", t: "ALREADY ON TRUNK — this work is in history and the row "
      + "has NO VERDICT recorded; it is a LEDGER gap (a review that never "
      + "happened), not a slow reviewer and not a rebase its author owes"});
  // marks carry PLAIN text; lrRowHTML escapes them once on the way out
  // honored-first (same predicate as landreq._line): the stalled ALARM
  // yields to the honored banner — the successor already landed. `stalled`
  // and `owed_by` themselves are untouched.
  if (c.stalled && !lrHonored(c)) {
    if (c.succession_state === "moved") {
      // A proved successor already carries the work; keep the measurement on
      // the wire without publishing an alarm nobody can act on.
    } else if (c.succession_state === "unknown") {
      marks.push({k: "warn", t: "STALLED — succession UNKNOWN ("
        + String(c.succession_unknown_reason
          || "carrier relation or landing proof is unreadable")
        + "; whether a successor carried it cannot be read)"});
    } else {
      marks.push({k: "warn", t: "STALLED past its stage threshold — owed by "
        + (c.owed_by || "unknown")});
    }
  }
  // "could not look" is not "nothing there", and only one of them is news.
  if (c.receipt_state === "unreadable")
    marks.push({k: "warn", t: "LAND RECEIPT LEDGER UNREADABLE — helm could not read the receipt index, so this row's receipt is UNKNOWN, not absent (diagnostic only; git still governs)"});
  // A retirement helm cannot date. The row IS closed; the stamp beside it on
  // the ledger is not a timestamp, which is a repair to make and not an
  // absence to shrug at, so it is said on the collapsed row rather than only
  // behind a tap.
  if (c.closed_ts_unreadable)
    marks.push({k: "warn", t: "CLOSURE STAMP UNREADABLE — this row was retired and the ledger's stamp for it is not a timestamp, so WHEN it closed is UNKNOWN"});
  // A stamp that PARSES and cannot be true. Distinct from the one above: there
  // is nothing to re-read here, the record is simply dated after now.
  if (c.closed_ts_impossible)
    marks.push({k: "warn", t: "CLOSURE STAMP IMPOSSIBLE — the ledger dates this row's closure in the FUTURE, so WHEN it closed is UNKNOWN; the row is shown here only because it ENTERED its state inside the window"});
  // Attestation is a separate durable axis from verdict polarity. A mismatch is
  // not repaired by re-signing: the sidecar says what it actually bound, and the
  // row stays loud until the two durable ledgers agree again.
  if (c.attest_state === "unverifiable")
    marks.push({k: "warn", t: "ATTEST UNVERIFIABLE — the verdict stands; its signed delivery record does not verify against the current evidence — "
      + String(c.attest_detail || "the attest sidecar binds different verdict evidence")});
  else if (c.attest_state === "unknown" || c.attest_state === "doubt")
    marks.push({k: "warn", t: "ATTEST " + String(c.attest_state).toUpperCase()
      + " — " + String(c.attest_detail || "attestation state unavailable")});
  // A transition the record holds and the dispatch fold did not accept. It is
  // historical repair evidence, never the owner of current polarity.
  if (Array.isArray(c.ledger_refused) && c.ledger_refused.length)
    marks.push({k: "warn", t: "LEDGER ROW REFUSED — the dispatch store holds a historical "
      + c.ledger_refused.join("/") + " event its fold refused; current fields come only from accepted dispatch state"});
  // dwell_s is 0 when the age could not be measured, and 0 reads as "just
  // now" — the most flattering possible value for the oldest possible row.
  // The CAUSE is deliberately not named: it is the entry stamp on a live row
  // and the retirement instant on a retired one, and naming one of the two
  // sends him to re-read a stamp that is perfectly fine.
  if (!c.dwell_known)
    marks.push({k: "warn", t: "DWELL UNKNOWN — this row's age was never measured (the record carries no usable instant to measure from, or none to measure to), so it can never register as stalled"});
  if (reason)
    marks.push({k: "mut", t: "NOT MEASURABLE: " + reason + " — no stall is billable in either direction"});
  // WHY THE RECORD REFUSED TO CALL THIS ROW READY, in its own words — the
  // same sentence `helm lr show` prints under NOT READY, so the card and the
  // terminal cannot describe one row differently. It gets a line rather than
  // sharing the verification chip with the gate binding, because when a row
  // carries both, whichever is tested first silences the other.
  if (c.ungated)
    marks.push({k: "mut", t: "NOT READY — " + c.ungated});
  if (c.closed_by_landing)
    marks.push({k: "mut", t: "UNDECLARED — closed by landing, not by approval"});
  if (delivered)
    marks.push({k: "mut", t: "DELIVERED REPORT — artifact handoff recorded under explicit refs"
      + (c.delivered_report_correction ? " — explicit correction of preserved cancellation: "
        + String(c.cancel_reason || "reason unavailable") : "")});
  if ((c.state === "READY" || c.state === "MERGED_LOCAL") && !c.observable)
    marks.push({k: "mut", t: "landing unobservable — " + lrObserveReason(c.observe_why)});
  return marks;
}

/* The VERIFICATION chip: whether a gate receipt is BOUND to this row. That is
   a different axis from the lifecycle state ("landed" is where the code is),
   and a different axis again from whether the record REFUSED to call the row
   READY — which is `ungated`, and which lives in lrMarks.

   Those last two used to share this one chip, `gate` tested first. So a row
   that carried BOTH — a bound receipt whose gate_caps stamp is unreadable is
   refused READY, and a probe reproduced exactly that — printed "receipt NOT
   READ here" and nothing else: the binding was shown and the refusal was
   hidden behind it. Two facts in one slot means one of them is always the one
   that loses, so the refusal moved out to a line of its own. */
function lrGate(c) {
  const delivered = c.close_reason === "delivered-report";
  if (delivered)
    return '<span class="lrg" title="delivered-report carries handoff evidence, not a review gate">GATE N/A</span>';
  // A CHIP THAT CAN ONLY EVER BE BAD NEWS STOPS PRINTING. Owner ruling,
  // decision d2f490d0, 2026-08-06: "the chip goes quiet when there is nothing
  // to report ... gate state moves behind the card's expand with the rest of
  // the detail." Measured before he was asked: this function had exactly two
  // reachable outcomes on a live board — "receipt NOT READ here" when an id is
  // bound and "UNVERIFIED" when none is — so it was negative on 100% of cards,
  // and a badge every card wears is a badge the eye stops reading. That was
  // the remaining half of the alarm saturation in task/333.
  //
  // NOTHING IS LOST, which is what makes this a demotion rather than a
  // deletion: the expand's `lrcant` line already says WHICH of the two in
  // words, and it now carries the receipt id as well so the token is still one
  // click away. Same headlines-click-to-detail split UNDECLARED took.
  //
  // GATE N/A ABOVE SURVIVES DELIBERATELY: it is not bad news, it is the
  // narrow, true statement that no gate applies to a delivered-report row. The
  // rule this implements is that the chip prints only when it has something to
  // SAY — so when a VERIFIED branch exists, it belongs here and will read as
  // signal precisely because the negative cases are quiet.
  return "";
}

/* `closed` marks a row drawn under the CLOSED footer: only there is "when did
   this close" a question, and only there may the panel answer it.

   `under` marks a row drawn INSIDE a lane box that already prints the lane
   name. Measured in the browser 2026-08-11, on the very group built to cure
   this: `project-raw-batch-is-unproven-end-to-end` rendered its name FOUR
   times in one box — once as the caption and once as the bold headline of each
   of the three cards — and three identical bold headlines still read as three
   identical strangers, which is the owner's complaint surviving inside its own
   fix. So a nested row leads with the thing that actually tells it apart from
   its neighbours: its CHAIN. The lane is on the hover and, unchanged, on the
   expand's first line, so nothing left the card. UNNESTED ROWS ARE UNTOUCHED —
   the name is still the headline everywhere it is the distinguishing fact,
   which is task/333's property and every caller that omits this argument. */
function lrRowHTML(c, reason, closed, under) {
  const marks = lrMarks(c, reason);
  const alarm = marks.some(m => m.k === "bad" || m.k === "warn");
  // green is ONLY a landing git observed; alarm outranks it if both are true
  const cls = alarm ? "alarm" : c.landed ? "landed" : "";
  const who = esc(c.author || "?") + "→" + esc(c.reviewer || "?");
  const delivered = c.close_reason === "delivered-report";
  const pol = delivered ? "N/A"
    : c.polarity ? String(c.polarity).toUpperCase() : "UNDECLARED";
  const shownSha = delivered ? c.base_sha : c.review_sha;
  const shownShaFull = delivered ? c.base_sha : c.review_sha_full;
  // "?" and not "0m": an unreadable entry stamp is not an age of zero.
  const dwell = c.dwell_known ? lrDwell(c.dwell_s) : "?";
  // helm only reads trunk once a verdict is recorded, so an OPEN row's
  // landed/merged_local are both false because NOBODY LOOKED. Printing "not on
  // trunk" there states a git fact this card never obtained.
  const trunk = delivered
    ? "NO LAND CLAIM — this terminal records artifact handoff evidence, not Git"
    : c.abandoned ? "LAND STATE UNKNOWN — commit evidence was destroyed"
    : c.landed ? ("on " + (c.has_upstream ? "upstream" : "local") + " trunk")
    : c.merged_local ? "on local trunk, not pushed"
    : c.observable ? "not on trunk"
    : "NOT OBSERVED — git was not read for this row, so its trunk position is UNKNOWN";
  // A STEP WITH NO STAMP SAYS WHICH KIND OF NO-STAMP IT IS. "(git-observed)"
  // is true of exactly one step — the landing git noticed, which carries no
  // moment anywhere — and it used to be printed over every absent ts,
  // explaining an OPEN step (git is not read at all before a verdict) as
  // something git had seen. An unreadable stamp is a third thing again.
  const tl = (Array.isArray(c.timeline) ? c.timeline : [])
    .map(t => esc(t.state) + (t.ts ? " " + esc(t.ts)
      : t.ts_unreadable ? " (the ledger's stamp here is NOT A TIMESTAMP)"
      : t.ts_impossible ? " (the ledger's stamp here is dated in the FUTURE)"
      : t.observed ? " (git-observed, no ledger stamp)"
      : " (no stamp on the ledger event)"))
    .join(" → ");
  // THE IDENTIFYING TEXT GETS ITS OWN LINE, AND IT WRAPS RATHER THAN CLIPS.
  // task/333, owner-observed: "this board is ugly, nigh-unreadable". MEASURED
  // on the live console before this change — 36 cards, 236px wide, and the
  // line-1 flex budget was title 35px / state 105px / dwell 42px / warn 12px.
  // The STATE BADGE HELD THREE TIMES THE PIXELS OF THE NAME, because .lrlane
  // was the only child with flex:1 1 auto and min-width:0 and therefore
  // absorbed 100% of the squeeze: 34 of 36 titles clipped, the worst given
  // 3px to render 120px of text. And the average title width was 69px at
  // 1440, 1280, 1100 AND 960 body width — IDENTICAL — because this grid is
  // fixed-width, so widening the window or the card cannot fix it. Only
  // taking the title OUT of the competition can.
  return '<div class="lrrow ' + cls + '" data-id="' + esc(c.id) + '">'
    + '<div class="lrtitle"'
    + (under ? ' title="lane ' + esc(c.lane || "(no lane)")
      + " — one of several pieces of work filed under that NAME, which is a"
      + ' renamable label and not identity"' : "") + ">"
    + (under ? "↳ chain " + esc(String(lrChainRoot(c)).slice(0, 12))
             : esc(c.lane || "(no lane)")) + "</div>"
    + '<div class="lrl1"><span class="lrstate">' + esc(c.state) + "</span>"
    + '<span class="lrdwell">' + esc(dwell) + "</span>"
    + (alarm ? '<span class="lrwarn">⚠</span>' : "") + "</div>"
    + '<div class="lrl2"><span class="lrsha" data-sha="' + esc(shownShaFull || "")
    + '" title="' + (delivered
      ? "the preserved BUILD base — tap to copy the full sha"
      : "the reviewed commit — tap to copy the full sha") + '">' + esc(shownSha || "—") + "</span>"
    // POLARITY IS A HEADLINE ONLY WHEN IT SAYS SOMETHING. UNDECLARED was
    // printed on every undecided row — 11% of in-flight carry it and it reads
    // as an accusation — while the SAME fact is already spelled out in the
    // expand below ("verdict polarity ... (from <source>)"). An absent verdict
    // is the normal state of a row awaiting review, so it belongs behind the
    // disclosure with the rest of the agent-density, per the owner-surface
    // headlines-click-to-detail rule. A DECLARED polarity still leads.
    + '<span class="lrwho">' + who + "</span>"
    + (pol && String(pol).toUpperCase() !== "UNDECLARED"
        ? '<span class="lrpol">' + esc(pol) + "</span>" : "")
    + lrGate(c) + "</div>"
    + marks.map(m => '<div class="lrmark ' + m.k + '">' + esc(m.t) + "</div>").join("")
    + '<div class="lrx" hidden>'
    // the lane leads the expand as well: the headline now wraps rather than
    // ellipsizing (task/333), so this is a confirmation of the name rather
    // than the only place it is readable — and it stays first because every
    // field below it is qualified BY it
    + "<div><b>lane</b> " + esc(c.lane || "(no lane)") + "</div>"
    + "<div><b>id</b> <code>" + esc(c.id) + "</code></div>"
    + "<div><b>" + (delivered ? "base sha" : "reviewed sha")
    + "</b> <code>" + esc(shownShaFull || "—") + "</code></div>"
    + "<div><b>branch</b> " + esc(c.branch || "—") + "</div>"
    + (delivered
      ? "<div><b>artifact</b> " + esc(c.artifact_ref || "—") + "</div>"
        + "<div><b>report</b> " + esc(c.report_ref || "—") + "</div>"
        + "<div><b>evidence</b> " + esc(c.close_evidence || "—") + "</div>" : "")
    + "<div><b>author → reviewer</b> " + who + "</div>"
    + "<div><b>verdict polarity</b> " + esc(pol)
    + (delivered
      ? " <span>(not claimed by this terminal)</span></div>"
      : " <span title=\"the named store owns current verdict polarity; LR is only its projection\">(from "
        + esc(String(c.polarity_source || "source unknown").replace(/-/g, " ")) + ")</span></div>")
    + (!delivered && c.attest_state ? "<div><b>verdict attest</b> "
      + esc(String(c.attest_state).toUpperCase())
      + " <span title=\"read from the named durable sidecar; this view never re-signs\">(from "
      + esc(String(c.attest_source || "source unknown").replace(/-/g, " ")) + ")</span>"
      + (c.attest_detail ? " — " + esc(c.attest_detail) : "") + "</div>" : "")
    + "<div><b>trunk</b> " + esc(trunk) + "</div>"
    + (c.landing_trunk_sha ? "<div><b>trunk anchor</b> <code>" + esc(c.landing_trunk_sha) + "</code></div>" : "")
    + "<div><b>owed by</b> " + esc(c.owed_by || "—") + " · dwelling " + esc(dwell) + "</div>"
    + (tl ? "<div><b>timeline</b> " + tl + "</div>" : "")
    // THREE ANSWERS, NEVER TWO. A stamp; a stamp that is not one (printed as
    // the closure instant until a review read it back off a withdrawn row); and
    // no stamp anywhere, which is the ordinary case for a landing git
    // observed. The middle one is the record telling you to go repair it.
    + (closed ? "<div><b>closed</b> " + (c.closed_ts ? esc(c.closed_ts)
      : c.closed_ts_unreadable
        ? "the ledger's own retirement stamp for this row is NOT A TIMESTAMP, so WHEN this closed is UNKNOWN — repair that ledger row"
      : c.closed_ts_impossible
        ? "the ledger dates this row's closure in the FUTURE, which is not an instant it can have closed at, so WHEN this closed is UNKNOWN — repair that ledger row"
        : "no closure stamp — git records no moment for the merge helm observed, so WHEN this closed is UNKNOWN")
      + "</div>" : "")
    // THREE ANSWERS HERE TOO. A state the server SENT; the "I could not look"
    // state; and no state at all — which used to render as the word "none",
    // the card inventing a finding out of a field it was never sent. That was
    // the third rendering of "unreadable receipt storage" as "there is no
    // receipt" on this one card, and the only one living in the browser.
    + "<div><b>land receipt</b> " + (c.receipt_state === "unreadable"
      ? "LEDGER UNREADABLE — helm could not read the land-receipt index; this is NOT &quot;no receipt&quot;"
      : c.receipt_state ? esc(c.receipt_state)
      : "NOT SENT — this row reached the card with no receipt state at all, which is NOT &quot;no receipt&quot;")
    + " — diagnostic only; git governs</div>"
    + '<div class="lrcant">' + (delivered
      ? "this terminal validates reference syntax only (artifact/chat existence is not checked) and intentionally makes no reviewed-tip, verdict, gate, or Git landing claim"
      : "this card cannot prove the exact trunk commit, and "
        // THE TOKEN COMES WITH IT. The headline chip that used to print
        // `gate:<id>` is quiet now (owner ruling d2f490d0), so if the id did
        // not land here it would be gone from the surface entirely — which
        // would make this a deletion rather than the demotion it is meant to
        // be. It is the one thing a reader needs to go check the receipt.
        + (c.gate ? "has not read the gate receipt bound to this row (gate:"
                    + esc(String(c.gate).slice(0, 10)) + ")"
                  : "nothing has gate-checked this row at all"))
    + ". Cross-check outside the browser with <code>helm lr show " + esc(String(c.id).slice(0, 12))
    + "</code>.</div></div></div>";
}

/* ============ RELATED ROWS: ONE LANE NAME, ONE OR MORE WORK CHAINS ============

   THE DEFECT THIS EXISTS TO REMOVE, in the owner's words (2026-08-11): "if
   these are actually stacked somehow then they should display as related, the
   list you print on the webUI makes them look all separate". Every land-request
   row was drawn as its own top-level card, so one lane carrying several rounds
   read as several independent pieces of stalled work. MEASURED on his live
   board the same night: 41 in-flight rows under 30 DISTINCT LANE NAMES —
   `project-raw-batch-is-unproven-end-to-end` and `compose-reads-stale-projection`
   drew three cards each, six more names drew two. He had been reading that
   header as 41 separate problems.

   THE KEY IS THE CHAIN, AND THE LANE IS ONLY THE NAME ABOVE IT. This file's
   producer says it at length (landreq's span comment, task/734): a lane label
   is renamable free text and is not identity — keying on it makes one renamed
   piece of work count as many AND collapses two unrelated efforts that happen
   to share a name. So the nesting is TWO levels and they are not the same
   claim:

     lane name  — the OUTER box. It asserts only "these rows were filed under
                  one label", which is exactly what the owner is looking at and
                  exactly as much as a label can support. When one holds several
                  chains the header SAYS SO, so the box is never read as one
                  piece of work.
     chain_root — the INNER group, and the only work-identity claim made here.
                  Rounds of ONE effort (`--supersedes`, which carries the
                  immutable root) nest into one line: current state and age
                  visible, earlier rounds folded behind a tap.

   MEASURED CONSEQUENCE, so nobody reads more into this than it does: on that
   same live board all 41 live rows carried 41 DISTINCT chain roots, so chain
   nesting alone would have changed nothing on screen — the collapse the owner
   actually sees comes from the lane box, and the honest reading of that is "30
   names, 41 chains", which is what the header now prints. Chain nesting is not
   decoration for that: it fires the moment anyone files a round with
   `--supersedes` (the closed strip already holds such a pair), and it is what
   keeps the lane box from having to pretend a label is identity. */

/* WORK IDENTITY FOR ONE ROW — never the lane label.

   The fallback is "a root names itself" — the same seal `_append_dispatch`
   writes — and it is deliberately the row's own id with NO synthetic prefix:
   a row that founded a chain IS the row its descendants name, so an absent
   root joining its own descendants' group is correct, not a collision. The
   direction of the failure is what matters: an unreadable root can only ever
   SPLIT a group into singletons, never merge two efforts that are not one. */
function lrChainRoot(c) {
  const root = c && c.chain_root;
  return typeof root === "string" && root ? root : String((c && c.id) || "");
}

/* The lane LABEL, in one place, so the group box and every count of it cannot
   drift into naming the box two different things. */
function lrLaneName(c) {
  return String((c && c.lane) || "(no lane)");
}

/* WHICH ROUND OF A CHAIN IS HAPPENING NOW — the one no sibling supersedes.

   `supersedes` is a DECLARED relation in the record, so this is a read rather
   than a guess. The alternatives were both inferences the browser has no
   standing to make: "newest dwell" is wrong the moment a stamp is unreadable
   (dwell_s is a fabricated 0 there, which would elect the oldest round), and
   "last in server order" is an ordering, not a claim.

   ANYTHING BUT EXACTLY ONE UNSUPERSEDED ROW AND THIS FUNCTION DECLINES, taking
   the server's own first row instead. Zero (a cycle, or a chain whose head is
   already closed and out of this list) and two-or-more (a fork) are both
   records this browser may not adjudicate, and electing a head from a record
   that does not name one is inventing the very fact the group is built on. */
function lrChainHead(rows) {
  if (!rows || rows.length < 2) return 0;
  const superseded = new Set();
  rows.forEach(c => {
    if (c && typeof c.supersedes === "string" && c.supersedes)
      superseded.add(c.supersedes);
  });
  const open = rows.filter(c => !superseded.has(String((c && c.id) || "")));
  return open.length === 1 ? rows.indexOf(open[0]) : 0;
}

/* THE STRONGEST EVIDENCE AVAILABLE that same-named chains are one piece of
   work: they cite the SAME REVIEWED COMMIT. Three land requests at one tip are
   three requests over one piece of content, which is precisely the "actually
   stacked somehow" the owner suspected — and it is the thing a label cannot
   tell him.

   IT IS A DISCLOSURE AND NEVER A MERGE. landreq's own index records why: "A
   TIP CITED BY MANY PIECES OF WORK IS A BASE, NOT ONE PIECE OF WORK" — 15
   unrelated fan-out lanes once shared one tip. Printing the fact lets the
   owner decide; merging on it would rebuild that defect in the renderer.

   REVIEW ROWS ONLY, AND `review_sha_full` ONLY. On a `--kind build` row the
   cited commit is the BASE the work started FROM, not content under review;
   comparing the two is the exact conflation that once let one landing be
   claimed by five roots. A build row therefore never contributes to, and is
   never counted in, this reading. */
function lrSharedTip(chains) {
  const by = new Map();
  (chains || []).forEach(ch => {
    const c = ch && ch.head;
    if (!c || c.kind !== "review") return;
    const tip = typeof c.review_sha_full === "string" ? c.review_sha_full : "";
    if (!tip) return;
    by.set(tip, (by.get(tip) || 0) + 1);
  });
  let best = null;
  by.forEach((n, tip) => {
    if (n > 1 && (!best || n > best.chains)) best = {tip: tip, chains: n};
  });
  return best;
}

/* PURE (data in, plain objects out — the lrCardHTML pattern, so tests run this
   exact source under node). Rows in, one entry per LANE NAME out:

     [{lane, rows, chains: [{root, rows: [card…], head: card, earlier: [card…]}],
       shared_tip: {tip, chains} | null}]

   STABLE FIRST-APPEARANCE ORDER at both levels. The server already sorts these
   rows canonically (stage, then dwell) and every consumer here re-uses that
   order rather than inventing a second one; a lane takes the position of its
   FIRST row, so nothing jumps around a board the owner has learned to scan. */
function lrLaneGroups(rows) {
  const lanes = new Map();
  (rows || []).forEach(c => {
    const name = lrLaneName(c);
    if (!lanes.has(name))
      lanes.set(name, {lane: name, rows: 0, chains: [], byRoot: new Map()});
    const g = lanes.get(name);
    const root = lrChainRoot(c);
    if (!g.byRoot.has(root)) {
      const chain = {root: root, rows: [], head: null, earlier: []};
      g.byRoot.set(root, chain);
      g.chains.push(chain);
    }
    g.byRoot.get(root).rows.push(c);
    g.rows += 1;
  });
  const out = [];
  lanes.forEach(g => {
    delete g.byRoot;                  // a build scaffold, not part of the shape
    g.chains.forEach(chain => {
      const i = lrChainHead(chain.rows);
      chain.head = chain.rows[i];
      chain.earlier = chain.rows.filter((_c, j) => j !== i);
    });
    g.shared_tip = lrSharedTip(g.chains);
    out.push(g);
  });
  return out;
}

/* PURE: one lane group as markup, for the list view AND for a board column —
   ONE renderer, because two would be how the two views came to draw one lane's
   rows as related in one place and separate in the other.

   A LANE WITH ONE CHAIN AND ONE ROW RENDERS EXACTLY AS IT ALWAYS DID: the bare
   `lrRowHTML` card, byte for byte, no box, no header, no chrome. That is 21 of
   the owner's 30 lanes, and a grouping that redecorated them would be charging
   every quiet lane for a problem it does not have. */
function lrGroupHTML(g, unmeas) {
  const look = c => (unmeas instanceof Map ? unmeas.get(c && c.id) : undefined);
  const chains = (g && g.chains) || [];
  // ONE ROUND, ONE CHAIN — the unchanged card.
  if (chains.length === 1 && !chains[0].earlier.length)
    return lrRowHTML(chains[0].head, look(chains[0].head));
  // ONLY a lane box that prints the NAME above its children may take the name
  // off them. A single chain gets no caption (its own headline is the name),
  // so its rows keep theirs.
  const under = chains.length > 1;
  const body = chains.map(chain => {
    const n = chain.earlier.length;
    return lrRowHTML(chain.head, look(chain.head), false, under)
      + (n
        // NEXT-SIBLING TOGGLE, NOT AN ID. The card, the board and the home
        // glance can all draw the same chain in one document, so any id
        // minted from the root would be duplicated across surfaces and every
        // tap would open whichever copy the DOM found first.
        ? '<button type="button" class="lrgmore" data-lrmore="1"'
          + ' aria-expanded="false" title="earlier rounds of THIS SAME work'
          + " — same chain root " + esc(String(chain.root).slice(0, 12))
          + ', superseded by the round above">' + n + " earlier round"
          + (n === 1 ? "" : "s") + " in this chain — tap to show</button>"
          + '<div class="lrgearlier" hidden>'
          + chain.earlier.map(c => lrRowHTML(c, look(c), false, under)).join("")
          + "</div>"
        : "");
  }).join("");
  // ONE CHAIN, SEVERAL ROUNDS: the row's own headline already prints the lane
  // name, so a header repeating it would be noise. The box is only the fold.
  if (chains.length === 1)
    return '<div class="lrgrp">' + body + "</div>";
  const st = g.shared_tip;
  return '<div class="lrgrp multi">'
    + '<div class="lrghead" title="these rows were filed under ONE LANE NAME'
    + " and helm does not read a name as identity: a lane label is renamable"
    + " free text, so the " + chains.length + " chains below are grouped here"
    + " because they SHARE A NAME, not because the record says they are one"
    + ' piece of work">'
    + '<span class="lrglane">' + esc(g.lane) + "</span>"
    + '<span class="lrgn">' + chains.length + " chains · " + g.rows
    + " row" + (g.rows === 1 ? "" : "s") + "</span></div>"
    + (st
      // THE ONE PIECE OF EVIDENCE A NAME CANNOT GIVE HIM. Stated, never acted
      // on: the rows stay separate because the record keeps them separate.
      ? '<div class="lrgnote" title="a shared reviewed commit is evidence, not'
        + " identity — a tip cited by many chains can also be a shared BASE,"
        + ' so this is said and never merged">' + st.chains
        + " of these chains cite the SAME reviewed commit "
        + esc(String(st.tip).slice(0, 12))
        + " — one piece of content under " + st.chains
        + " separate land requests</div>"
      : "")
    + body + "</div>";
}

/* A column's place on the board. The rank mirrors landreq.STAGE_ORDER's
   pipeline direction (left = dispatched, right = terminal); a state this list
   has never met sorts LAST and is still drawn, because dropping a column is
   dropping rows. READY-<RUNG> variants (READY-SELF-REVIEW, …) sit beside
   READY: the rung is the point, so each keeps its own column. */
function lrKbRank(state) {
  const order = ["OPEN", "AWAITING_BUILD", "AWAITING_REVIEW",
    "CHANGES_REQUESTED", "REVIEWED", "READY", "MERGED_LOCAL", "LANDED",
    "SUPERSEDED", "DELIVERED_REPORT", "ABANDONED"];
  const i = order.indexOf(String(state));
  if (i >= 0) return i;
  if (String(state).indexOf("READY") === 0) return order.indexOf("READY") + 0.5;
  return order.length;
}

/* WHICH COLUMN a row belongs to, in one place: the board groups by it and the
   closed partition counts what LEFT each column by it, and a second copy of
   `c.state || "(no state)"` is how the two would drift into naming different
   columns for one row. */
function lrKbKey(c) {
  return String((c && c.state) || "(no state)");
}

/* PURE (data in, string out — the lrCardHTML pattern, so tests run this exact
   source under node). One column per STATE STRING THE ROWS ACTUALLY CARRY —
   the exact word the list view prints in .lrstate, never a client-side
   vocabulary — and a column exists only for states present in the data: the
   list draws no row for an absent state, and this view invents no empty
   column for one. The cards ARE lrRowHTML's rows, so kanban and list can
   never disagree about one row.

   `discharged` is a state→count Map of rows that left this board for the
   CLOSED strip (verified-superseded / confirmation — owner 2026-08-04:
   "superseded, if verified, should just be like another type of closed").
   Those rows are NOT drawn here: the column holds only undischarged work.
   What stays is a DOOR — the same `data-lrclosed` toggle the closed footer
   carries, so the rows that left are one tap away from the column they left,
   and a state whose every row was discharged keeps its (card-less) column
   rather than vanishing with no trace of where 9 rows went. */
function lrKanbanHTML(loops, unmeas, discharged) {
  const off = discharged instanceof Map ? discharged : new Map();
  const cols = new Map();
  loops.forEach(c => {
    const k = lrKbKey(c);
    if (!cols.has(k)) cols.set(k, []);
    cols.get(k).push(c);
  });
  off.forEach((n, k) => { if (n && !cols.has(k)) cols.set(k, []); });
  const keys = Array.from(cols.keys())
    .sort((a, b) => lrKbRank(a) - lrKbRank(b) || (a < b ? -1 : a > b ? 1 : 0));
  return '<div class="lrkb">' + keys.map(k => {
    const rows = cols.get(k);
    // the SAME alarm predicate the row renders with — a column is loud
    // exactly when a card inside it is, never on a parallel count
    const alarms = rows.filter(c => lrMarks(c, unmeas.get(c && c.id))
      .some(m => m.k === "bad" || m.k === "warn")).length;
    const gone = off.get(k) || 0;
    return '<div class="lrkcol' + (alarms ? " alarmed" : "") + '">'
      + '<div class="lrkhead"><span class="lrkstate" title="' + esc(k) + '">'
      + esc(k) + "</span>"
      + (alarms ? '<span class="lrkwarn" title="' + alarms + " row"
        + (alarms === 1 ? "" : "s") + ' in this column carry an alarm mark">⚠'
        + alarms + "</span>" : "")
      + '<span class="lrkn" title="' + rows.length + " row"
      + (rows.length === 1 ? "" : "s") + ' in this state">' + rows.length
      + "</span></div>"
      // SAME LANE→CHAIN NESTING AS THE LIST (one owner, `lrGroupHTML`). A
      // column already groups by STATE, which is a different axis and not a
      // substitute: `project-raw-batch-is-unproven-end-to-end` put two of its
      // three rows side by side in READY, and side-by-side in one column is
      // exactly the "all separate" reading on the view the owner opens by
      // default.
      + '<div class="lrkrows">'
      + lrLaneGroups(rows).map(g => lrGroupHTML(g, unmeas)).join("")
      + "</div>"
      + (gone ? '<button type="button" class="lrkfoot" data-lrclosed="1"'
        + ' title="' + gone + " row" + (gone === 1 ? "" : "s")
        + " in this state discharged their verdict — superseded through"
        + " succession, or a confirmation round — so they are counted CLOSED"
        + " and are not work in this column. Each keeps its own"
        + " SUPERSEDED-CLOSED / CONFIRMATION line in the closed list"
        + ' below">' + gone + " discharged — closed · tap to show</button>" : "")
      + "</div>";
  }).join("") + "</div>";
}

/* Is this answer a BOARD? A 200 whose body the card cannot read is not an empty
   pipeline — it is an unread one, and it used to render as the happiest state
   this card has: `lrCardHTML({})` printed "0 in flight", "the dispatch ledger
   READ cleanly", "nothing closed in the last 24h" and badged 0. The
   card already fails closed on malformed JSON and on a read that never
   answered; a response whose SCHEMA regressed is the same fact arriving through
   a different door.

   The four ROW-CARRYING arrays are the test, and deliberately not every field:
   `closed_total` absent is a degradation the card renders honestly on purpose
   ("TOTAL UNKNOWN"), and demanding it here would convert a designed honest
   branch into an outage. ONE owner for both readers below — a recogniser the
   badge and the body disagree about is a badge that says 0 over a strip that
   says UNKNOWN. */
function lrIsBoard(d) {
  return !!d && Array.isArray(d.loops) && Array.isArray(d.stalled_ids)
    && Array.isArray(d.unmeasurable) && Array.isArray(d.closed_recent);
}

/* WHAT IS BUILDING — the owner's 13:26 question, as a reader.

   He opened this card over a fleet with three live builds on it and read
   "0 in flight", then asked whether that could be true while work was
   plainly ongoing. The card was not wrong: it counts LAND REQUESTS, and a land
   request is filed at the END of a build. What it had no words for was the
   part before that, which is most of the work most of the time. `building` is
   that reading, from `helm work list` rather than from the dispatch ledger.

   THREE STATES AND THEY ARE NOT INTERCHANGEABLE. "absent" is a server that
   predates this band: it sent no key, so this card says NOTHING about
   building rather than inventing a zero for it (the law every other term on
   this card obeys — an absent reading is never a measured one). "unknown" is a
   reading that was ATTEMPTED and failed, and it is loud, because "the lane
   rooms could not be read" and "nothing is being built" are the two sentences
   this whole card exists to keep apart. "ok" carries rows, and a zero there is
   a MEASURED zero and worth printing — "nothing is being built" is exactly the
   claim he needs to be able to trust.

   PURE, and shared by the pipeline card and the home band for the reason
   lrHonored records one screen down: two surfaces that classify the same
   payload separately disagree about it within the day. */
function lrBuilding(d) {
  const b = d && d.building;
  if (!b || typeof b !== "object")
    return {state: "absent", rows: [], total: null, unmeasured: 0, why: ""};
  if (b.unavailable)
    return {state: "unknown", rows: [], total: null, unmeasured: 0,
            why: String(b.unavailable)};
  if (!Array.isArray(b.rows))
    return {state: "unknown", rows: [], total: null, unmeasured: 0,
            why: "the lane reading arrived with no rows in it — what is "
              + "BUILDING is UNKNOWN, not zero"};
  // THE TOTAL IS THE SERVER'S, NEVER THE LENGTH OF THE CAPPED LIST — the
  // closed-footer lesson, one band over: a cap may hide rows, it may not edit
  // the number. A body carrying rows and no total is half-shaped, and the
  // count then says so rather than quietly reporting the cap.
  const total = typeof b.total === "number" ? b.total : null;
  return {state: "ok", rows: b.rows, total,
          unmeasured: typeof b.unmeasured === "number" ? b.unmeasured : 0,
          why: ""};
}

/* The count term, for the pipeline card's header and the home band's headline
   — ONE sentence, so the two numbers the owner reads in two places cannot be
   spelled differently. "" on an absent reading: silence, never a zero. */
function lrBuildingTerm(bd) {
  if (bd.state === "absent") return "";
  if (bd.state === "unknown") return "building UNKNOWN";
  return (bd.total === null ? "?" : bd.total) + " building";
}

/* The band itself: one line per lane, the four facts `helm work list` prints. */
function lrBuildingHTML(bd) {
  if (bd.state === "absent") return "";
  if (bd.state === "unknown")
    return '<div class="lrbuild"><div class="lrbhead unk">⚠ WHAT IS BUILDING — UNKNOWN</div>'
      + '<div class="lrbwhy">' + esc(bd.why) + "</div></div>";
  const dropped = bd.total === null ? 0 : Math.max(0, bd.total - bd.rows.length);
  const head = (bd.total === null ? "?" : bd.total)
    + " lane" + (bd.total === 1 ? "" : "s") + " BUILDING"
    + (dropped ? " — showing " + bd.rows.length + ", " + dropped
        + " not shown (<code>helm work list</code>)" : "");
  // WHY THE ROWS ARE HERE AT ALL and not only a number: the owner steers from
  // this page, and "4 building" with no names tells him work exists without
  // telling him whose. The holder is the column he actually uses.
  const rows = bd.rows.map(r => {
    r = r || {};
    const left = lrDur(r.lease_remaining_s);
    return '<div class="lrbrow"><span class="lrblane">'
      + esc(String(r.lane || "(lane not recorded)")) + "</span>"
      + '<span class="lrbwho">' + esc(r.holder ? "@" + r.holder : "holder UNKNOWN")
      + "</span>"
      + '<span class="lrbn" title="commits on this lane that the trunk ref does '
      + 'not have yet">+' + (typeof r.ahead === "number" ? r.ahead : "?")
      + "</span>"
      + '<span class="lrblease" title="how much of this lane’s claim is LEFT, '
      + "not how long it has been held: a claim row carries an expiry and a "
      + 'last-renewed stamp, and no instant for when the lease was first taken">'
      + (left === null ? "lease UNKNOWN" : "lease " + left + " left") + "</span>"
      + (r.dirty ? '<span class="lrbdirty" title="uncommitted edits in this room '
        + '— the +N beside it counts COMMITS only">+edits</span>' : "")
      + "</div>";
  }).join("");
  const unm = bd.unmeasured
    ? '<div class="lrbwhy">' + bd.unmeasured + " further leased lane"
      + (bd.unmeasured === 1 ? " whose distance from" : "s whose distance from")
      + " the trunk git could not answer — counted NEITHER as building nor as"
      + " idle, because “?” is not “0”</div>"
    : "";
  return '<div class="lrbuild"><div class="lrbhead">' + head + "</div>"
    + (bd.rows.length ? '<div class="lrbrows">' + rows + "</div>"
      : '<div class="lrbwhy">no lane room holds a live claim with commits the '
        + "trunk does not have — this is a MEASURED zero, read from "
        + "<code>helm work list</code>, not an absence of information</div>")
    + unm + "</div>";
}

/* WHO HOLDS THE BALL NOW. The server resolves this pair after succession
   annotation; the browser only formats it. In particular it must not translate
   lrHonored/contrary/state/owed_by independently — that made confirmation rows
   say "nobody" here while the CLI still said "integrator". An older or
   half-shaped response fails closed as holder UNKNOWN. */
function lrBall(c) {
  c = c || {};
  const role = String(c.holder_role || "unknown");
  const seat = c.holder_seat ? String(c.holder_seat) : null;
  if (seat) return {role, seat, text: role + " @" + seat};
  if (role === "nobody") return {role, seat: null, text: "nobody"};
  if (role === "unknown") return {role, seat: null, text: "holder UNKNOWN"};
  return {role, seat: null, text: role + " (seat not recorded)"};
}

/* THE IN-FLIGHT RENDERERS ARE GONE, NOT ORPHANED (owner ruling, task/2355).
   `lrInflightMoving`, `lrInflightRowHTML`, `lrInflightHTML` and
   `lrInflightWire` drew one line per live loop — lane, state, holder,
   dwell, marks — into the home band, and they had exactly one caller.
   The owner ruled that the cards repeating the ones he uses come off, and
   by his own account the row text is agent jargon he never reads; the
   holder column was the part that answered a question of his, and
   `dashOwedBy` answers it as names and counts instead. Deleting the row
   and keeping its renderers would have left ~130 lines no caller can
   reach, which reads as coverage. The helpers they shared — `lrMarks`,
   `lrDwell`, `lrChainRoot`, `lrLaneName`, `lrBall` — all keep other
   callers on the pipeline wall and in `dashOwedBy`, so nothing else moved. */


/* PURE: the whole card body as a string. Every branch here is a test case.
   `view` chooses how the IN-FLIGHT rows are drawn — "list" is the flat wall,
   anything else (including absent: every caller that does not care) is the
   kanban board, so the default cannot drift to the list by omission. */
function lrNonbillableLabels(d, ids) {
  // The server owns authorization classification. An older/unrecognised
  // response is explicitly unclassified, never guessed from hold prose.
  const labels = new Map([
    ["pre-tier", "pre-tier (not authorized)"],
    ["advisory", "advisory (not authorized)"],
    ["authorization-held", "authorization held"],
    ["unbillable", "other nonbillable"],
    ["unclassified", "unclassified nonbillable"]
  ]);
  const counts = new Map(), seen = new Set();
  (d.unmeasurable || []).forEach(u => {
    if (!u || !ids.has(u.id) || seen.has(u.id)) return;
    seen.add(u.id);
    const kind = labels.has(u.kind) ? u.kind : "unclassified";
    counts.set(kind, (counts.get(kind) || 0) + 1);
  });
  return [...labels].filter(([kind]) => counts.has(kind))
    .map(([kind, label]) => counts.get(kind) + " " + label);
}

function lrCardHTML(d, view) {
  d = d || {};
  view = view === "list" ? "list" : "kanban";
  const label = '<span class="slabel">land pipeline</span>';
  const how = '<span class="lrhow"><code>helm lr list</code></span>';
  if (d.pending) {
    // NOTHING HAS ANSWERED YET. This is the card's FIRST PAINT and the state a
    // hung /api/lr leaves it in until the fetch deadline fires. Before it
    // existed the section was an empty <section> with the nav badge at 0 —
    // pixel-identical to a healthy quiet board, which is "nothing outstanding"
    // said by a card that has read nothing at all.
    return '<div class="lrhead">' + label
      + '<span class="lrcounts">NOT READ YET</span>' + how + "</div>"
      + '<div class="lrpending">⌛ READING THE LAND PIPELINE — nothing has answered yet</div>'
      + '<div class="lrfresh">this card is blank because no read has COMPLETED, not because '
      + "nothing is in flight. If it stays this way, check <code>helm lr list</code>.</div>";
  }
  // WARMING IS NOT UNREADABLE. The server says "I have not computed this yet"
  // — a fact about a CACHE, not about the record. Asserting the ledger cannot
  // be READ on a cold start was a false claim the owner met first, on every
  // view after a restart. Checked BEFORE unavailable so a warming body can
  // never fall through into the alarm branch.
  if (d.warming) {
    return '<div class="lrhead">' + label
      + '<span class="lrcounts">reading…</span>' + how + "</div>"
      + '<div class="lrwhy">the pipeline is being read now — this is the FIRST '
      + "read since the server started, and it costs a full projection. "
      + "Nothing is wrong with the record; it has not been computed yet, and "
      + "this card refreshes itself when it is.</div>";
  }
  // A MISSED DEADLINE DURING A REBUILD IS THE `warming` FACT ARRIVING BY A
  // DIFFERENT DOOR: the server is computing, the record is fine, and this
  // card repairs itself on the next poll. It is checked before `unavailable`
  // for the same reason `warming` is — so it can never fall through into the
  // alarm branch — and it deliberately carries NO terminal instruction,
  // because nothing is wrong for a terminal to fix.
  if (d.rebuilding) {
    return '<div class="lrhead">' + label
      + '<span class="lrcounts">reading…</span>' + how + "</div>"
      + '<div class="lrwhy">' + esc(String(d.rebuilding)) + ". A full "
      + "projection takes about half a minute and helm is doing one now. "
      + "Nothing is wrong with the record; this card refreshes itself when "
      + "the read lands.</div>";
  }
  if (d.unavailable) {
    // The record could not be READ. No rows, no counts, no reassurance.
    return '<div class="lrhead">' + label
      + '<span class="lrcounts">UNKNOWN</span>' + how + "</div>"
      + '<div class="lrunknown">⚠ DISPATCH LEDGER UNREADABLE — pipeline UNKNOWN</div>'
      + '<div class="lrwhy">' + esc(String(d.unavailable)) + "</div>"
      + '<div class="lrfresh">no rows are shown because none could be READ — this is '
      + "not an empty pipeline. Check it from a terminal with <code>helm lr list</code>.</div>";
  }
  if (!lrIsBoard(d)) {
    // The read SUCCEEDED and the answer is not a board. Same strip as an
    // unreadable ledger, because the owner is in the same position: nothing on
    // screen was read, and a count would be invented.
    return '<div class="lrhead">' + label
      + '<span class="lrcounts">UNKNOWN</span>' + how + "</div>"
      + '<div class="lrunknown">⚠ ANSWER NOT RECOGNISED — pipeline UNKNOWN</div>'
      + '<div class="lrwhy">the land-pipeline read returned successfully with a body this '
      + "card cannot read (no land-loop rows in it), so nothing here was measured</div>"
      + '<div class="lrfresh">this is NOT an empty pipeline — it is an unread one. Check it '
      + "from a terminal with <code>helm lr list</code>.</div>";
  }
  const loops = Array.isArray(d.loops) ? d.loops : [];
  const stalled = new Set(Array.isArray(d.stalled_ids) ? d.stalled_ids : []);
  const unmeas = new Map((Array.isArray(d.unmeasurable) ? d.unmeasurable : [])
    .map(u => [u && u.id, u && u.reason]));
  const closed = Array.isArray(d.closed_recent) ? d.closed_recent : [];
  // A VERIFIED-quiet row is CLOSED, not work (owner 2026-08-04: "superseded,
  // if verified, should just be like another type of closed"). lrHonored —
  // THE display predicate — partitions the rows ONCE, and the honored side
  // (a/b honored through succession, "c" the confirmation instrument) leaves
  // the in-flight surfaces for the closed strip below: the board's
  // SUPERSEDED column holds only undischarged rows. The RECORD keeps the
  // distinction — each such row still prints SUPERSEDED-CLOSED /
  // CONFIRMATION, never a plain retirement — only the PLACEMENT and the
  // accounting move. "contrary" and "stalled" count LIVE alarms only, and
  // the honored count is never silently dropped (it moves to the closed
  // accounting): the header said "11 contrary" over 6 live + 5 honored
  // (2026-08-04), and the first fix left the same row counted "1 stalled ·
  // 1 honored" while its own mark rendered quiet. "unverified" and
  // an absent stamp both stay LIVE and in the alarm: fail-closed.
  const live = loops.filter(c => !lrHonored(c));
  const liveIds = new Set(live.map(c => c && c.id));
  const honoredRows = loops.filter(lrHonored);
  const honored = honoredRows.length;
  // WHICH column each discharged row left, so the board can leave a door
  // there instead of a hole. Keyed by lrKbKey — the board's own grouping
  // key, never a second reading of `state`.
  const honoredByCol = new Map();
  honoredRows.forEach(c => {
    const k = lrKbKey(c);
    honoredByCol.set(k, (honoredByCol.get(k) || 0) + 1);
  });
  const contrary = live.filter(c => c && c.contrary).length;
  const stalledN = [...stalled].filter(id => liveIds.has(id)).length;
  // THE SHAPE THE ROWS ARE ACTUALLY DRAWN IN, computed ONCE and used by both
  // the header and the body below — a header counting a grouping the body did
  // not draw is this card's own recorded failure ("the count filtered and the
  // list did not"), one axis over.
  const groups = lrLaneGroups(live);
  const chainsN = groups.reduce((n, g) => n + g.chains.length, 0);
  // "IN FLIGHT" IS NOT REDEFINED, AND THAT IS DELIBERATE. It counts ROWS, it is
  // `landreq.inflight_rows` on the other transport, and this file's history is
  // one long record of what happens when a noun on this card quietly starts
  // naming a second number (`filed.in_flight` → `open`, task/324; the honored
  // partition, 2026-08-04). The owner's actual question — "how many separate
  // things am I looking at" — gets NEW terms with their OWN words instead, so a
  // reader returning to a number he memorised is never silently compared
  // against a different metric:
  //
  //   in flight    rows moving, unchanged, same predicate as `helm lr list`
  //   chains       DISTINCT PIECES OF WORK (chain_root) — the honest answer to
  //                "how many separate problems". Equal to in-flight whenever
  //                every chain has one live round, which is the common case;
  //                lower the moment a chain carries several.
  //   lane names   how many BOXES are drawn below. Never a work count — a name
  //                is a label — but it is the number of things his eye lands
  //                on, and it was the missing one: 41 rows read as 41 problems
  //                because nothing on screen said they sat under 30 names.
  //
  // AND THE SUBTRACTION IS STATED WHERE THE NUMBER IS. The honored partition
  // has been excluded from both counts since 2026-08-04, but it was disclosed
  // only in the CLOSED FOOTER at the far end of the card, and a reader at the
  // header had nothing telling him a subtraction had happened at all. Measured
  // 2026-08-12: a teammate with the ledger open and `git merge-base` in hand
  // read this same board, concluded the header was counting five settled
  // confirmation rows as live debt, and went as far as trying to `lr close`
  // them — helm refused, correctly, because they are the discharge instrument.
  // Nothing was wrong with the numbers; the DISCLOSURE was three screens from
  // the claim it qualified. If a reader with instruments got it wrong, the
  // owner reading a phone was never going to get it right.
  // BUILDING SITS BESIDE IN FLIGHT because that is where the owner read the
  // zero: "0 in flight ... work is ongoing", over a busy fleet. It is a
  // SECOND SOURCE, not a redefinition — `in flight` still counts exactly the
  // rows `helm lr list` prints, which is the law the span above spends thirty
  // lines on — and the two terms partition the work: a lane leaves this one
  // and enters that one the moment its land request is filed.
  const bd = lrBuilding(d);
  const bterm = lrBuildingTerm(bd);
  const counts = [live.length + " in flight"]
    .concat(bterm ? [bterm] : [])
    .concat([stalledN + " stalled"])
    .concat(contrary ? [contrary + " contrary"] : [])
    .concat(lrNonbillableLabels(d, liveIds))
    .concat([chainsN + " chain" + (chainsN === 1 ? "" : "s"),
             groups.length + " lane name" + (groups.length === 1 ? "" : "s")])
    .concat(honored ? [honored + " settled, not counted above"] : [])
    .join(" · ");
  // THE CLAUSE RIDES ITS TERM. An explanation of a number this card did not
  // print is noise at best, and on an older server — which sends no lane
  // reading at all — it would be this card asserting a band it does not have.
  const buildingWhy = bterm
    ? " · building = LANE ROOMS holding a live claim with commits the trunk"
      + " does not have and NO land request filed yet, read from `helm work"
      + " list` — a different record from every other number here, which is"
      + " the point: a build files its request at the END, so this is the work"
      + " that exists before anything on the ledger knows about it. The two"
      + " terms partition: a lane leaves this one and joins in flight in the"
      + " same read that files its row." : "";
  const countsWhy = "in flight = ROWS moving (the same predicate `helm lr list`"
    + " prints — unchanged)" + buildingWhy + " · chains = DISTINCT PIECES OF WORK, keyed on the"
    + " immutable chain root a superseding round carries, which is the count of"
    + " separate problems · lane names = how many boxes are drawn below. A lane"
    + " is a renamable LABEL and never identity, so a box holding several"
    + " chains says so on its header rather than claiming they are one piece of"
    + " work. · settled = rows whose verdict was discharged through succession,"
    + " or which ARE a confirmation round — helm's own words for them are"
    + " “the discharge instrument, never a debt”. They were ALREADY"
    + " subtracted from every number to the left of this one and already moved"
    + " out of the list below; this term exists so that subtraction is visible"
    + " here rather than only in the closed strip at the foot of the card. They"
    + " are not hidden — they are one tap away under “closed in the"
    + " last 24h”.";
  const skipped = typeof d.receipts_skipped === "number"
    ? " · " + d.receipts_skipped + " receipt row" + (d.receipts_skipped === 1 ? "" : "s")
      + " skipped (failed self-hash)" : "";
  const fresh = "ledger read " + lrAgo(d.read_age_s) + " · newest ledger write "
    + lrAgo(d.ledger_age_s) + skipped;
  // FILED — the all-time population behind this board, from the same read.
  // Absent is SAID (an older server sent no split), never rendered as a zero
  // and never re-derived from the capped lists above — a length is not a
  // count (the closed_total lesson, one field over). Per-term "?" keeps a
  // half-shaped split honest without discarding the terms that did arrive.
  const f = (d.filed && typeof d.filed === "object") ? d.filed : null;
  // LEGACY WIRE KEY, read under the new name. `in_flight` was renamed `open`
  // (task/324) because one word named two numbers; but the console is served
  // from disk while the SERVER process can be older, so a hot-reloaded UI
  // against a pre-rename server got a perfectly well-formed split and
  // rendered "? open" — which reads as "the server sent a broken split"
  // when the truth is a version skew, and sends the reader to debug the
  // wrong thing. "?" stays the answer for a genuinely absent term;
  // it is not the answer for a term that arrived under its old name.
  // REMOVABLE once no deployed server predates the rename.
  const FILED_WAS = {open: "in_flight"};
  const fnum = k => {
    if (!f) return null;
    if (typeof f[k] === "number") return f[k];
    const was = FILED_WAS[k];
    return was && typeof f[was] === "number" ? f[was] : null;
  };
  const fterm = k => { const n = fnum(k); return n === null ? "?" : String(n); };
  // THE OFF-FRONTIER RESIDUE (task/2381), term for term with
  // landreq.off_frontier_line. `open` no longer leads this strip: it named
  // one number for two populations — work the owner is owed, and rows whose
  // lane branch no longer exists in any repository — and he read the second
  // as the first. Silent on zero AND on absent: a board with no residue says
  // nothing about debris it does not have, and a server older than this split
  // sends no key at all, where naming a "?" residue plus a command to clear
  // it would send a reader after rows nobody counted.
  // TWO NUMBERS, BECAUSE THE RESIDUE IS TWO POPULATIONS. "Placed" is the
  // classification's answer — the lane is gone and git can say where the work
  // went — and it is NOT "the close ladder will take it". Measured over 316
  // placed rows on a copy of the live ledger, the authorizing witness
  // affirmed 122 and refused 182, so a single number covering both facts is
  // wrong about 58% of what it calls clearable. A body
  // carrying the residue and NO split makes no clearance claim at all: a zero
  // invented here would say "nothing can be cleared" about a board nobody
  // measured.
  const offN = fnum("off_frontier");
  const okN = fnum("closable"), noN = fnum("not_closable");
  let offTerm = "";
  if (offN !== null && offN > 0) {
    offTerm = " · " + offN + " OFF-FRONTIER (lane gone AND the work placed —"
      + " not work owed)";
    if (okN === null || noN === null) {
      offTerm += " · helm lr retire --off-frontier censuses them";
    } else {
      if (okN > 0) {
        offTerm += " · " + okN + " closable now: helm lr retire"
          + " --off-frontier --apply closes these " + okN;
      }
      if (noN > 0) {
        // NO APOSTROPHE: this string is rendered through esc() and the CLI
        // prints the identical bytes, so a `'` here would become `&#39;` and
        // break the byte-identical parity the strip is held to.
        offTerm += " · " + noN + " placed but NOT closable yet — the close"
          + " ladder cannot take the witness these rows need (helm lr retire"
          + " --off-frontier names the refusal per row)";
      }
    }
  }
  // A BODY WITH NO FRONTIER TERMS PRINTS THE OLD WORDING, NOT A "?" — the
  // same version-skew rule FILED_WAS encodes one rename over. An older
  // server's `open` is a real number; only the SPLIT of it is missing, and
  // "? open on the live frontier" reads as a broken payload.
  // THE UNPLACEABLE ROWS RIDE INSIDE THE FRONTIER NUMBER AND ARE NAMED
  // THERE, term for term with landreq.filed_line. They are counted as work
  // owed (the safe direction) and they are NOT ordinary queued work — their
  // lane is gone and helm could not place the tip — so a count folded in
  // silently would be a backlog the owner can neither act on nor see.
  const unc = fnum("unclassified");
  const lead = fnum("open_frontier") !== null
    ? fterm("open_frontier") + " open on the live frontier"
      + (unc !== null && unc > 0
         ? " (incl. " + unc + " unclassified — lane gone, tip not placeable,"
           + " counted as work owed)" : "")
    : fterm("open") + " open";
  const filedLine = f && typeof f.total === "number"
    ? "filed " + f.total + " all-time · " + lead + " · "
      + fterm("held") + " held · " + fterm("underived") + " underived · "
      + fterm("landed") + " landed · "
      + fterm("closed") + " closed · " + fterm("non_loop") + " non-loop"
      + offTerm
    : "filed total UNKNOWN — the server sent no filed split";
  // PROJECT SCOPE — the withheld disclosure (task/974). Rows owned by OTHER
  // projects leave this board's lists and counts, and THIS line is where the
  // owner learns they exist, how many, whose, and the escape that shows
  // them. Mirrors landreq.withheld_line term for term (filed_line's law: one
  // record, two surfaces, no disagreement). Absent is SAID — an older server
  // sent no reading — never rendered as "0 withheld"; a scope the server
  // could not resolve renders as UNRESOLVED + wide, never a confident
  // narrower board.
  const w = (d.withheld && typeof d.withheld === "object") ? d.withheld : null;
  const wAll = !!d.all_projects;
  let scopeLine;
  if (!w) {
    scopeLine = "project scope UNKNOWN — this body carries no withheld "
      + "reading (an older helm web built it)";
  } else if (!w.scope_repo) {
    scopeLine = "project scope UNRESOLVED ("
      + (w.scope_why || "no repository identity")
      + ") — showing EVERY project's rows";
  } else {
    const who = w.scope
      || "repository " + w.scope_repo + " (registered to no project)";
    const n = typeof w.foreign === "number" ? w.foreign : 0;
    const m = typeof w.unresolved === "number" ? w.unresolved : 0;
    const verb = wAll ? "shown labeled" : "withheld";
    const by = n && w.by_project && typeof w.by_project === "object"
      ? " (" + Object.keys(w.by_project).sort()
          .map(k => k + " " + w.by_project[k]).join(", ") + ")" : "";
    // UNRESOLVED rows are SHOWN, marked — absence of provenance is not
    // foreignness — so that term is a census of marks, not of removals.
    scopeLine = "project scope: " + who + (wAll ? " — ALL PROJECTS" : "")
      + " · " + (n ? n + " row" + (n === 1 ? "" : "s")
        + " from other projects " + verb + by
        : "0 rows from other projects")
      + (m ? " · " + m + " row" + (m === 1 ? "" : "s")
        + " of UNRESOLVED project shown, marked" : "")
      + (n && !wAll
        ? " · helm lr list --all-projects (or /api/lr?all_projects=1) shows them"
        : "");
  }
  // THE COUNT IS THE SERVER'S TOTAL, NEVER THE LENGTH OF THE CAPPED LIST: the
  // phone shows a footer, not a history, so 13 closed lanes used to render as
  // the number 12. A cap may hide rows; it may not edit the number, and what it
  // dropped is said out loud.
  const total = typeof d.closed_total === "number" ? d.closed_total : null;
  const dropped = total === null ? 0 : Math.max(0, total - closed.length);
  const unknownWhen = typeof d.closed_unknown_when === "number" ? d.closed_unknown_when : 0;
  const closedHead = total === null
    ? "closed in the last 24h: showing " + closed.length + ", TOTAL UNKNOWN (the server sent no count)"
    : "closed in the last 24h: " + total
      + (dropped ? " — showing the newest " + closed.length + ", " + dropped
        + " not shown (<code>helm lr list --all</code>)" : "");
  // The honored partition joins the CLOSED accounting — a closed-type count
  // beside the 24h number, never an in-flight term — and its rows sit behind
  // the same tap as the retired ones, so the ONE closed surface is where a
  // discharged row is found from either view.
  const closedHonored = honored ? " · " + honored
    + " honored (verified superseded/confirmation — closed, not in flight)" : "";
  // Rows the record cannot place in or out of the window at all. Counted, never
  // dropped: dropping them is what let this footer say "nothing closed in the
  // last 24h" over a lane that had merged minutes earlier.
  const unknownFoot = unknownWhen
    ? '<div class="lrfoot">' + unknownWhen + " further row" + (unknownWhen === 1 ? " is" : "s are")
      + " CLOSED at an UNKNOWN time — the record carries no usable closure instant for "
      + (unknownWhen === 1 ? "it" : "them")
      // WHY, without naming one cause as THE cause: a git-observed landing has
      // no stamp anywhere, and a stamp that is not a timestamp or one dated in
      // the future is not a closure instant either. The old sentence asserted
      // the first over all three.
      + " (a landing git observed carries none anywhere; a stamp helm cannot read, "
      + "or one dated in the future, is not one either), so this card cannot say whether "
      + (unknownWhen === 1 ? "it" : "they") + " closed in the last 24h</div>"
    : "";
  // the 1-click view control: both choices visible, the active one lit. It
  // renders only on a BOARD — the pending/UNKNOWN strips have no rows to
  // re-arrange, and a control that does nothing is a lie about a control.
  const vtog = '<span class="lrvtog" title="how the in-flight rows are drawn '
    + '— the choice is remembered on this device">'
    + '<span class="lrvopt' + (view === "kanban" ? " on" : "")
    + '" data-lrview="kanban" role="button">⊞ board</span>'
    + '<span class="lrvopt' + (view === "list" ? " on" : "")
    + '" data-lrview="list" role="button">☰ list</span></span>';
  return '<div class="lrhead">' + label + '<span class="lrcounts" title="'
    + esc(countsWhy) + '">' + esc(counts)
    + "</span>" + vtog + how + "</div>"
    + '<div class="lrfiled" title="every dispatch row the ledger holds, all-time.'
    + " open on the live frontier = every non-terminal loop except held whose"
    + " work is still somewhere a person can take it: a lane-family ref, a"
    + " checked-out room, a live lease, or the tip held off trunk by a live"
    + " branch or room — ledger accounting, how much is on the books and still"
    + " reachable. OFF-FRONTIER is the rest of that same bucket, and only the"
    + " rows helm could PLACE: the lane is gone AND the work landed under a"
    + " later tip or was abandoned and reaped. PLACED IS NOT CLOSABLE: the"
    + " close ladder demands a proof of its own, and it refuses a placed row"
    + " whose witness it cannot take — so the term beside it counts what"
    + " `helm lr retire --off-frontier --apply` would close now, and the term"
    + " after that counts the placed rows it would refuse, one reason per row"
    + " in the census. A row helm could"
    + " not place counts as ON the frontier, never off it — unknown is work"
    + " owed — and the frontier term says how many of those there are. A"
    + " server older than the split sends no frontier terms and the strip then"
    + " reads `open = every non-terminal loop except held`, the whole bucket"
    + " under its old word, because a real number must never render as `?`."
    + " The header above counts IN FLIGHT, which is a"
    + " different question: only the carrying chain frontier, and it counts a"
    + " verified-superseded row (its verdict discharged through succession, or"
    + " a confirmation round) as CLOSED rather than as work, so it reads"
    + " lower. Both are true, and `helm lr list` prints these same two numbers"
    + " under these same two words · held ="
    + " a verdict the record cannot act on (undeclared polarity, or a declared"
    + " approval held by tier/gate policy) · underived = helm ASKED whether"
    + " this landed and could not finish before its derive budget ran out, so"
    + " the answer is unknown rather than no. Drawn OUT of open and held, not"
    + " added beside them: counting an unanswered row as either makes the"
    + " board report a backlog that is partly its own unfinished reading. The"
    + " proof ledger is positive-only, so these can only turn out to have"
    + " LANDED — the board over-reports and never under-reports, and reading"
    + " again shrinks it, though that shrinkage does not yet carry across a"
    + " land (task/2259) · landed = retired with the change on"
    + " trunk · closed = retired any other way · non-loop = cancelled transit /"
    + ' migration / ref-less legacy rows">' + esc(filedLine) + "</div>"
    + '<div class="lrfiled" title="which project this board answers for.'
    + " Rows owned by OTHER projects leave the lists and counts above by"
    + " default — this line is the disclosure: how many left, whose they"
    + ' are, and the escape that shows them">' + esc(scopeLine) + "</div>"
    + '<div class="lrfresh">' + esc(fresh) + "</div>"
    // ABOVE the in-flight rows, deliberately. Building is the EARLIER half of
    // the same pipeline, and the owner's complaint was that the card began at
    // the filing — so the card now begins where the work does.
    + lrBuildingHTML(bd)
    + (live.length
      ? (view === "list"
        // THE WALL BECAME A NEST (owner 2026-08-11). Same rows, same order,
        // same `lrRowHTML` cards — only rows whose LANE NAME or WORK CHAIN
        // relates them now sit inside one box instead of standing as separate
        // top-level entries. `groups` is the header's own reading, so the count
        // above and the boxes below cannot disagree.
        ? '<div class="lrrows">'
          + groups.map(g => lrGroupHTML(g, unmeas)).join("") + "</div>"
        : lrKanbanHTML(live, unmeas, honoredByCol))
      : honored
        ? (view === "list"
          ? '<div class="lrnone">nothing OPEN in flight — every remaining row '
            + "discharged its verdict (superseded through succession, or a "
            + "confirmation round) and is counted closed below.</div>"
          // the board still draws its card-less columns, so the doors to the
          // discharged rows stay where those rows used to be
          : lrKanbanHTML(live, unmeas, honoredByCol))
        : '<div class="lrnone">no land loops in flight — the dispatch ledger READ cleanly, '
          + "and it holds nothing open.</div>")
    // honored rows render WITHOUT the closed flag: the ledger has not retired
    // them, so "when did this close" is not their question — their own
    // SUPERSEDED-CLOSED / CONFIRMATION mark says what discharged them — and
    // each keeps its unmeasurable reason threading, byte-equal to the row the
    // board would have drawn.
    + (closed.length || honored
      ? '<button type="button" class="lrfoot" data-lrclosed="1">'
        + closedHead + closedHonored + " — tap to show</button>"
        + '<div class="lrrows" id="lrclosed" hidden>'
        + honoredRows.map(c => lrRowHTML(c, unmeas.get(c.id))).join("")
        + closed.map(c => lrRowHTML(c, null, true)).join("") + "</div>"
      : unknownWhen ? ""
        : '<div class="lrfoot">nothing closed in the last 24h</div>')
    + unknownFoot;
}

/* PURE: what the home tab's nav badge should say. UNKNOWN gets a "?" rather
   than a zero, so an unreadable pipeline reaches him from any other tab. */
function lrNav(d) {
  if (!d || d.pending)
    return {n: "?", title: "the land pipeline has not been read yet — this badge is "
      + "not a count of anything"};
  if (d.unavailable)
    return {n: "?", title: "the land pipeline could not be read — pipeline UNKNOWN"};
  if (!lrIsBoard(d))
    return {n: "?", title: "the land pipeline answered with a body this card cannot "
      + "read — pipeline UNKNOWN, and this badge is not a count of anything"};
  // the badge is the ALARM count, so an honored contrary (lrHonored — THE
  // display predicate) rings NEITHER alarm: not the contrary one, and not
  // the stalled one either, or the badge disagrees with the quiet row it
  // points at. Unverified/unstamped rows still ring, fail-closed.
  const rows = (Array.isArray(d.loops) ? d.loops : [])
    .filter(c => c && !lrHonored(c) && (c.contrary || c.stalled));
  return {n: rows.length, title: rows.length
    ? rows.length + " land loop" + (rows.length === 1 ? "" : "s")
      + " contradicting a verdict or stalled — see the land pipeline's kanban on the Work page" : ""};
}

function lrWire() {
  // the view toggle: store ONLY an explicit choice (kanban is the default
  // when the key is unset), then redraw from the answer already in hand —
  // a toggle must not cost a 45s poll, and must not fetch anything.
  $$("#lrsec .lrvopt").forEach(el => el.onclick = () => {
    const v = el.dataset.lrview === "list" ? "list" : "kanban";
    if (v === lrViewPref()) return;
    localStorage.setItem("helm.lrview", v);
    if (LR_LAST) lrShow(LR_LAST);
  });
  // ONE closed list, SEVERAL DOORS: the footer strip and every board-column
  // chip toggle the SAME #lrclosed box, so a discharged row is reachable from
  // wherever the owner is looking — the column it left, or the foot of the
  // card. A second closed list would be a second truth about what is closed;
  // this is the same one, opened from another place. Revealing it also brings
  // it into view: on a phone the board is a tall horizontal scroller and the
  // box opens below the fold, which reads as a tap that did nothing.
  $$("#lrsec [data-lrclosed]").forEach(el => el.onclick = () => {
    const box = $("#lrclosed");
    if (!box) return;
    box.hidden = !box.hidden;
    if (!box.hidden && box.scrollIntoView) box.scrollIntoView({block: "nearest"});
  });
  // EARLIER ROUNDS OF ONE CHAIN, folded under the round happening now. The
  // box is the button's NEXT SIBLING rather than an id target, because the
  // list, the board and the home glance can each draw the same chain in one
  // document and any id minted from the chain root would be duplicated —
  // every tap would then open whichever copy the DOM reached first.
  $$("#lrsec [data-lrmore]").forEach(el => el.onclick = () => {
    const box = el.nextElementSibling;
    if (!box) return;
    box.hidden = !box.hidden;
    el.setAttribute("aria-expanded", box.hidden ? "false" : "true");
  });
  $$("#lrsec .lrrow").forEach(el => el.addEventListener("click", async ev => {
    const sha = ev.target.closest && ev.target.closest(".lrsha");
    if (sha && sha.dataset.sha) {
      try { await navigator.clipboard.writeText(sha.dataset.sha); } catch (e) {}
      toast("copied " + sha.dataset.sha.slice(0, 12));
      return;
    }
    const x = el.querySelector(".lrx");
    if (x) x.hidden = !x.hidden;
  }));
}

/* ================= SYSTEM DASHBOARD (home, above the fold) =================
   One band, five rows, each owned by the poll that already carries its data —
   NO poll of its own. The lr-fed rows (pipeline / landed / owner / chain)
   render here off pollLr's answer; the fleet row renders off pollChat's
   presence array; the signing pulse stays pollDregg's. The pipeline WALL
   is the kanban higher up this same Work page — this band's pipeline row is
   the glance, and it carries the jump.

   THE PARTITION vs THE CARD'S COUNTS: the bar partitions LIVE work ONCE
   (contrary > stalled > unmeasurable > moving). A row whose verdict was
   honored through succession, or which is the confirmation instrument, is
   CLOSED rather than a fifth kind of in-flight work: it leaves both the
   headline and proportional bar and joins the closed accounting beside them.
   The card header below counts each LIVE fact (a contrary row that is also
   stalled is in both numbers there). Both are true; the titles say which
   question each answers, so the two "stalled" numbers cannot silently
   masquerade as the same measurement. */
let DASH_FLEET_TS = 0;
// The answers card rides the chat poll, so its own read can die silently
// while the card keeps showing the last thing it saw — the exact hazard
// DASH_FLEET_TS exists for on the row above. Stamped on every answer.
let DASH_ANSWERS_TS = 0;
// AND THE FAILURE IS STAMPED TOO, which is the half a success stamp cannot
// carry. A chat read that never answered ONCE leaves the success stamp at 0,
// and a card keyed only on that stamp treats "this page has never had an
// answer" and "the room holds nothing for you" as the same state — the reading
// is hidden either way, and the hidden card is the one that says the room is
// quiet. So the failing read says so, and it says so on the FIRST failure
// rather than after a bound that only elapses once a success has happened.
let DASH_CHAT_FAILED = 0;
// THE CHAT-FED CARDS EXPIRE ON THE CHAT CLOCK, NOT THE PIPELINE'S. These two
// cards are refreshed by the chat poll, whose interval is 2s, stretched to 10s
// while the SSE doorbell is live — so four missed beats is 8s or 40s. Bounding
// them at the 45s pipeline heartbeat instead meant a dead chat endpoint left an
// unread count standing for two minutes and called it current: the card's claim
// is "this is waiting for you RIGHT NOW", and two minutes is not now. The value
// is published where the stretch is decided (the SSE open/error handlers), so
// it is the cadence the poll is actually running at rather than a guess.
let DASH_CHAT_CADENCE_S = 2;

/* one land receipt as a comparable row: lane · commit · git's answer · age.
   THE TRI-STATE IS THE POINT: ✓ and ✗ are git's answers; UNKNOWN is git
   unable to answer, and today EVERY receipt reads UNKNOWN (the recorded
   commits were local merges git has since collected) — that word is the
   honest state of the record, never a blank. */
/* THE SIGNATURE IS A BADGE, NOT A GATE. A land reaches this card because it is
   ON TRUNK; whether anyone additionally minted a signed receipt for it is a
   separate, weaker fact about the RECORD. Wiring it the other way round is the
   defect this card was rebuilt to remove — the receipt log was the row source,
   so an unwitnessed land was an INVISIBLE land. Never again: this function may
   change what a row SAYS and may never decide whether a row EXISTS. */
/* HOME-CARD LAW, ONE IMPLEMENTATION. The owner's rule, verbatim: "if it is
   there it does not go stale, and anything on the homepage should be actually
   useful, otherwise why pipe it there". Two rules, and they are one helper each
   so a new card cannot quietly opt out of either:

     cardSource  every card says which command-line read it came from and how
                 old that read is. A number with no provenance is a number the
                 owner cannot check against `helm lr list`.
     cardStale   a read older than its own poll cadence renders NOTHING. Not a
                 dimmed value, not a last-known figure — a stale value on this
                 page is worse than an empty row, because the empty row sends
                 him to the command line and the stale one does not.

   The multiple is 4x the cadence rather than 1x on purpose: one missed beat is
   a slow read, four consecutive misses is a dead poll, and a card that blanks
   on every hiccup teaches him to ignore it.

   AND THE BOUND IS A FUNCTION BECAUSE A SECOND READER NEEDS THE SAME NUMBER.
   The read a card REFUSES as stale is also the read a poll should stop WAITING
   for: a request still in flight past its card's freshness bound can no longer
   produce a value that card would render, so the fetch deadline and the refusal
   are one number. Two spellings of `* 4` would let a poll wait past the age its
   own card refuses, which is the state a hung first read leaves behind. */
function cardBoundS(cadenceS) {
  return cadenceS * 4;
}

function cardStale(ageS, cadenceS) {
  return typeof ageS !== "number" || !isFinite(ageS)
    || ageS > cardBoundS(cadenceS);
}

/* TWO AGES WHEN THEY DIFFER. `ageS` is the READING's age — how long since the
   server last read or confirmed the inputs — and it is the one the freshness
   bound judges. `projS`, when the body carries it, is the PROJECTION's own age:
   a body the server confirmed unmoved fifteen seconds ago may have been built
   four minutes ago, and the owner gets both numbers rather than a card that
   comes off because the build clock alone was read as the reading. */
function cardSource(read, ageS, projS) {
  const proj = typeof projS === "number" && typeof ageS === "number"
    && projS > ageS + 5 ? " · projected " + esc(lrAgo(projS)) : "";
  return '<span class="dsub dcsrc">' + esc(read) + " · read "
    + esc(typeof ageS === "number" ? lrAgo(ageS) : "age unknown") + proj + "</span>";
}

function dashLandRow(r) {
  r = r || {};
  const ref = r.trunk_ref || "trunk (ref unknown)";
  /* THE ROW'S EXISTENCE IS A RECORDED LAND. It is here because the
     land-request ledger carries a `close --reason landed` for it, which is the
     event the integrator writes as the land happens and the same event
     `helm lr list` projects. So neither of the two verdicts below can mean "it
     might not have landed" — they say what PROOF the closing ladder recorded,
     which is a different and still useful fact. There were four while the rows
     came off a trunk walk; two of those answered about git's own view of the
     reviewed content and are unreachable from a close event. */
  const v = r.on_trunk === true
    ? {cls: "dok",
       txt: "✓ " + (r.how === "patch-equivalent" ? "landed (patch)" : "landed"),
       t: "the closing ladder proved the reviewed content onto " + ref
         + " by " + (r.how || "?") + " at close time, and that proof is why "
         + "this row is closed. HISTORICAL: it says the work got there, never "
         + "that the bytes are there now"}
    : {cls: "dunk", txt: "? proof not recorded",
       t: "the ledger closed this row as LANDED and recorded no proof mode "
         + "with it, so HOW it was proven onto " + ref + " cannot be read "
         + "back. The land itself is the record's own claim; only the proof "
         + "is missing"};
  /* THE AGE, AND WHY IT IS MISSING WHEN IT IS MISSING. Three states, not two:
     a readable closure instant gives an age; a closure the ledger recorded
     with a stamp that is NOT a timestamp says UNREADABLE, because that is a
     corrupt record to repair rather than a record that never had a stamp; and
     a closure with no instant anywhere says unknown. The stage-entry instant is
     never borrowed for any of them — a confident date over an unmeasured
     closure is the failure this row exists to avoid. */
  const age = typeof r.age_s === "number" ? lrAgo(r.age_s)
    : r.ts_unreadable ? "age UNREADABLE" : "age unknown";
  const ageWhy = typeof r.age_s === "number"
    ? "measured from the closure instant the ledger recorded"
    : r.ts_unreadable
      ? "the ledger's closure stamp for this row is not a timestamp, so this "
        + "land has no readable instant. The stage-entry instant is a "
        + "different event and is deliberately not substituted for it"
      : "the record carries no closure instant for this land";
  /* THE TASK NUMBER IS THE IDENTITY THE OWNER READS. Lane labels are agent
     jargon by his own account, so the task comes first when the record names
     one. It is never invented: a land whose close evidence named no task says
     so, because a blank there would read as a render that failed. */
  const task = r.task
    ? '<span class="dltask" title="the task this land served, read out of the '
      + 'close evidence the ledger already carries">task/' + esc(r.task) + "</span>"
    : '<span class="dltask dmut" title="the close evidence for this land names '
      + 'no task number — nothing is inferred from the lane label">no task</span>';
  const gate = r.gate
    ? '<span class="dlgate" title="the whole-suite gate receipt this land was '
      + 'verified by">gate:' + esc(String(r.gate).slice(0, 12)) + "</span>"
    : '<span class="dlgate dunk" title="no gate token is recorded on this '
      + 'row, so this land is UNVERIFIED as far as this card can read">gate ?</span>';
  return '<div class="dland"><span class="dllane" title="' + esc((r.lane || "(no lane)")
    + " — closed as landed "
    + (r.ts || (r.ts_unreadable ? "at a time the ledger recorded unreadably"
                                : "at an unknown time")) + " onto "
    + (r.trunk_sha || "—") + " on " + ref) + '">'
    + esc(r.lane || "(no lane)") + "</span>" + task + "<code>"
    + esc((r.reviewed_tip || "").slice(0, 8) || "—") + "</code>" + gate
    + '<span class="dlver ' + v.cls + '" title="' + esc(v.t) + '">' + v.txt
    + '</span><span class="dlage" title="' + esc(ageWhy) + '">'
    + esc(age) + "</span></div>";
}


function dashLandGroups(rows) {
  const by = new Map(), out = [];
  rows.forEach((r, i) => {
    const root = (r && typeof r.chain_root === "string" && r.chain_root) ? r.chain_root : null;
    const k = root ? "chain:" + root : "row:" + i;
    if (!by.has(k)) { const g = []; by.set(k, g); out.push(g); }
    by.get(k).push(r);
  });
  return out;
}

/* Which receipt speaks FOR the group. Preference order is evidentiary, not
   chronological: the round whose reviewed tip IS the trunk sha is literally
   the commit that landed; failing that, any round git can still prove; and
   only then the newest, which is a guess about recency dressed as an answer
   and is therefore last. */
function dashLandPrimary(g) {
  return g.find(r => r && r.reviewed_tip && r.reviewed_tip === r.trunk_sha)
      || g.find(r => r && r.on_trunk === true)
      || g.slice().sort((a, b) => (((b && b.ts) || "")).localeCompare(((a && a.ts) || "")))[0];
}

/* The answers a landed close can carry about its own proof, as a comparable
   token. Used ONLY to detect disagreement inside a group — never to render.

   TWO TOKENS NOW, NOT FOUR, and the two that went are not a simplification:
   they belonged to the trunk-walking reader. `absent` meant git had proven the
   reviewed content was never on trunk, and `corr` meant a receipt's stored
   patch-id was the only evidence. Neither is reachable from a ledger close —
   a `landed` close IS the record asserting the land, and this card may not
   contradict the record it renders — so a key for them would be a branch no
   input can enter, which is worse than absent: it reads as coverage.

   THE KEY IS THE OUTCOME AND NEVER THE METHOD. Folding `how` into it made two
   rounds that BOTH proved the reviewed content onto trunk — one by ancestry,
   one by patch-equivalence — compare unequal, so the group auto-opened under a
   summary claiming in words that its receipts do not agree about whether the
   content ever reached trunk. They agree exactly about that; they differ about
   which instrument answered it, which is not a disagreement and is already
   printed on each row. A key that can turn two affirmatives into THEY DISAGREE
   is a false alarm on the one part of this card whose alarm must be believed. */
function dashLandVerdictKey(r) {
  r = r || {};
  return r.on_trunk === true ? "ok" : "unk";
}

/* One LAND. Collapsing is a summary, and A SUMMARY THAT HIDES THE DECIDING
   FACT IS WORSE THAN THE FLAT LIST IT REPLACED — the failure this whole card
   exists to avoid. So when the rounds DISAGREE (one proven on trunk, another
   proven absent), the disagreement is promoted INTO the collapsed summary in
   words and the group opens by default. Agreement collapses quietly; conflict
   never does. */
function dashLandGroup(g) {
  const primary = dashLandPrimary(g);
  const rest = g.filter(r => r !== primary);
  if (!rest.length) return dashLandRow(primary);
  const split = new Set(g.map(dashLandVerdictKey)).size > 1;
  const n = rest.length;
  const label = n + " earlier round" + (n === 1 ? "" : "s")
    + (split ? " — THEY DISAGREE" : "");
  return '<div class="dlgroup' + (split ? " dlsplit" : "") + '">'
    + dashLandRow(primary)
    + "<details" + (split ? " open" : "") + '><summary title="'
    + esc(split
        ? "The receipts in this land do NOT agree about whether the reviewed "
          + "content ever REACHED trunk. That is a fact about the record, not a "
          + "rendering detail, "
          + "so this group opens itself and will not collapse the conflict away."
        : "Each round of this lane minted its own signed receipt. They agree, "
          + "so only the landing round is shown above; the rounds are the "
          + "reviewed history and are kept, not thinned.")
    + '">' + esc(label) + "</summary>"
    + rest.map(dashLandRow).join("") + "</details></div>";
}

function dashLands(rl, pending, ageS) {
  const el = $("#dlands");
  if (!el) return;
  if (pending) { el.innerHTML = '<span class="dmut">not read yet</span>'; return; }
  if (!rl || typeof rl !== "object" || !Array.isArray(rl.rows)) {
    // a pipeline body with no lands reading at all — the half-live deploy
    // (new page, old server). NOT SENT, never "no lands".
    el.innerHTML = '<span class="dunk">NOT SENT</span> <span class="dmut">— the server '
      + "answered without a landed reading (older <code>helm web</code>; restart it)</span>";
    return;
  }
  // THE HOME-CARD STALENESS RULE, AND IT IS THE FIRST THING THIS CARD DOES.
  // Its own read age decides whether it renders at all, so a dead 45s poll
  // leaves an EMPTY row rather than yesterday's lands looking like today's.
  // That is the owner's rule taken literally: a card that can go stale is a
  // card that comes off, and the only card allowed to stay is one that
  // removes itself when it cannot be current.
  if (cardStale(ageS, 45)) {
    el.innerHTML = '<span class="dunk">STALE — not rendered</span> <span class="dsub">'
      + "the pipeline read behind this card is "
      + esc(typeof ageS === "number" ? lrAgo(ageS) : "of unknown age")
      + ", past this card's own freshness bound. Its last values are "
      + "deliberately NOT shown; run <code>helm lr list</code></span>";
    return;
  }
  if (rl.unavailable) {
    el.innerHTML = '<span class="dunk">UNKNOWN</span> <span class="dmut">— '
      + esc(String(rl.unavailable)) + "</span>";
    return;
  }
  // THE PHRASE "no lands" MAY NOT APPEAR HERE. An empty answer off this
  // reader is a real measurement — the ledger holds no landed close — and it
  // is still not a licence to certify a quiet pipeline in words a skimming
  // reader takes as "nothing is happening".
  if (!rl.rows.length) {
    el.innerHTML = '<span class="dmut">the land-request ledger records no '
      + "closed-as-landed row for this project — check with <code>helm lr "
      + "list --all</code> before reading that as a quiet week</span>";
    return;
  }
  // WHEN NO ROW CARRIES A RECORDED PROOF, SAY SO ONCE IN WORDS. Six question
  // marks could be skimmed as decoration, and this is the card's most
  // important sentence on the day it is true: the ledger is closing rows as
  // landed without recording how any of them was proven, which is a repair to
  // make rather than a state to shrug at.
  //
  // IT IS COMPUTED OVER rl.rows — THE WHOLE ANSWER — NEVER OVER THE GROUP
  // PRIMARIES, which is the property its predecessor earned: grouping changes
  // what is SHOWN and must never change what is COUNTED.
  const allUnproven = rl.rows.every(r => !r || r.on_trunk !== true);
  el.innerHTML = '<div class="dlands">'
    + dashLandGroups(rl.rows).map(dashLandGroup).join("")
    // THE CAP DISCLOSES ITSELF OVER A MEASURED POPULATION. Under the old
    // trunk grammar no honest total existed, so the card could only say "more
    // exist". The ledger holds every landed close, so the number is real and
    // the cap is visibly a display budget rather than a silent edit.
    + (rl.rows_truncated
      ? '<div class="dsub" style="margin-top:2px">newest ' + rl.rows.length
        + " of "
        + (typeof rl.total === "number" ? rl.total + " recorded lands"
                                        : "a total this body did not send")
        + " — this card is a glance, the history is on <code>helm lr list "
        + "--all</code></div>"
      : "")
    // THE ORDER IS NEWEST FIRST AND IT IS A MEASUREMENT, so there is nothing
    // to disclaim here. Two lands closed inside one second have no answer from
    // their whole-second stamps, and the producer orders them by the ledger's
    // own append index for the close — the record answering, rather than the
    // list disclaiming a place it could not justify.
    + (allUnproven ? '<div class="dsub" style="margin-top:2px">every row above '
      + 'closed as LANDED with <span class="dunk">no proof mode recorded</span>'
      + " — the lands are the ledger's own claim, and how each was proven onto "
      + "trunk cannot be read back from the record. A real gap in the record, "
      + "said out loud.</div>" : "")
    + cardSource("helm lr list", ageS)
    + "</div>";
}


/* WHO OWES THE NEXT MOVE — the top row of Board (owner ruling, task/2355).
   From `d.loops`, the SAME projection `helm lr list` renders, and from the
   server-resolved holder pair rather than a browser re-derivation: `lrBall`'s
   own comment records what re-deriving it cost last time.

   IT IS A ROLL-UP, NOT A LIST OF ROWS. The owner's account of this page is
   that he reads the totals and never the row text, because row text is agent
   jargon — so this row answers his question ("who owes the next move") with
   names and counts, and the per-row detail stays one click away on the
   ledger. It REPLACED the in-flight row, which printed lane, state, holder and
   dwell per loop: the holder column was the only part of it he read, and the
   rest was the jargon. */
function dashOwedBy(d, pending, board) {
  const el = $("#downedby");
  if (!el) return;
  if (pending) { el.innerHTML = '<span class="dmut">not read yet</span>'; return; }
  const ageS = d && typeof d.read_age_s === "number" ? d.read_age_s : null;
  if (cardStale(ageS, 45)) {
    el.innerHTML = '<span class="dunk">STALE — not rendered</span> <span class="dsub">'
      + "the pipeline read behind this row is "
      + esc(typeof ageS === "number" ? lrAgo(ageS) : "of unknown age")
      + "; run <code>helm lr list</code></span>";
    return;
  }
  if (!board) {
    el.innerHTML = '<span class="dunk">UNKNOWN</span> <span class="dmut">— '
      + esc(String((d && d.unavailable) || "the answer was not a pipeline board"))
      + "</span>";
    return;
  }
  // ONE BUCKET PER HOLDER, counted over LIVE loops only: a verdict honored
  // through succession is closed, and nobody owes a move on it.
  const live = d.loops.filter(c => c && !lrHonored(c));
  const by = new Map();
  let nobody = 0, unknown = 0;
  live.forEach(c => {
    const ball = lrBall(c);
    // THE ROLE IS NOT A CLOSED VOCABULARY, AND IT IS NOT PLAIN LANGUAGE.
    // MEASURED on the live board: 11 of 29 live loops carry the holder role
    // "unknown (declared verdict held)" — a REVIEWED row whose polarity nobody
    // declared — and matching the bare word "unknown" put all eleven at the TOP
    // of this row under that sentence, as if it were a person's name. The owner's
    // account of this page is that row text is agent jargon he never reads, so
    // the first word decides the bucket and the jargon never reaches the chip.
    const role = String(ball.role || "unknown").split(" ")[0];
    if (role === "nobody") { nobody++; return; }
    if (role === "unknown") { unknown++; return; }
    // A KNOWN ROLE WITH NO SEAT IS STILL A REAL ANSWER — "the integrator owes
    // two" is actionable — so it buckets under the role WORD rather than under
    // lrBall's "(seat not recorded)" sentence, which is a note to an agent.
    const key = ball.seat || role;
    const seen = by.get(key) || {n: 0, oldest: -1, seat: ball.seat || role,
                                 text: ball.text};
    seen.n += 1;
    if (c.dwell_known && typeof c.dwell_s === "number" && c.dwell_s > seen.oldest) {
      seen.oldest = c.dwell_s;
    }
    by.set(key, seen);
  });
  const rows = Array.from(by.values()).sort((a, b) => b.n - a.n || b.oldest - a.oldest);
  if (!rows.length && !unknown) {
    el.innerHTML = '<span class="dmut">nobody owes a move — '
      + live.length + " live loop" + (live.length === 1 ? "" : "s")
      + ", every one of them closed or held</span>" + cardSource("helm lr list", ageS);
    return;
  }
  const CAP = 6;
  const shown = rows.slice(0, CAP);
  const extra = rows.length - shown.length;
  el.innerHTML = shown.map(r => '<span class="dowed" title="'
      + esc(r.text + " — " + r.n + " live land loop" + (r.n === 1 ? "" : "s")
            + " waiting on this holder"
            + (r.oldest >= 0 ? ", the longest waiting " + lrDwell(r.oldest) : ""))
      + '"><span class="dnum">' + r.n + "</span> " + esc(r.seat)
      + "</span>").join("")
    + (extra ? '<span class="dsub">+' + extra + " more holder"
        + (extra === 1 ? "" : "s") + "</span>" : "")
    + (unknown ? '<span class="dsub"><span class="dunk">' + unknown
        + " holder UNKNOWN</span> — the roster could not answer for "
        + (unknown === 1 ? "one row" : "those rows") + "</span>" : "")
    + (nobody ? '<span class="dsub">' + nobody + " owed by nobody</span>" : "")
    + cardSource("helm lr list", ageS);
}


/* ANSWERS FOR YOU — one small card (owner ruling, task/2364). Replies that
   ADDRESS HIM, in the words their author wrote, with their age.

   THE SOURCE IS THE ONE THE PUSH PATH READS. `_owner_signal` is the function
   that decides what @-mentions the owner, using seats.owner_names() and the
   same @-boundary rule `seats.deliverable` applies, and it is what already
   feeds `notifyOwner` — the browser notification. So this card and the
   notification cannot disagree about what reached him: they are two renderings
   of one read.

   IT IS NOT AN INBOX AND NOT A SECOND QUEUE. It holds nothing, acknowledges
   nothing and has no state of its own: the rows are whatever is past his chat
   cursor right now, and reading the room clears them by advancing that cursor.
   A card that kept its own list would be the second queue the ruling forbids,
   and it would go stale the moment the two disagreed. */
function dashAnswers(d) {
  const el = $("#danswers");
  if (!el) return;
  // STAMPED FIRST, ON EVERY BRANCH. The stamp is the age of the chat READ, and
  // this function runs only from an answered poll, so every sentence below —
  // including NOT SENT and the hidden-at-zero branch — is as old as this read
  // and expires with it. Stamping only the populated branch left the hidden
  // card unbounded, which is the state that reads as "nothing is waiting".
  DASH_ANSWERS_TS = Date.now();
  const rows = d && Array.isArray(d.owner_answers) ? d.owner_answers : null;
  if (rows === null) {
    // An older server, or a chat read that failed: say which, never "no
    // answers". This card's whole job is to be believed when it is empty.
    el.hidden = false;
    el.innerHTML = '<div class="dahead">answers for you</div>'
      + '<div class="dasub"><span class="dunk">NOT SENT</span> — this '
      + "<code>helm web</code> answered without the owner-addressed reading; "
      + "restart it, and read <code>helm chat read</code> meanwhile</div>";
    return;
  }
  if (!rows.length) {
    // HIDDEN AT ZERO, and that is the ruling rather than a style choice: an
    // empty card on this page is one more thing to look past, and chat states
    // emptiness properly. It is the same law the decision badge follows.
    el.hidden = true;
    el.innerHTML = "";
    return;
  }
  el.hidden = false;
  /* THE NUMBER IS THE WHOLE POPULATION, THE ROWS ARE THE NEWEST FOUR. The
     producer counts every addressed reply BEFORE it caps the preview list —
     `owner_mentions` is the true count and the slice is the last step, written
     that way so this card could say "4 of 9" honestly. Rendering `rows.length`
     as the headline threw that away: nine replies addressed him and the card
     said four, under a sentence claiming four replies were waiting. A count
     taken from a capped list is the capped list describing itself.
     THE TOTAL IS ONLY CLAIMED WHEN IT IS SENT AND IT COVERS THE ROWS. An older
     server without the count, or a count smaller than the rows in hand, leaves
     the card counting what it holds rather than asserting a population it
     cannot support. */
  const men = typeof d.owner_mentions === "number" && d.owner_mentions >= rows.length
    ? d.owner_mentions : null;
  const total = men === null ? rows.length : men;
  const omitted = total - rows.length;
  el.innerHTML = '<div class="dahead">answers for you <span class="dnum">'
    + total + "</span>"
    + (omitted ? '<span class="dasub"> newest ' + rows.length + " shown</span>"
               : "") + "</div>"
    + rows.map(r => {
      r = r || {};
      const age = typeof r.age_s === "number" ? lrAgo(r.age_s) : "age unknown";
      return '<div class="darow"><span class="dafrom">' + esc(r.from || "?")
        + '</span><span class="datext">' + esc(r.text || "")
        + '</span><span class="daage">' + esc(age) + "</span></div>";
    }).join("")
    + '<div class="dasub">' + esc(total === 1 ? "one reply" : total
      + " replies") + " addressed to you since you last read the room"
    + (omitted ? esc(" · the " + omitted + " older "
        + (omitted === 1 ? "one is" : "ones are") + " in the room, not here")
      : "")
    + ' · <span class="dslink" data-gochat>chat →</span></div>'
    // THE CARD NAMES ITS READ LIKE EVERY OTHER CARD ON THE BAND. This one is
    // fed by the chat poll and this function runs only from an answered poll,
    // so the age shown is that read's age at the instant it rendered, and
    // `dashAnswersClock` is what takes the card off once the read stops
    // arriving. A count with no provenance is a count he cannot check against
    // the command line, and this card's whole claim is "right now".
    + cardSource("helm chat read", 0);
  el.querySelectorAll("[data-gochat]").forEach(node => node.onclick = event => {
    event.stopPropagation(); showView("chat");
  });
}


/* THE CHAT CLOCK, FOR THE TWO CARDS THE CHAT POLL FEEDS. Answers (task/2364)
   and the fleet row are refreshed by /api/chat, so the pipeline heartbeat is
   the wrong bound for them and, worse, it is the wrong DETECTOR: it can only
   look every 45s. This runs on the chat poll's own interval and on the failing
   read itself, so a read that dies is visible inside four of its own beats and
   a read that never answered is visible immediately.

   THREE STATES, and they are three different sentences: a read that answered
   recently leaves the card alone; a read that answered and then went quiet is
   STALE and its last values come off; a read that has never answered on this
   page is NOT READ, and that one is reachable only because the failure is
   stamped — without it, a first-poll failure is a card that never rendered,
   which on a card hidden at zero is indistinguishable from a measured zero. */
function dashChatAgeS(stamp) {
  return stamp ? (Date.now() - stamp) / 1e3 : null;
}

function dashChatExpired(stamp) {
  const ageS = dashChatAgeS(stamp);
  if (ageS === null) return DASH_CHAT_FAILED ? "never" : null;
  return cardStale(ageS, DASH_CHAT_CADENCE_S) ? ageS : null;
}

function dashAnswersClock() {
  const el = $("#danswers");
  if (!el) return;
  const gone = dashChatExpired(DASH_ANSWERS_TS);
  if (gone === null) return;                    // fresh, or not yet polled once
  // NOT READ CARRIES AN AGE TOO. A first read that never answered still has a
  // measured instant — the moment the attempt failed — and without it the card
  // says only "not once since this page opened", which is the same sentence
  // whether the read died two seconds or two hours ago. That difference is the
  // owner's whole decision about whether to go and look.
  const tried = dashChatAgeS(DASH_CHAT_FAILED);
  el.hidden = false;
  el.innerHTML = '<div class="dahead">answers for you</div>'
    + '<div class="dasub"><span class="dunk">'
    + (gone === "never" ? "NOT READ" : "STALE") + " — not rendered</span> — "
    + (gone === "never"
       ? "the chat read behind this card has not answered once since this "
         + "page opened" + (tried === null ? ""
           : ", and its last attempt failed " + esc(lrAgo(tried)))
       : "the chat read behind this card last answered "
         + esc(lrAgo(gone)))
    + ", so what is waiting for you is UNKNOWN; run <code>helm chat "
    + "read</code></div>";
}

function dashFleetClock() {
  const el = $("#dfleet");
  if (!el) return;
  const gone = dashChatExpired(DASH_FLEET_TS);
  if (gone === null) return;
  const tried = dashChatAgeS(DASH_CHAT_FAILED);   // the failing attempt's own age
  // AND THE LAST SEAT LIST COMES OFF WITH IT. A seat list printed after the
  // word STALE is the shape the home-card law refuses: the reader takes the dots
  // for the fleet and the word for decoration. Who is on is UNKNOWN when
  // presence cannot be read, and UNKNOWN is not a list of names.
  el.innerHTML = '<span class="dunk">' + (gone === "never" ? "NOT READ" : "STALE")
    + "</span> " + '<span class="dsub">presence '
    + (gone === "never" ? "has not been read once since this page opened"
         + (tried === null ? "" : ", and its last attempt failed "
            + esc(lrAgo(tried)))
                        : "last read " + esc(lrAgo(gone)))
    + " — who is on is UNKNOWN, and the seats this row last saw are "
    + "deliberately not shown; run <code>helm fleet</code></span>";
}

function dashChain(nc, pending, ageS) {
  const el = $("#dchain");
  if (!el) return;
  if (pending) { el.innerHTML = '<span class="dmut">chain not read yet</span>'; return; }
  // THE HOME-CARD STALENESS RULE, ON THIS CARD TOO. The record count and the
  // verification verdict are values, and a value past its read's freshness
  // bound comes off rather than standing as current — the same law the lands
  // card and the owed-by row already apply, and the reason it is a helper.
  if (cardStale(ageS, 45)) {
    el.innerHTML = '<span class="dunk">STALE — not rendered</span> <span class="dsub">'
      + "the pipeline read behind this card is "
      + esc(typeof ageS === "number" ? lrAgo(ageS) : "of unknown age")
      + "; run <code>helm premise-check --chain</code></span>";
    return;
  }
  if (!nc || typeof nc !== "object")
    { el.innerHTML = '<span class="dunk">chain NOT SENT</span> <span class="dsub">(older server)</span>'; return; }
  if (nc.unavailable)
    { el.innerHTML = '<span class="dunk">chain UNKNOWN</span> <span class="dsub">' + esc(String(nc.unavailable)) + "</span>"; return; }
  if (!nc.count)
    { el.innerHTML = '<span class="dmut">local chain empty — no records yet on this machine</span>'; return; }
  el.innerHTML = (nc.verified
    ? '<span class="dok" title="premise.verify_chain() re-hashed every record this read — a cryptographic check, not a stored flag">chain ✓</span> '
      + '<span class="dnum">' + (nc.count | 0) + '</span> <span class="dsub">records verified · head #'
      + esc(String(nc.head_index ?? "?")) + "</span>"
    : '<span class="dbad" title="' + esc(String(nc.detail || "no detail sent"))
      + '">chain ✗ FAILS verification</span> <span class="dsub">head #'
      + esc(String(nc.head_index ?? "?")) + " · inspect the failure detail above</span>")
    + cardSource("helm premise-check --chain", ageS);
}

function dashOwner(d, pending, board) {
  const el = $("#downer");
  if (!el) return;
  if (pending) { el.innerHTML = '<span class="dmut">not read yet</span>'; return; }
  // THE HOME-CARD STALENESS RULE, ON THE OWNER STRIP TOO. An owner ask and an
  // LR hold on him are the most actionable values on this page, which is
  // exactly why an expired one may not stand as current: the reader acts on it.
  const ageS = d && typeof d.read_age_s === "number" ? d.read_age_s : null;
  if (cardStale(ageS, 45)) {
    el.innerHTML = '<span class="dunk">STALE — not rendered</span> <span class="dsub">'
      + "the pipeline read behind this strip is "
      + esc(typeof ageS === "number" ? lrAgo(ageS) : "of unknown age")
      + "; run <code>helm lr list</code></span>";
    return;
  }
  // EVERY BRANCH NAMES THE READ AND ITS AGE. The strip has eight
  // sentences and each is an answer about the owner queue, so the provenance
  // belongs on all eight rather than on the one that happens to carry a number.
  const src = cardSource("helm lr list", ageS);
  // Fleet-filed asks now ride the SAME /api/lr answer as the graph. The home
  // strip consumes that canonical model instead of claiming there is no Web
  // door, and never fetches the owner queue independently.
  const model = d.scheduler;
  if (!model || typeof model !== "object") {
    el.innerHTML = '<span class="dunk">owner asks UNKNOWN</span> <span class="dsub">— '
      + "the scheduler model was not sent</span>"
      + src;
    return;
  }
  const asks = Array.isArray(model.owner_asks) ? model.owner_asks : [];
  const dropped = typeof model.owner_asks_dropped === "number"
    ? model.owner_asks_dropped : 0;
  const askCount = typeof model.owner_ask_count === "number"
    ? model.owner_ask_count : null;
  if (asks.length) {
    const first = asks[0];
    const known = asks.length + dropped;
    const countLabel = askCount === null
      ? known + "+ KNOWN OWNER ASKS · QUEUE UNKNOWN"
      : askCount + " OWNER ASK" + (askCount === 1 ? "" : "S");
    el.innerHTML = '<span class="dwarn">' + countLabel
      + '</span> <span class="dsub">oldest: '
      + esc(first.age_known ? lrAgo(first.age_s) : "age unknown") + " · "
      + esc(first.plain_title || first.title || "owner input")
      + (dropped ? " · +" + dropped + " more not shown" : "")
      + ' · <span class="dslink" data-goscheduler>who waits on whom →</span></span>'
      + src;
    el.querySelectorAll("[data-goscheduler]").forEach(node => node.onclick = event => {
      event.stopPropagation(); showView("work"); goOldSection("scheduler");
    });
    return;
  }
  if (askCount > 0) {
    el.innerHTML = '<span class="dwarn">' + askCount + " OWNER ASK"
      + (askCount === 1 ? "" : "S") + '</span> <span class="dsub">all '
      + dropped + ' details capped · <span class="dslink" data-goscheduler>who waits on whom →</span></span>'
      + src;
    el.querySelectorAll("[data-goscheduler]").forEach(node => node.onclick = event => {
      event.stopPropagation(); showView("work"); goOldSection("scheduler");
    });
    return;
  }
  if (model.owner_asks_unavailable) {
    el.innerHTML = '<span class="dunk">owner asks UNKNOWN</span> <span class="dsub">— '
      + esc(String(model.owner_asks_unavailable)) + "</span>"
      + src;
    return;
  }
  if (!Array.isArray(model.owner_holds)) {
    el.innerHTML = '<span class="dunk">owner LR holds UNKNOWN</span> <span class="dsub">— '
      + "the canonical holder projection was not sent</span>"
      + src;
    return;
  }
  const holds = model.owner_holds;
  if (holds.length) {
    const first = holds[0];
    const detail = first.detail ? " · " + first.detail : "";
    el.innerHTML = '<span class="dwarn">' + holds.length + " LR HOLD"
      + (holds.length === 1 ? "" : "S") + ' ON OWNER</span> <span class="dsub">oldest: '
      + esc(first.age_known ? lrAgo(first.age_s) : "age unknown") + " · "
      + esc(first.plain_title || first.title || "land request") + esc(detail)
      + ' · <span class="dslink" data-goscheduler>who waits on whom →</span></span>'
      + src;
    el.querySelectorAll("[data-goscheduler]").forEach(node => node.onclick = event => {
      event.stopPropagation(); showView("work"); goOldSection("scheduler");
    });
    return;
  }
  if (!board || model.unavailable) {
    el.innerHTML = '<span class="dunk">pipeline UNKNOWN</span> <span class="dmut">— '
      + "fleet-filed owner asks read cleanly, but LR holder truth cannot be read</span>"
      + src;
    return;
  }
  el.innerHTML = '<span class="dmut">no fleet-filed owner asks or owner-held land requests</span>'
      + src;
}

function dashLr(d) {
  const pipe = $("#dpipe");
  if (!pipe) return;                        // page without the band (tests)
  const pending = !d || !!d.pending;
  const board = !pending && !d.unavailable && lrIsBoard(d);
  // THE IN-FLIGHT ROW IS GONE FROM THIS BAND (owner ruling, task/2355: cards
  // that repeat the ones he uses come off). It printed one line per loop —
  // lane, state, holder, dwell — and by his own account the row text is agent
  // jargon he never reads; the holder column was the part that answered a
  // question of his, and `dashOwedBy` answers it as names and counts. Its four
  // renderers went with it in the same commit rather than being left callerless
  // — see the note where they stood.
  dashOwedBy(d || {}, pending, board);
  // A body with NO recent_lands/native_chain and a named unavailable is a
  // read that FAILED (pollLr's synthetic body, or the handler's own) — those
  // cells inherit that reason. Only a body that otherwise answered and still
  // lacks the field earns "NOT SENT — older server": the harness caught the
  // first version blaming a network error on a server version.
  const inherit = f => !pending && d && d[f] === undefined && d.unavailable
    ? {rows: [], unavailable: String(d.unavailable)} : (!pending && d ? d[f] : null);
  dashChain(inherit("native_chain"), pending,
            d && typeof d.read_age_s === "number" ? d.read_age_s : null);
  // THE CARD'S OWN READ AGE IS AN ARGUMENT, not something it digs out of the
  // body: `read_age_s` is resolved at RESPONSE time for exactly this reason
  // (the body can be up to _LR_FLOOR_S old), and passing it makes the
  // staleness rule visible at the call site rather than hidden in the card.
  dashLands(inherit("recent_lands"), pending,
            d && typeof d.read_age_s === "number" ? d.read_age_s : null);
  dashOwner(d || {}, pending, board);
  // EVERY branch below ends with the jump to the wall — the detail surface
  // moved to the ledger tab, and a glance row that cannot reach its detail
  // is a dead end on a phone. The link is navigation, not data, so it is
  // present even when the row itself says UNKNOWN.
  const go = ' <span class="dslink" data-goledger>full pipeline: the kanban →</span>';
  if (pending) {
    pipe.innerHTML = '<span class="dmut">not read yet</span>' + go;
  } else if (cardStale(d && typeof d.read_age_s === "number" ? d.read_age_s : null, 45)) {
    // THE SIX TOTALS OBEY THE SAME LAW AS EVERY OTHER CARD (owner ruling,
    // task/2355). These are the numbers he pastes, which is the strongest
    // reason they may not be allowed to stand past their read: a number he
    // pastes is a number he acts on, and a headline of 29 in flight taken from
    // a dead poll is worse than an empty row, because the empty row sends him
    // to the command line. The bar goes with them — a proportional bar over
    // expired counts is the same claim drawn instead of written.
    pipe.innerHTML = '<span class="dunk">STALE — not rendered</span> <span class="dsub">'
      + "the pipeline read behind these totals is "
      + esc(d && typeof d.read_age_s === "number" ? lrAgo(d.read_age_s)
                                                  : "of unknown age")
      + ", past this band's own freshness bound. The counts are deliberately "
      + "NOT shown; run <code>helm lr list</code></span>" + go;
  } else if (!board) {
    pipe.innerHTML = '<span class="dunk">UNKNOWN</span> <span class="dmut">— '
      + esc(String((d && d.unavailable) || "the answer was not a pipeline board"))
      + "</span>" + go;
  } else {
    const bd = lrBuilding(d), bterm = lrBuildingTerm(bd);
    const loops = d.loops, stalledSet = new Set(d.stalled_ids);
    const unmeasSet = new Set(d.unmeasurable.map(u => u && u.id));
    const nonbillableIds = new Set();
    const live = loops.filter(c => c && !lrHonored(c));
    const hon = loops.filter(lrHonored).length;
    let mov = 0, stl = 0, ctr = 0, unm = 0;
    live.forEach(c => {
      if (c.contrary) ctr++;
      else if (c.stalled || stalledSet.has(c.id)) stl++;
      else if (unmeasSet.has(c.id)) { unm++; nonbillableIds.add(c.id); }
      else mov++;
    });
    const seg = (n, cls, t) => n ? '<i class="' + cls + '" style="flex-grow:' + n
      + '" title="' + esc(t) + '"></i>' : "";
    const n = (v, cls) => '<span class="' + (v ? cls : "dmut") + '"><span class="dnum">'
      + v + "</span>";
    pipe.innerHTML =
      '<span title="every LIVE land loop counted ONCE: contrary > stalled > unmeasurable > moving. A verdict honored through succession is CLOSED, not in flight, so it is excluded from this headline and bar and joins the closed accounting below. The pipeline card counts each live fact separately, so its stalled number can be higher.">'
      + '<span class="dnum">' + live.length + "</span> in flight</span>"
      // THE TERM THE OWNER'S OWN READING ASKED FOR, and this is the exact
      // headline he read as "0 in flight" while three builds were live. It is
      // the same sentence the pipeline card prints (lrBuildingTerm owns it),
      // beside the number it qualifies rather than three screens away — the
      // disclosure-distance lesson the pipeline card's header records. Silent
      // on an absent reading: an older server sends no key and this band then
      // says nothing about building, never zero.
      + (bterm ? '<span title="lane rooms holding a live claim with commits the '
        + 'trunk does not have and no land request filed yet, from `helm work '
        + 'list` — the work that exists BEFORE anything is filed, which is why '
        + 'this band could read 0 in flight over a busy fleet">'
        + (bd.state === "ok"
          ? '<span class="dnum">' + (bd.total === null ? "?" : bd.total)
            + "</span> building"
          : '<span class="dunk">building UNKNOWN</span>') + "</span>" : "")
      + '<span class="dbar" role="img" aria-label="live pipeline composition">'
      + seg(mov, "dmov", mov + " moving — inside their stage thresholds")
      + seg(stl, "dstl", stl + " stalled past a stage threshold")
      + seg(ctr, "dctr", ctr + " CONTRARY — trunk contradicts a verdict")
      + seg(unm, "dunm", unm + " nonbillable — authorization/advisory holds are not failed projection reads")
      + "</span>"
      + n(mov, "dmut") + " moving</span> " + n(stl, "dwarn") + " stalled</span> "
      + n(ctr, "dbad") + " contrary</span> "
      + n(unm, "dmut") + " nonbillable</span>"
      + '<span class="dsub">' + esc(lrNonbillableLabels(d, nonbillableIds).join(" · ")) + '</span>'
      + '<span class="dsub">' + (typeof d.closed_total === "number"
        ? d.closed_total + " closed 24h" : "closed-24h total UNKNOWN")
      + (hon ? " · " + hon + " honored closed" : "")
      + "</span>" + cardSource("helm lr list", d.read_age_s, d.projected_age_s) + go;
  }
  pipe.querySelectorAll("[data-goledger]").forEach(e => e.onclick = ev => {
    ev.stopPropagation();
    showView("work");
    $("#tierpipeline").scrollIntoView({block: "start"});
  });
  // THE TWO CHAT-FED CARDS ARE CHECKED HERE TOO, BUT THIS IS NO LONGER THEIR
  // CLOCK. They expire on the chat poll's own cadence and are checked on its
  // interval; the pipeline heartbeat is kept as a SECOND caller because a
  // browser that has thrown away the chat interval (a suspended tab resuming)
  // still reaches this one, and a card checked by two tickers cannot be left
  // standing by the loss of either.
  dashAnswersClock();
  dashFleetClock();
}

/* the fleet row — fed by chatPresence off every /api/chat poll, SAME
   vocabulary as the chat strip + roster tab (green active <2m · orange/red
   unverified · yellow quiet <15m · gone), reusing the roster's .rdot classes
   so the reader learns exactly one presence language. Ephemeral review-SAs
   and the owner's own cockpit row are not fleet. */
function dashFleet(list) {
  const el = $("#dfleet");
  if (!el || !Array.isArray(list)) return;  // older server: the honest boot text stays
  const seats = list.filter(s => s && s.seat && !s.ephemeral && !s.owner);
  const unv = [], act = [], qui = [];
  let gone = 0;
  seats.forEach(s => {
    if (s.unverified) unv.push(s);
    else if (s.presence === "fresh") act.push(s);
    else if (s.presence === "quiet") qui.push(s);
    else gone++;                            // absent (or a state this page predates)
  });
  /* THE VENDOR WALL, and it is ORTHOGONAL to the four presence buckets above
     rather than a fifth one: a walled seat can be fresh, quiet or absent, and
     forcing it into one of those is how a walled seat ended up counted as
     "gone" beside seats nobody had ever launched. This strip was fed an
     /api/chat presence payload that carried no vendor key AT ALL, so it could
     not say this even though the sibling roster endpoint already knew — the
     server now publishes `availability` on the same rows (seats_report
     .presence_report), from the one predicate every CLI surface reads.
     UNAVAILABLE ONLY. An availability of UNKNOWN means the persisted verdict
     could not be read, which is NOT this claim, and counting the two together
     would put a red number on the owner's home screen for a stopped watcher.
     AND THE COUNT ASSERTS NOTHING ABOUT PANES. It deliberately includes absent
     seats, because the wall holds their mail either way — so the hover may not
     call them alive, which is a second claim from a signal this filter never
     read, and it names the one thing that is true of every row in it: a
     relaunch is not the cure. */
  const walled = seats.filter(s => s.availability === "UNAVAILABLE");
  const dot = (s, cls, word) => '<span class="dseat" title="' + esc(s.seat + " — " + word
    + (s.line ? " · " + s.line : "")) + '"><span class="rdot ' + cls + '">●</span>'
    + esc(chatShort(s.seat)) + "</span>";
  const named = unv.map(s => dot(s, "unverified", "UNVERIFIED (shares a session id — its beat may be another process's)"))
    .concat(act.sort((a, b) => (b.last_seen || 0) - (a.last_seen || 0)).map(s => dot(s, "fresh", "active <2m")))
    .concat(qui.map(s => dot(s, "quiet", "quiet <15m")));
  const CAP = 9;
  // RENDERED STRAIGHT TO THE ROW, and kept nowhere. The staleness path
  // withholds the seat list rather than reprinting it, so a module variable
  // holding the last render would be a stored value with no reader — the same
  // dead surface as a callerless renderer.
  el.innerHTML = (named.length
    ? named.slice(0, CAP).join(" ")
      + (named.length > CAP ? ' <span class="dmut">+' + (named.length - CAP) + "</span>" : "")
    : '<span class="dmut">nobody on — the roster read cleanly and holds no live seat</span>')
    + ' <span class="dsub"><span class="dnum">' + act.length + "</span> active · "
    + (unv.length ? '<span class="dbad">' + unv.length + " unverified</span>" : "0 unverified")
    + " · " + qui.length + " quiet · " + gone + " gone"
    + (walled.length
      ? ' \u00b7 <span class="dbad" title="'
        + esc(walled.map(s => s.availability_text || s.seat).join(" \u00b7 ")
          + " \u2014 a wall is a FACT, not unreadiness: the family behind these"
          + " seats is not answering usably. The state names WHAT was observed,"
          + " never WHERE it originated, so no cause is asserted here. RELAUNCHING"
          + " DOES NOT CLEAR A WALL \u2014 the next green proxywatch pass (15m"
          + " timer) does, with no human step. This count says nothing either way"
          + " about whether each seat's pane is still up: presence is the four"
          + " buckets to the left, and a walled seat can be in any of them.")
        + '">' + walled.length + " UNAVAILABLE</span>"
      : "") + "</span>"
    // THE ROW NAMES ITS READ LIKE EVERY OTHER CARD. Presence rides the chat
    // poll, so the age shown is that read's age at the instant it rendered, and
    // `dashFleetClock` is what takes the row off once that read stops arriving.
    + cardSource("helm fleet", 0);
  DASH_FLEET_TS = Date.now();
}

function lrShow(d) {
  LR_LAST = d;
  $("#lrsec").innerHTML = lrCardHTML(d, lrViewPref());
  lrWire();
  // the dashboard band + the fold summary ride this SAME answer — one read,
  // two altitudes. typeof-guarded because the client-runtime tests extract
  // lrShow ALONE and run it under node, where the band does not exist; on
  // the real page the function is always defined.
  if (typeof dashLr === "function") dashLr(d);
  if (typeof schedulerShow === "function") schedulerShow(d);
  if (typeof onYouShow === "function") onYouShow({lr: d});
  const nav = lrNav(d);
  NAV_LR = nav.n;
  NAV_LR_TITLE = nav.title;
  renderNav();
}

async function pollLr() {
  /* CONSECUTIVE MISSED DEADLINES, so the card can tell BUSY from BROKEN.
     Reset by any answer, including an error the server actually sent: what
     this counts is whether anything is on the other end.

     IT HANGS OFF THE FUNCTION rather than standing as a module `let`, because
     the node probe that drives this path extracts FUNCTIONS by name and would
     not carry a neighbouring declaration -- a counter the tests cannot see is
     a branch the tests cannot reach. */
  let d;
  try {
    d = await j("/api/lr", LR_FETCH_MS);
    pollLr.misses = 0;
  } catch (e) {
    // A dead endpoint is UNKNOWN too — the card must not simply keep showing
    // the last good board as if it were current. A HUNG one is the same fact
    // arriving as silence, which is why the read carries a deadline: without
    // it this catch never runs and the card sits on a stale board, or on the
    // blank first paint, for as long as the socket stays open.
    /* A DEADLINE AND A REFUSAL ARE DIFFERENT FACTS AND THE OWNER ACTS ON
       THEM DIFFERENTLY. The projection costs 22-28s to rebuild (landreq.py
       says so in three places), so a read that runs out of time during a
       rebuild has learned that helm is BUSY — the record behind it is
       perfectly readable and merely uncomputed, which is the same thing the
       `warming` arm already says correctly on a cold start. Calling that an
       unreadable ledger is a false alarm, and it is the one the owner meets
       most often because it fires on every hard-TTL rebuild.

       ONCE IS BUSY, TWICE RUNNING IS BROKEN. A genuinely hung endpoint also
       misses its deadline, so the reassuring reading cannot be unconditional
       or a dead server would read as a busy one forever. The counter resets
       on any answer at all, so only a sustained silence escalates. */
    const deadline = e && /-> timed out after /.test(String(e.message || ""));
    pollLr.misses = deadline ? (pollLr.misses || 0) + 1 : 0;
    d = (deadline && pollLr.misses < 2)
      ? {rebuilding: "the read ran past " + Math.round(LR_FETCH_MS / 1000)
          + "s while helm was rebuilding this projection"}
      : {unavailable: "/api/lr did not answer (" + ((e && e.message) || "network error")
          + ") — this card is not reading the record right now"};
  }
  lrShow(d);
}
// FIRST PAINT, BEFORE ANY ANSWER. The section used to be an empty <section>
// with the nav badge at 0 until a response arrived, so a hung endpoint left the
// owner reading a blank card and a zero — which is exactly how "nothing
// outstanding" looks. NOT-READ-YET is drawn synchronously instead.
// ALWAYS-ON, every tab (the chat-poll law): the badge has to reach him while
// he is reading chat, which is exactly where the unbacked prose arrives. 45s
// against a 30s server-side recompute floor, so this is a cheap read.

