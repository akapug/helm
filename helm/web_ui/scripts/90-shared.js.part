/* ---------- the signing read behind Home's signing-record tile ----------
   Reuses /api/ledger (the history page's own read) on its OWN slow timer
   (8s — a pulse, not a poll storm). It keeps the answer, stamped, in
   DREGG_LAST; the tile says one word from it (signing live, or not) and
   takes it off once the stamp is past its bound, so an errored poll keeps
   the last read without ever letting it stand as current. The row text the
   old strip drew — the last turn, its author, its age — is the history
   page's own signing pulse. */
let DREGG_POLLING = false, DREGG_TIMER = null, DREGG_RUN = 0;
function stopDreggPolling() {
  if (DREGG_TIMER !== null) clearInterval(DREGG_TIMER);
  DREGG_TIMER = null;
  DREGG_RUN++;
  DREGG_POLLING = false;
}
function startDreggPolling() {
  if (DREGG_TIMER !== null) return;
  DREGG_TIMER = setInterval(pollDregg, 8000);
  pollDregg();
}
async function pollDregg() {
  if (document.hidden) return;
  if (DREGG_POLLING) return;
  const run = DREGG_RUN;
  DREGG_POLLING = true;
  try {
    let d;
    try { d = await j("/api/ledger", 6000); } catch (e) { return; } // keep the last read; its age takes the tile off
    if (run !== DREGG_RUN) return;
    DREGG_LAST = {d: d, at: Date.now()};
    homeRender();
  } finally { if (run === DREGG_RUN) DREGG_POLLING = false; }
}

/* ================= rail resize ================= */
/* (owner 2026-08-01: "the sidebars need to be adjustable width") every
   .raildrag handle drags the rail beside it. The width lands in a --railw
   CSS variable, so the stylesheet keeps owning layout — the mobile media
   queries still win, because they set the property itself, not the variable.
   Persisted per rail; double-click returns the stylesheet default. */
function railClamp(px, vw) {   // pure: min a readable rail, max half the viewport
  return Math.max(180, Math.min(Math.round((vw || innerWidth) / 2), px | 0));
}
function railWire(handle, host, rail, key) {
  const h = $(handle), el = $(host), rl = $(rail);
  if (!h || !el || !rl) return;
  const saved = parseInt(localStorage.getItem(key) || "", 10);
  if (saved > 0) el.style.setProperty("--railw", railClamp(saved) + "px");
  h.ondblclick = () => { localStorage.removeItem(key); el.style.removeProperty("--railw"); };
  h.addEventListener("pointerdown", dn => {
    dn.preventDefault();
    h.setPointerCapture(dn.pointerId);
    h.classList.add("live");
    const x0 = dn.clientX, w0 = rl.getBoundingClientRect().width;
    let w = w0;
    const mv = ev => { w = railClamp(w0 + ev.clientX - x0); el.style.setProperty("--railw", w + "px"); };
    const up = () => {
      h.classList.remove("live");
      h.removeEventListener("pointermove", mv);
      h.removeEventListener("pointerup", up);
      h.removeEventListener("pointercancel", up);
      localStorage.setItem(key, String(w));
    };
    h.addEventListener("pointermove", mv);
    h.addEventListener("pointerup", up);
    h.addEventListener("pointercancel", up);
  });
}
railWire("#chatraildrag", "#chatrooms", "#chatrooms", "helm.rail.chat");
railWire("#cfgraildrag", "#cfgsplit", "#cfgtree", "helm.rail.cfg");

/* ================= boot ================= */
{
  const r = hashView(location.hash.slice(1)), v = r.v;
  if (VIEWS.includes(v)) { viewRoute(v, r.query); showView(v); }
  else if (v === "homes") {
    showView("quota");
    $("#homescard").open = true;
    setTimeout(() => $("#homescard").scrollIntoView({block: "start"}), 400);
  } else {
    // "/" IS HOME (task/3445): a bare address, or one no view answers to,
    // opens the one-screen dashboard, never the page read last
    showView("home");
  }
  const o = new URLSearchParams(location.search).get("open");
  if (o) { showView("sessions"); openSession(o); }
  // UNCONDITIONALLY, because the boot above routes only when a hash or a saved
  // view names one: a first visit renders the markup's own selected area and
  // calls showView never, so anything sticking below the navigation would open
  // its first page against the CSS fallback rather than the measured height.
  publishNavHeight();
  startDreggPolling();
  esConnect();   // the doorbell: push wakes the cursor reads
}
</script>
