/* ================= sessions view (ported from the predecessor UI, behavior-preserving) =================
   Renames vs the predecessor (collision-avoidance with the helm view, behavior identical):
   #q -> #sq, #count -> #sesscount, render() -> renderSessions(); mutations carry
   the per-process bearer TOKEN via post() (the predecessor's apiFetch, hardened). */
let DATA = [], CONTENT = null, SYN_ON = false, TEAM = [];
const state = {q: "", h: new Set(["claude", "codex"]), view: "recent", recent: true};
const cut = new Date(Date.now() - 45 * 864e5).toISOString().slice(0, 10);
const fam = h => h === "claude" ? "anthropic" : "codex";
const pickAccount = h => SEL[fam(h)] || (CREDS.length ? null : "(default)"); // no provider ⇒ default account
const fmtB = z => z > 1e9 ? (z / 1e9).toFixed(1) + "G" : z > 1e6 ? (z / 1e6).toFixed(1) + "M" : z > 1e3 ? (z / 1e3).toFixed(0) + "K" : z + "B";
const badgeH = h => "h-" + (KNOWN_H.includes(h) ? h : "other");
function hl(s, q) {
  s = esc(s);
  if (!q) return s;
  const terms = q.trim().split(/\s+/).filter(w => w.length > 1).map(w => w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
  if (!terms.length) return s;
  try { return s.replace(new RegExp("(" + terms.join("|") + ")", "ig"), "<mark>$1</mark>"); } catch (e) { return s; }
}

let SINIT = false, CATP = null;
function ensureCatalog() { if (!CATP) CATP = loadCatalog(false); return CATP; }
function initSessions() {
  if (SINIT) return;
  SINIT = true;
  if (!CREDS.length) loadCreds();  // resume-as picker needs the roster; quota tab may never have opened
  else renderResumeAs();
  ensureCatalog();
}

async function loadCatalog(refresh) {
  if (refresh) toast("rescanning changed transcripts…", 6000);
  let d = null;
  try { d = await j("/api/catalog" + (refresh ? "?refresh=1" : "")); } catch (e) {}
  if (!d || !Array.isArray(d.rows)) {
    DATA = [];
    $("#list").innerHTML = '<div class="empty">catalog unavailable — no local sessions found (or the scan failed)</div>';
    return;
  }
  DATA = d.rows;
  // scope autocomplete: real project dirs (basename, most-sessions first) + registry project names
  const proj = scopeRank();
  for (const p of projects) if (p.name && !(p.name in proj)) proj[p.name] = 0;
  $("#scopelist").innerHTML = Object.entries(proj).sort((a, b) => b[1] - a[1]).slice(0, 60)
    .map(([b, n]) => `<option value="${esc(b)}">${n ? n + " sessions" : "registry project"}</option>`).join("");
  const gb = DATA.reduce((s, r) => s + r.z, 0) / 1e9, cl = DATA.filter(r => r.h === "claude").length;
  const work = DATA.filter(r => !r.syn).length, refs = DATA.length - work;
  NAV_SESS = statCell(work, "sessions", refs ? `+${refs.toLocaleString()} reference transcripts (hidden from resume search)` : "")
    + statCell(cl + "·" + (DATA.length - cl), "cl·cx", "claude · codex sessions")
    + statCell(gb.toFixed(1), "GB");
  renderNav();
  renderSessions();
  if (HIST.length) renderChart();
}

function filtered() {
  const q = state.q.toLowerCase();
  return DATA.filter(r => state.h.has(r.h) && (!state.recent || r.u >= cut) && (!q || (r.t + " " + r.c + " " + r.i + " " + r.b + " " + r.u).toLowerCase().includes(q)));
}
const cmp = {recent: (a, b) => (b.mt || 0) - (a.mt || 0), biggest: (a, b) => b.z - a.z, oldest: (a, b) => (a.cr || "9999").localeCompare(b.cr || "9999"), project: (a, b) => (b.mt || 0) - (a.mt || 0)};
function rowHTML(r) {
  const q = state.q;
  const flags = (r.cwdOverride ? ' <span class="flagchip" title="cwd was re-homed">⌂ moved</span>' : "")
    + (r.xl ? ' <span class="flagchip" title="OVERSIZED single/few-message session — content likely exceeds the context limit; plain resume will fail">xl</span>' : "")
    + (r.syn ? ' <span class="flagchip" title="reference transcript (daily-memory summarizer) — a read/training artifact, not a work session">syn</span>' : "");
  return `<div class="row" data-i="${r.i}"><span class="hbadge ${badgeH(r.h)}">${r.h === "codex" ? "cx" : "cl"}</span>
  <div class="title">${hl(r.t, q)}${r.b ? `<span style="font-size:.76rem;color:var(--mut);font-family:ui-monospace,monospace"> ⑂ ${esc(r.b)}</span>` : ""}
    <div class="l2">${r.i.slice(0, 8)} · ${hl(r.c, q)}${flags}</div></div>
  <div class="rmeta">${r.m ? r.m.toLocaleString() + " msg · " : ""}${fmtB(r.z)}<br>${r.u}</div>
  <div class="act"><button data-a="resume" data-i="${r.i}" title="hover to preview the command · click to copy">⧉ resume</button><button data-a="team" title="add to team tray">+ team</button></div></div>`;
}
// {project basename: session count} over the viewer's REAL sessions — one
// computation, two readers: the scope box's autocomplete list and the hint's
// worked example below. Reference transcripts are skipped, and that skip is
// the load-bearing part: the hint fires exactly when reference transcripts
// have drowned the results, so an example drawn from them would name the
// population the hint is telling the reader to escape.
function scopeRank() {
  const proj = {};
  for (const r of (DATA || [])) {
    if (r.syn) continue;
    const c = r.cwd || r.c;
    if (!c || c === "/tmp" || c === "(unknown)") continue;
    const base = String(c).replace(/\/+$/, "").split("/").pop();
    if (base) proj[base] = (proj[base] || 0) + 1;
  }
  return proj;
}
// The hint's example project comes from THE VIEWER'S OWN SESSIONS, never a
// literal. Two reasons, either alone enough: a hardcoded example names a
// project this operator may not have (a worse hint than none), and a literal
// is site-specific content living in shipped code — the same law the
// registry's authored layer exists to serve. Returns "" when nothing
// qualifies: both sentences read correctly without the parenthetical, and an
// invented example is worse than an absent one.
function scopeEg() {
  const proj = scopeRank();
  const top = Object.keys(proj).sort((a, b) => proj[b] - proj[a] || a.localeCompare(b))[0];
  return top ? ` (e.g. “${esc(top)}”)` : "";
}
function contentGroup() {
  if (!CONTENT || CONTENT.q !== state.q.trim() || !CONTENT.q) return null;
  const d = document.createElement("div");
  d.className = "grp"; d.open = true;
  const n = CONTENT.hits.length, capped = n >= (CONTENT.limit || 40);
  const scoped = (CONTENT.source || "").startsWith("scoped");
  const more = !scoped && capped && (CONTENT.limit || 40) < 400 ? ` <button class="chip" style="padding:2px 10px;font-size:.76rem" onclick="runContent(${(CONTENT.limit || 40) * 4})">show more</button>` : "";
  const hid = CONTENT.hidden ? ` · <span class="flagchip">${CONTENT.hidden} reference transcript${CONTENT.hidden > 1 ? "s" : ""} hidden</span> (training data — “refs” toggle to include)` : "";
  const drowned = !scoped && n <= 1 && CONTENT.hidden >= 50 ? `<br><span class="flagchip">⚠ the real sessions are buried under reference transcripts — type a project into the <b>scope</b> box${scopeEg()} to grep real sessions directly</span>` : "";
  const where = scoped ? ` in <b>${esc(CONTENT.scope)}</b>` : "";
  d.innerHTML = `<div class="deephdr"><b>${scoped ? n : (capped ? "top " + n : n)}</b> ${scoped ? "real session" : "work"} match${n === 1 ? "" : "es"}${where}${capped && !scoped ? " (more exist)" : ""} for “${esc(CONTENT.q)}” — click a snippet to read it${hid}${more}${drowned}</div><div class="rows"></div>`;
  d.querySelector(".rows").innerHTML = CONTENT.hits.map(h => {
    const sid = h.sid || h.cvid || h.id8;
    const r = h.sid ? DATA.find(x => x.i === h.sid) : null;
    const snip = `<div class="snip" data-open="${esc(sid)}" data-find="${esc(CONTENT.q)}" title="read the transcript, centered on this match">…${hl(h.snippet, CONTENT.q)}…</div>`;
    if (r) return rowHTML(r) + snip;
    return `<div class="row" data-ro="${esc(sid)}"><span class="hbadge ${badgeH(h.harness)}">${esc(h.harness.slice(0, 2))}</span>
      <div class="title">${esc(h.title.slice(0, 90))}<div class="l2">${esc(h.id8)} · ${esc(h.harness)} · read-only (no local resume verb)</div></div>
      <div class="rmeta">${esc(h.date)}</div><div class="act"><button data-read="${esc(sid)}" data-harness="${esc(h.harness)}" data-find="${esc(CONTENT.q)}">read</button></div></div>${snip}`;
  }).join("") || '<div class="empty">no content matches</div>';
  return d;
}
let _searchTick = null;
async function runContent(limit = 40) {
  const q = state.q.trim();
  if (!q) { CONTENT = null; renderSessions(); return; }
  const scope = $("#scope").value.trim();
  const started = performance.now(); const myq = q;
  // live scanning banner so a slow unscoped scan never looks frozen
  clearInterval(_searchTick);
  const paint = () => {
    if (state.q.trim() !== myq) { clearInterval(_searchTick); return; }
    const s = ((performance.now() - started) / 1000).toFixed(0);
    $("#list").innerHTML = `<div class="empty">${scope ? `searching <b>${esc(scope)}</b>'s real sessions…`
      : `scanning every transcript for “${esc(q)}” — this is the slow path (~10-40s); a project <b>scope</b> makes it instant`} · ${s}s`
      + `<div style="margin-top:8px;width:180px;height:3px;background:var(--code);border-radius:2px;overflow:hidden;display:inline-block"><div style="height:100%;width:40%;background:var(--accent);animation:sweep 1.1s ease-in-out infinite"></div></div></div>`;
  };
  paint(); _searchTick = setInterval(paint, 1000);
  const u = `/api/search?q=${encodeURIComponent(q)}&limit=${limit}`
    + (scope ? `&scope=${encodeURIComponent(scope)}` : "") + (SYN_ON ? "&synthetic=1" : "");
  let res;
  try { res = await j(u); }
  catch (e) { clearInterval(_searchTick); toast("✗ search failed: " + e); renderSessions(); return; }
  clearInterval(_searchTick);
  if (state.q.trim() !== myq) return;  // user moved on
  if (res.error) { toast("✗ " + res.error); renderSessions(); return; }
  CONTENT = {q, hits: res.hits || [], limit, hidden: res.synthetic_hidden || 0, source: res.source || "", scope};
  renderSessions();
}
function renderSessions() {
  const rows = filtered().sort(cmp[state.view] || cmp.recent);
  $("#sesscount").textContent = rows.length.toLocaleString() + " / " + DATA.length.toLocaleString();
  const host = $("#list");
  host.innerHTML = "";
  const cg = contentGroup();
  if (cg) host.appendChild(cg);
  if (!rows.length) {
    if (!cg) {
      const scoped = $("#scope").value.trim();
      host.innerHTML = `<div class="empty">no title/cwd match for “${esc(state.q.trim())}”.<br>`
        + (scoped ? `searching inside <b>${esc(scoped)}</b>'s real sessions…`
          : `<b>Fastest:</b> type a project in the <b>scope</b> box${scopeEg()} → instant search of its real sessions.<br><b>Or</b> press <b>Enter</b> to scan every transcript (~10-30s; mostly reference summarizers).`)
        + `</div>`;
    }
    return;
  }
  if (state.view === "project") {
    const g = {};
    for (const r of rows) (g[r.c] = g[r.c] || []).push(r);
    const trans = c => (c.startsWith("/tmp") || c === "(unknown)") ? 1 : 0;
    const cwds = Object.keys(g).sort((a, b) => trans(a) - trans(b) || g[b].length - g[a].length || a.localeCompare(b));
    const openAll = rows.length < 60 || !!state.q, CAP = 300;
    for (const c of cwds) {
      const items = g[c], d = document.createElement("details");
      d.className = "grp";
      d.innerHTML = `<summary><span class="cwd">${hl(c, state.q)}</span><span class="gmeta">${items.length} · ${fmtB(items.reduce((s, r) => s + r.z, 0))}</span></summary><div class="rows"></div>`;
      const body = d.querySelector(".rows");
      const fill = () => { if (body._f) return; body._f = 1; body.innerHTML = items.slice(0, CAP).map(rowHTML).join("") + (items.length > CAP ? `<div class="empty">first ${CAP} of ${items.length} — search to narrow</div>` : ""); };
      d.addEventListener("toggle", () => { if (d.open) fill(); });
      if (openAll) { d.open = true; fill(); }
      host.appendChild(d);
    }
  } else {
    const CAP = 250, d = document.createElement("div");
    d.className = "grp";
    d.innerHTML = `<div class="rows" style="border-top:none"></div>`;
    d.querySelector(".rows").innerHTML = rows.slice(0, CAP).map(rowHTML).join("")
      + (rows.length > CAP ? `<div class="empty">first ${CAP} of ${rows.length.toLocaleString()} — search to narrow</div>` : "");
    host.appendChild(d);
  }
}

/* ---------- resume-as strip (shows the quota tab's SEL pick; click cycles) ---------- */
function renderResumeAs() {
  const el = $("#resumeAs");
  if (!el) return;
  if (!CREDS.length) { el.innerHTML = `resume as: <b>this machine's default account</b> <span style="color:var(--mut)">(no quota provider)</span>`; return; }
  const mk = p => {
    const a = SEL[p];
    return `<span class="rachip" data-p="${p}" title="click to cycle the ${p === "anthropic" ? "claude" : "codex"} resume account">${p === "anthropic" ? "claude" : "codex"} → <b style="color:${a ? acol(a) : "var(--mut)"}">${a ? esc(short(a, 24)) : "—"}</b></span>`;
  };
  el.innerHTML = `resume as: ${mk("anthropic")} ${mk("codex")} <span style="color:var(--mut)">· full picker on the quota tab</span>`;
  $$(".rachip").forEach(ch => ch.onclick = () => {
    const p = ch.dataset.p, list = CREDS.filter(c => c.provider === p && c.state === "ok");
    if (!list.length) return;
    const i = list.findIndex(c => c.name === SEL[p]);
    SEL[p] = list[(i + 1) % list.length].name;
    renderAccts(); renderResumeAs(); renderTray();
  });
}

/* ---------- command popover (hover to preview, click to copy) ---------- */
const CMDCACHE = {};
let popTimer = null, popFor = null;
async function fetchCmd(r, account) {
  const m = r.h === "claude" ? $("#model").value : "";
  const key = r.i + "|" + account + "|" + m;
  if (CMDCACHE[key]) return CMDCACHE[key];
  const res = await j(`/api/cmd?account=${encodeURIComponent(account)}&sid=${encodeURIComponent(r.i)}${m ? `&model=${m}` : ""}`).catch(e => ({error: String(e)}));
  if (!res.error) CMDCACHE[key] = res;
  return res;
}
function hidePop() { const p = $("#cmdpop"); p.style.display = "none"; p._cmd = null; popFor = null; }
async function showPop(btn, r) {
  const account = pickAccount(r.h);
  if (!account) return;
  popFor = btn;
  const pop = $("#cmdpop");
  const rect = btn.getBoundingClientRect();
  pop.style.display = "block"; pop.classList.remove("copied");
  pop.style.left = Math.max(8, Math.min(rect.left - 300, innerWidth - 740)) + "px";
  pop.style.top = (rect.bottom + 8) + "px";
  pop._cmd = null; // never copyable until THIS request succeeds
  pop.innerHTML = `<div style="opacity:.6">fetching command…</div>`;
  const res = await fetchCmd(r, account);
  if (popFor !== btn) return;
  if (res.error) { pop._cmd = null; pop.innerHTML = `✗ ${esc(res.error)}`; return; }
  let warn = "";
  if (res.preflight && res.preflight.live_holder_pid) warn = `<div class="hintline">⚠ already LIVE in pid ${res.preflight.live_holder_pid} — one-live-process</div>`;
  if (res.warnings && res.warnings.length) warn += `<div class="hintline">⚠ ${esc(res.warnings.join("; "))}</div>`;
  pop.innerHTML = `${esc(res.cmd)}${warn}<div class="hintline">click to copy</div>`;
  pop._cmd = res.cmd;
}
$("#cmdpop").onclick = async () => {
  const pop = $("#cmdpop");
  if (!pop._cmd) return;
  await navigator.clipboard.writeText(pop._cmd);
  pop.classList.add("copied");
  toast("copied ✓");
  setTimeout(hidePop, 450);
};
document.addEventListener("mouseover", e => {
  const btn = e.target.closest('button[data-a="resume"]');
  clearTimeout(popTimer);
  if (btn) {
    const r = DATA.find(x => x.i === btn.dataset.i);
    if (r) popTimer = setTimeout(() => showPop(btn, r), 260);
  } else if (!e.target.closest("#cmdpop")) {
    popTimer = setTimeout(hidePop, 300);
  }
});

/* ---------- clicks (rows / snippets / resume / team) ---------- */
function resumeNote(res) {
  const ws = (res.warnings || []).slice();
  if (res.preflight && res.preflight.live_holder_pid) ws.unshift(`LIVE in pid ${res.preflight.live_holder_pid} — one-live-process`);
  const big = ws.find(w => w.startsWith("OVERSIZED") || w.startsWith("REFERENCE"));
  return {note: ws.length ? "  ⚠ " + ws.join(" · ") : "", big, ms: big ? 9000 : (ws.length ? 5000 : 3500)};
}
document.addEventListener("click", async e => {
  const snip = e.target.closest(".snip[data-open]");
  if (snip) { openSession(snip.dataset.open, {find: snip.dataset.find}); return; }
  const rd = e.target.closest("button[data-read]");
  if (rd) { openSession(rd.dataset.read, {find: rd.dataset.find, harness: rd.dataset.harness}); return; }
  const b = e.target.closest("button[data-a]");
  if (!b) {
    const rowEl = e.target.closest(".row[data-i]");
    if (rowEl && !e.target.closest("button")) openSession(rowEl.dataset.i, {find: state.q.trim() || undefined});
    return;
  }
  const rowEl = b.closest(".row");
  if (!rowEl) return;
  const r = DATA.find(x => x.i === rowEl.dataset.i);
  if (!r) return;
  const account = pickAccount(r.h);
  if (!account) { toast("no " + fam(r.h) + " account selected — pick one on the quota tab"); return; }
  if (b.dataset.a === "team") { TEAM.push({r, account}); trayCount(); renderTray(); toast(`seat ${TEAM.length} added — open the tray (top right) when your team is composed`); return; }
  const res = await fetchCmd(r, account);
  if (res.error) { toast("✗ " + res.error); return; }
  await navigator.clipboard.writeText(res.cmd);
  const rn = resumeNote(res);
  toast((rn.big ? "⚠ " + rn.big + "  ·  copied anyway for inspection" : "copied ➜ " + res.cmd) + (rn.big ? "" : rn.note), rn.ms);
});

/* ---------- transcript drawer ---------- */
const DRAW = {sid: null, start: 0, resumable: true, gen: 0};
function itemHTML(it, q) {
  if (it.k === "text") return `<div class="txt">${hl(it.t, q)}</div>`;
  if (it.k === "think") return `<details><summary>thinking (${it.t.length.toLocaleString()} chars)</summary><div class="txt">${hl(it.t, q)}</div></details>`;
  if (it.k === "tool") return `<div class="toolline">⚙ ${esc(it.name)} ${esc(it.t)}</div>`;
  if (it.k === "result") return `<div class="res${it.err ? " err" : ""}">${hl(it.t, q)}</div>`;
  return "";
}
function msgHTML(m, q, hit) {
  const t = m.ts ? new Date(m.ts).toLocaleString([], {month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit"}) : "";
  return `<div class="dmsg r-${esc(m.role)}${hit ? " hit" : ""}"><div class="role">${esc(m.role)}<span class="dtime">${t}</span></div>${m.items.map(i => itemHTML(i, q)).join("")}</div>`;
}
async function openSession(sid, opts = {}) {
  if (!DATA.length) { try { await ensureCatalog(); } catch (e) {} } // burn chips can open before the tab ever showed
  const r = DATA.find(x => x.i === sid || x.i.startsWith(sid));
  const mysid = r ? r.i : sid, gen = ++DRAW.gen; // a late response must never dress a newer drawer
  DRAW.sid = mysid;
  $("#drawer").classList.add("show");
  $("#dbody").innerHTML = '<div class="empty">loading transcript…</div>';
  $("#dhead").innerHTML = "";
  const q = opts.find || state.q.trim();
  const url = `/api/session?sid=${encodeURIComponent(mysid)}&limit=60${opts.find ? `&find=${encodeURIComponent(opts.find)}` : ""}${opts.harness ? `&harness=${encodeURIComponent(opts.harness)}` : ""}`;
  let d;
  try { d = await j(url); } catch (e) { d = {error: String(e)}; }
  if (DRAW.gen !== gen) return;
  if (d.unavailable) d = {error: "transcript reader unavailable (is cv installed?)"};
  if (d.error) {
    const friendly = d.error.includes("ambiguous session id")
      ? `this hit's short id is ambiguous (${esc(mysid)} matches many sessions of that day). The installed cv can't emit full ids for content hits yet — upstream PR #13 fixes this; helm upgrades itself the moment it lands.`
      : esc(d.error);
    $("#dbody").innerHTML = `<div class="empty">✗ ${friendly}</div>`;
    return;
  }
  const S = d.session || {};
  DRAW.start = d.start; DRAW.resumable = S.resumable !== false && !!r;
  const acts = [DRAW.resumable ? `<button id="dresume" title="copy the resume command for the selected account">⧉ resume</button><button id="dteam">+ team</button>` : `<span class="rst" style="padding:6px">read-only</span>`,
    DRAW.resumable ? `<button id="dcwd" title="re-home this session: change the directory its resume opens in">⌂ cwd</button>` : "",
    DRAW.resumable && r && r.h === "claude" ? `<button id="doptimize" title="create a resume-optimized copy: same session, cleaner context, cheaper resume — the original is never touched">⚗ optimize</button>` : "",
    `<button id="dclose">✕</button>`].join("");
  $("#dhead").innerHTML = `<div class="acts">${acts}</div>
    <span class="hbadge ${badgeH(S.harness || "claude")}" style="display:inline-block">${esc((S.harness || "?").slice(0, 2))}</span> <span class="t">${esc((S.title || "(untitled)").slice(0, 90))}</span>
    <div class="meta">${esc(mysid)} · ${esc(S.cwd || "?")}${S.branch ? " · ⑂ " + esc(S.branch) : ""}${S.model ? " · " + esc(S.model) : ""} · ${d.total.toLocaleString()} messages${r ? " · " + fmtB(r.z) : ""}</div>
    <div id="cwdedit"><input id="cwdinput" placeholder="new absolute directory for this session, e.g. ~/dev/project" value="${esc(S.cwd || "")}"><button class="chip" id="cwdgo">move</button></div>`;
  $("#dclose").onclick = () => $("#drawer").classList.remove("show");
  if (DRAW.resumable) {
    $("#dresume").onclick = async () => {
      const acct = pickAccount(r.h);
      if (!acct) return toast("no account selected");
      const res = await fetchCmd(r, acct);
      if (res.error) return toast("✗ " + res.error);
      await navigator.clipboard.writeText(res.cmd);
      const rn = resumeNote(res);
      toast((rn.big ? "⚠ " + rn.big + "  ·  copied anyway for inspection" : "copied ➜ " + res.cmd) + (rn.big ? "" : rn.note), rn.ms);
    };
    $("#dteam").onclick = () => { TEAM.push({r, account: SEL[fam(r.h)]}); trayCount(); renderTray(); toast("added to team tray"); };
    $("#dcwd").onclick = () => $("#cwdedit").classList.toggle("show");
    if ($("#doptimize")) $("#doptimize").onclick = () => {
      let menu = $("#optmenu");
      if (menu) { menu.remove(); return; }
      menu = document.createElement("div");
      menu.id = "optmenu";
      menu.style.cssText = "margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;align-items:center";
      menu.innerHTML = `<span style="font-size:.78rem;color:var(--mut)">optimize preset:</span>
        <button class="chip" data-p="lean" title="stash bulky tool payloads to a retrievable sidecar + flatten thinking — lossless spine">lean</button>
        <button class="chip" data-p="window20k" title="keep only the newest ~20k real tokens">window 20k</button>
        <button class="chip" data-p="window" title="choose your own token budget">custom…</button>`;
      $("#dhead").appendChild(menu);
      menu.querySelectorAll("button").forEach(bt => bt.onclick = async () => {
        const preset = bt.dataset.p;
        let tokens = null;
        if (preset === "window") { tokens = parseInt(prompt("Keep the newest N real tokens (2,000 – 180,000):", "30000"), 10); if (!tokens) return; }
        const body = {sid: mysid, preset, tokens};
        const dry = await post("/api/prune", {...body, dry: true}).catch(e => ({error: String(e)}));
        if (dry.error) return toast("✗ " + dry.error);
        if (!confirm(`Optimize for resume?\n\n${dry.estimate.note}\n\nSource: ${(dry.estimate.beforeBytes / 1e6).toFixed(1)} MB, ${dry.estimate.beforeMsgs.toLocaleString()} lines.\nCreates a NEW session (the original is never touched). Runs:\n${dry.willRun}`)) return;
        menu.remove();
        toast("optimizing… (cv prune)", 8000);
        const res = await post("/api/prune", body).catch(e => ({error: String(e)}));
        if (res.error) return toast("✗ " + res.error);
        toast(`✓ optimized → ${res.newSid.slice(0, 8)} · ${(res.beforeBytes / 1e3).toFixed(0)}KB → ${(res.afterBytes / 1e3).toFixed(0)}KB — opening the new session`, 6000);
        await loadCatalog(true);
        openSession(res.newSid);
      });
    };
    $("#cwdgo").onclick = async () => {
      const cwd = $("#cwdinput").value.trim();
      if (!cwd) return;
      const res = await post("/api/cwd", {sid: mysid, cwd}).catch(e => ({error: String(e)}));
      if (res.error) return toast("✗ " + res.error);
      toast("✓ session re-homed to " + cwd + (res.note ? " — " + res.note : ""), 5000);
      Object.keys(CMDCACHE).forEach(k => { if (k.startsWith(mysid)) delete CMDCACHE[k]; });
      await loadCatalog(false);
      $("#cwdedit").classList.remove("show");
    };
  }
  const mi = d.match ? d.match.index : null;
  $("#dbody").innerHTML = (d.start > 0 ? `<button class="chip" id="dmore">↑ load earlier (${d.start.toLocaleString()} more)</button>` : "")
    + (d.note ? `<div class="empty" style="padding:8px">${esc(d.note)}</div>` : "")
    + d.messages.map((m, i) => msgHTML(m, q, i === mi)).join("") || '<div class="empty">(no renderable messages)</div>';
  if ($("#dmore")) $("#dmore").onclick = loadEarlier;
  const hitEl = $("#dbody .dmsg.hit");
  if (hitEl) hitEl.scrollIntoView({block: "center"});
  else $("#dbody").scrollTop = $("#dbody").scrollHeight;
}
async function loadEarlier() {
  const gen = DRAW.gen;
  let d;
  try { d = await j(`/api/session?sid=${encodeURIComponent(DRAW.sid)}&before=${DRAW.start}&limit=60`); } catch (e) { d = {error: String(e)}; }
  if (DRAW.gen !== gen) return; // drawer moved on while we were fetching
  if (d.error) return toast("✗ " + d.error);
  DRAW.start = d.start;
  const q = state.q.trim(), btn = $("#dmore"), body = $("#dbody"), oldH = body.scrollHeight;
  if (btn) btn.remove();
  body.insertAdjacentHTML("afterbegin", (d.start > 0 ? `<button class="chip" id="dmore">↑ load earlier (${d.start.toLocaleString()} more)</button>` : "")
    + d.messages.map(m => msgHTML(m, q)).join(""));
  if ($("#dmore")) $("#dmore").onclick = loadEarlier;
  body.scrollTop = body.scrollHeight - oldH;
}
document.addEventListener("keydown", e => { if (e.key === "Escape") { $("#drawer").classList.remove("show"); $("#tray").classList.remove("show"); hidePop(); } });

/* ---------- team tray ---------- */
function trayCount() { const b = $("#trayBtn"); b.innerHTML = "⊞" + (TEAM.length ? `<span class="n">${TEAM.length}</span>` : ""); b.classList.toggle("has", TEAM.length > 0); }
function renderTray() {
  const seats = $("#seats");
  if (!seats) return;
  seats.innerHTML = TEAM.map((s, i) => `<div class="seat" data-i="${i}"><button class="rm" data-i="${i}">✕</button><div class="t">${esc(s.r.t.slice(0, 60))}</div>
    <div class="m">${s.r.i.slice(0, 8)} · ${s.r.h} · ${esc(s.r.c)}</div>
    <select data-i="${i}">${CREDS.filter(c => c.provider === fam(s.r.h)).map(c => `<option ${c.name === s.account ? "selected" : ""}>${esc(c.name)}</option>`).join("") || '<option>(default)</option>'}</select>
    <button class="showcmd" data-i="${i}">${s.copied ? "✓ copied — show again" : "show command"}</button>
    <div class="cmdslot"></div></div>`).join("") || '<div class="empty">click “+ team” on sessions to compose a team</div>';
  seats.querySelectorAll(".rm").forEach(el => el.onclick = () => { TEAM.splice(+el.dataset.i, 1); trayCount(); renderTray(); });
  seats.querySelectorAll("select").forEach(el => el.onchange = () => { TEAM[+el.dataset.i].account = el.value; renderTray(); });
  seats.querySelectorAll(".showcmd").forEach(el => el.onclick = async () => {
    const i = +el.dataset.i, s = TEAM[i], seat = el.closest(".seat"), slot = seat.querySelector(".cmdslot");
    if (slot.innerHTML) { slot.innerHTML = ""; return; }
    slot.innerHTML = '<div class="cmdbox" style="opacity:.6">fetching…</div>';
    const res = await fetchCmd(s.r, s.account);
    if (res.error) { slot.innerHTML = `<div class="cmdbox">✗ ${esc(res.error)}</div>`; return; }
    slot.innerHTML = `<div class="cmdbox">${esc(res.cmd)}<div class="hintline">click to copy — collapses after</div></div>`;
    slot.querySelector(".cmdbox").onclick = async () => {
      await navigator.clipboard.writeText(res.cmd);
      s.copied = true;
      toast(`seat ${i + 1} copied ✓ — paste it, then come back for the next`);
      renderTray();
    };
  });
  const used = {}, dups = [];
  for (const s of TEAM) { if (used[s.account]) dups.push(s.account); used[s.account] = 1; }
  $("#dup").innerHTML = dups.length ? `<div class="dupwarn">⚠ ${[...new Set(dups)].join(", ")} used by 2+ seats — one seat per account-home (refresh-chain race)</div>` : "";
}
$("#trayBtn").onclick = () => $("#tray").classList.toggle("show");
$("#trayClose").onclick = () => $("#tray").classList.remove("show");
const PKEY = "helm.presets";
const loadPresets = () => JSON.parse(localStorage.getItem(PKEY) || "{}");
function renderPresets() {
  const ps = loadPresets(), host = $("#presets");
  host.innerHTML = Object.keys(ps).map(n => `<span class="chip" data-n="${esc(n)}" title="load this team (right-click to delete)">${esc(n)} (${ps[n].length})</span>`).join(" ") || "";
  host.querySelectorAll(".chip").forEach(el => {
    el.onclick = async () => {
      await ensureCatalog();
      const seats = loadPresets()[el.dataset.n] || [];
      TEAM = seats.map(s => ({r: DATA.find(r => r.i === s.sid), account: s.account})).filter(s => s.r);
      if (TEAM.length < seats.length) toast(`${seats.length - TEAM.length} session(s) from this preset no longer exist`);
      trayCount(); renderTray();
    };
    el.oncontextmenu = e => { e.preventDefault(); const ps2 = loadPresets(); delete ps2[el.dataset.n]; localStorage.setItem(PKEY, JSON.stringify(ps2)); renderPresets(); toast("preset deleted"); };
  });
}
$("#savePreset").onclick = () => {
  const n = $("#presetName").value.trim();
  if (!n || !TEAM.length) { toast(TEAM.length ? "name the preset first" : "tray is empty"); return; }
  const ps = loadPresets();
  ps[n] = TEAM.map(s => ({sid: s.r.i, account: s.account}));
  localStorage.setItem(PKEY, JSON.stringify(ps));
  renderPresets();
  toast(`saved team “${n}” (${TEAM.length} seats)`);
};

/* ---------- sessions controls ---------- */
let _autoTimer = null;
$("#sq").oninput = e => {
  state.q = e.target.value;
  const q = state.q.trim();
  // typing invalidates a stale content-search result for a different query
  if (CONTENT && CONTENT.q !== q) CONTENT = null;
  renderSessions();
  clearTimeout(_autoTimer);
  // auto-search only when SCOPED (a project grep is instant); the unscoped scan of
  // the whole corpus is slow, so it stays behind an explicit Enter.
  const scoped = $("#scope").value.trim();
  if (q.length >= 3 && scoped && !filtered().length && (!CONTENT || CONTENT.q !== q)) {
    _autoTimer = setTimeout(() => { if (state.q.trim() === q) runContent(); }, 500);
  }
};
$("#sq").addEventListener("keydown", e => { if (e.key === "Enter") runContent(); });
$("#scope").addEventListener("keydown", e => { if (e.key === "Enter") runContent(); });
$("#scope").addEventListener("input", () => { const q = state.q.trim(); if (q.length >= 3 && $("#scope").value.trim()) { clearTimeout(_autoTimer); _autoTimer = setTimeout(() => { if (state.q.trim() === q) runContent(); }, 500); } });
$("#synToggle").onclick = () => { SYN_ON = !SYN_ON; $("#synToggle").classList.toggle("on", SYN_ON); $("#synToggle").textContent = SYN_ON ? "refs: on" : "refs: off"; if (state.q.trim()) runContent(CONTENT && CONTENT.limit || 40); };
$("#viewmode").onchange = e => { state.view = e.target.value; localStorage.setItem("helm.viewmode", state.view); renderSessions(); };
$("#rec").onclick = e => { state.recent = !state.recent; e.target.classList.toggle("on", state.recent); e.target.textContent = state.recent ? "last 45 days" : "all time"; renderSessions(); };
$("#refresh").onclick = () => loadCatalog(true);
$$("#view-sessions .chip.h").forEach(ch => ch.onclick = () => {
  const h = ch.dataset.h;
  if (state.h.has(h) && state.h.size > 1) state.h.delete(h); else state.h.add(h);
  ch.classList.toggle("on", state.h.has(h));
  renderSessions();
});
{ const vm = localStorage.getItem("helm.viewmode"); if (vm) { state.view = vm; $("#viewmode").value = vm; } }
renderPresets(); trayCount();

