/* ================= THE WORK PAGE'S BOARD (task/2975) =================
   The owner's words: the separate parts — the cred burn flags, the project
   traffic lights, the task tracking and the scheduler — "compose into a single
   burn board", and then: "i think we are looking guide toward total max lanes
   and allocating projects to it while also showing project progress somehow,
   and things like private/public repo status". So the Work page opens on
   what is waiting on him (ON YOU), then one lanes line — "lanes: R running of
   M possible" — then one row per project.

   READ THE PROJECT FIRST. A project's light is AUTHORIZATION — whether he
   wants spending on it at all — and a family's burn colour is SUPPLY. So the
   light leads every row and the rows sort by it (green, yellow, orange, red,
   then the projects nobody has set). Supply itself is Fleet › credit's
   Families card. Setting a project green is choosing it active.

   THREE READS, ONE ROW. The rows are the registry's own project rows, each
   light the resolver's answer (`/api/registry`); `/api/board` joins onto
   each one what its seats spend, its running lanes, its week of progress,
   its repositories and its last land off its own trunk; and its work — to
   do, under way, landed — is the Work page's own count (`/api/work`,
   task/3643). Every section of that join carries its own read age, and a
   section past its bound is never drawn as current: a board that looked
   current while its reading had stopped is worse than one that says it does
   not know.

   PHONE FIRST. A collapsed row is the light, the name, the team and one
   count; everything else carries `bwide` and is a desktop cell. A tap on
   the row opens it — its team, its work, its progress and repos; a tap on
   the light opens it at the setter. */

/* ---------- ON YOU ----------
   What is waiting on him, from two reads: the decisions door and the land
   pipeline's owner asks and owner-held requests. PURE, so the tests run this
   exact source. It is QUIET only when both reads answered and both said
   nothing: a read that has not arrived, failed, or is past its bound is never
   drawn as "nothing waiting". */
function onYouRead(odq, lr) {
  const dec = odq === undefined ? null
    : !odq || odq.unavailable ? "unknown"
    : ((odq.counts || {}).open || 0) + ((odq.counts || {}).undelivered || 0);
  let asks = null, holds = null, askN = null, lrWhy = null, lrWord = "UNKNOWN";
  let lrOld = false;
  const lrRead = lr !== undefined && !(lr && lr.pending);
  if (lrRead) {
    const model = lr && lr.scheduler;
    if (!lr || lr.unavailable) lrWhy = (lr && lr.unavailable) || "the pipeline read failed";
    else if (lr.warming || lr.rebuilding) lrWhy = "the pipeline is still being read";
    else if (lrStale(lr)) {
      // the bound the server names for its own reading (`lrStale`,
      // task/3632), with the age beside the word on Work (information, not
      // an error); Home's strip says only "stale"
      lrOld = true;
      lrWord = typeof lr.read_age_s === "number" ? "STALE, " + lrDur(lr.read_age_s) + " old" : "UNKNOWN";
      lrWhy = typeof lr.read_age_s === "number" ? "" : "the pipeline read is of unknown age";
    }
    else if (!model || typeof model !== "object") lrWhy = "the scheduler model was not sent";
    else if (model.owner_asks_unavailable) lrWhy = String(model.owner_asks_unavailable);
    else if (!Array.isArray(model.owner_holds)) lrWhy = "the owner holds were not sent";
    else {
      asks = Array.isArray(model.owner_asks) ? model.owner_asks : [];
      holds = model.owner_holds;
      askN = typeof model.owner_ask_count === "number" ? model.owner_ask_count
        : asks.length + (model.owner_asks_dropped || 0);
    }
  }
  const quiet = dec === 0 && askN === 0 && holds !== null && !holds.length;
  const plural = (n, one, many) => n + " " + (n === 1 ? one : many);
  // TWO SPELLINGS OF ONE LINE: Work's On-you block gives the reason or the
  // age; HOME'S STRIP is a headline and says the tiles' one muted word,
  // "not read" or "stale" (task/3445)
  const word = w => '<span class="hstale">' + w + "</span>";
  let line, home;
  if (dec === null && !lrRead) { line = '<span class="bmut">not read yet</span>'; home = word("not read"); }
  else if (quiet) line = home = '<span class="bmut">nothing is waiting on you</span>';
  else {
    const parts = [], hparts = [];
    const both = (l, h) => { parts.push(l); hparts.push(h === undefined ? l : h); };
    if (dec === null) both('<span class="bmut">decisions not read yet</span>', "decisions " + word("not read"));
    else if (dec === "unknown") both('<span class="bunk">decisions UNKNOWN</span>', "decisions " + word("not read"));
    else if (dec) both("<b>⚖ " + plural(dec, "decision", "decisions") + "</b>");
    if (!lrRead) both('<span class="bmut">owner asks not read yet</span>', "owner asks " + word("not read"));
    else if (lrWhy || lrOld) both('<span class="bunk">owner asks ' + esc(lrWord) + "</span>"
      + (lrWhy ? ' <span class="bmut">— ' + esc(lrWhy) + "</span>" : ""),
      "owner asks " + word(lrOld ? "stale" : "not read"));
    else {
      if (askN) both("<b>" + plural(askN, "owner ask", "owner asks") + "</b>");
      if (holds.length) both("<b>" + plural(holds.length, "land request held for you", "land requests held for you") + "</b>");
    }
    line = parts.join(" · ");
    home = hparts.join(" · ");
  }
  const row = (r, what) => '<div class="yrow"><span class="yage">'
    + esc(r.age_known ? lrAgo(r.age_s) : "age unknown") + "</span> " + what + " <b>"
    + esc(r.plain_title || r.title || "?") + "</b>" + (r.detail ? ' <span class="bmut">' + esc(r.detail) + "</span>" : "") + "</div>";
  const rows = (asks || []).map(r => row(r, "ask")).concat((holds || []).map(r => row(r, "held")));
  return {line, home, quiet, queue: dec === "unknown" || (typeof dec === "number" && dec > 0),
          asks: rows.length ? rows.join("") + '<div class="yrow"><span class="dslink" data-goscheduler>who has what, on Work →</span></div>' : ""};
}

const ONYOU = {};                  // the last decisions read and pipeline read
function onYouShow(patch) {
  Object.assign(ONYOU, patch || {});
  const got = onYouRead(ONYOU.odq, ONYOU.lr);
  // HOME'S STRIP (task/3445): the same line, shown only while something
  // waits on him or cannot be read; its detail is the block below on Work
  const strip = $("#honyou"), hline = $("#honyouline");
  if (strip && hline) { hline.innerHTML = got.home; strip.hidden = got.quiet; }
  const line = $("#onyouline"), asks = $("#onyouasks"), queue = $("#odq");
  if (!line || !asks || !queue) return;
  line.innerHTML = got.line;
  asks.innerHTML = got.asks;
  asks.hidden = !got.asks;
  queue.hidden = !got.queue;
  $("#onyou").classList.toggle("quiet", got.quiet);
  asks.querySelectorAll("[data-goscheduler]").forEach(el => el.onclick = () => {
    WK.main.view = Object.assign(wkDefault(), WK_ENTRY.pipeline, {lens: "list", group: "move"});
    showView("pipeline");
  });
}

/* ---------- the burn flags (the Families card at the head of Fleet › credit) ----------
   READ-ONLY. The watchdog pass folds them; the board renders what it wrote and
   never probes. GREY renders as "not measured" and never as a colour: an
   unknown reading that looked green is the inversion the whole fold exists to
   prevent. */
const FLAGCOL = {RED: "#b4442e", ORANGE: "#c9772e", YELLOW: "#b58a2e", GREEN: "#3f7d54", GREY: "#8a8a8a"};
function flagWhen(at) {
  if (!at) return "unknown when";
  const s = at * 1e3 - Date.now();
  if (s <= 0) return "now";
  const h = s / 3600e3;
  if (h > 48) return "in " + Math.round(h / 24) + "d";
  if (h >= 1) return "in " + Math.round(h) + "h";
  return "in " + Math.round(s / 60e3) + "m";
}

/* THE FLAG CARD, from the board's flags section -> {head, rows}. PURE, so
   tests/test_web_board.py runs this exact source. A section it cannot vouch
   for draws no colour at all: unread, unmeasured and stale each say so.

   THE ROWS ARE A STRIP AND A SHEET (task/3156): one chip per family, its
   cause on hover and a tap selects it; under the strip, the selected family's
   sheet — what lasts, the shares across projects (`d` is the board, for the
   teams leg), the reset credits in hand and the declare control. */
function flagsHTML(sec, d) {
  if (!sec) return {head: '<span class="bmut">not read yet</span>', rows: ""};
  if (sec.loading) return {head: '<span class="bmut">still being read</span>', rows: ""};
  /* with no reading to draw there is no sheet, so the owner's declarations
     the watchdog has not folded yet are said in the head (task/4027) */
  const pend = sec.declared_pending || {};
  const said = Object.keys(pend).sort().map(f => ' · <b>' + esc(f + " " + famPending(pend[f])) + "</b>").join("");
  if (sec.unavailable)
    return {head: '<span class="bmut">not measured — ' + esc(sec.unavailable) + said + "</span>", rows: ""};
  if (sec.stale)
    return {head: '<span class="bunk">STALE</span> <span class="bmut">— the burn flags were read '
      + esc(lrAgo(sec.age_s)) + ", past their " + esc(lrDur(sec.limit_s) || "?")
      + " bound, so no colour is drawn until a fresh reading arrives" + said + "</span>", rows: ""};
  const ov = sec.overall || {}, fams = sec.families || {};
  const head = '<b style="color:' + (FLAGCOL[ov.colour] || FLAGCOL.GREY) + '">'
    + esc(ov.colour === "GREY" ? "NOT MEASURED" : ov.colour || "?") + "</b> · "
    + (ov.family ? "tightest " + esc(ov.family) + " · " : "")
    + esc(flagWhen(ov.until)) + " · read " + esc(lrAgo(sec.age_s));
  const keys = Object.keys(fams).sort();
  const sel = FAM_SEL in fams ? FAM_SEL : ov.family in fams ? ov.family : keys[0];
  const strip = '<div class="fstrip" role="list">' + keys.map(f => {
    const fl = fams[f] || {};
    return '<button type="button" role="listitem" class="fchip fpick' + (f === sel ? " on" : "")
      + '" data-fam-sel="' + esc(f) + '" style="--fc:' + (FLAGCOL[fl.colour] || FLAGCOL.GREY) + '" title="'
      + esc(f + " " + (fl.colour === "GREY" ? "not measured" : fl.colour || "?")
        + (fl.provenance === "owner-declared" ? " · DECLARED by the owner, not measured" : "")
        + (fl.declared_pending ? " · DECLARED " + fl.declared_pending.colour + " by the owner, pending the watchdog's fold" : "")
        + (fl.provenance === "derived" ? " · derived, not a direct reading" : "")
        + (fl.money_provenance === "certified-local" ? " · money CERTIFIED by the seat that runs the local hardware, not a vendor measurement" : "")
        + " · " + (fl.axis || "no axis") + " · changes " + flagWhen(fl.expires_at)
        + (fl.cause ? " — " + fl.cause : "")) + '"><i></i>' + esc(f) + "</button>";
  }).join("") + "</div>";
  return {head, rows: strip + famSheet(sel, fams[sel], d)};
}

/* ---------- the board ---------- */
const BOARD_POLL_MS = 60000;
/* THE SERVER ANSWERS INSIDE A FEW SECONDS, cold or warm: a leg it has not
   finished reading comes back as still being read (web_board._legs). This
   deadline is only the backstop for a server that is not answering at all. */
const BOARD_FETCH_MS = 45000;
/* A SECTION STILL BEING READ IS ASKED FOR AGAIN SOON: after 5s, then 10s,
   20s and 40s, and past that the minute's own read takes over. */
const BOARD_RETRY_MS = 5000;
let BOARD = null;                 // the last /api/board body; null = not read yet
let BOARD_AGAIN = null;           // the quick re-read waiting to run, if any
let BOARD_TRIES = 0;              // quick re-reads in a row
const BOARD_OPEN = new Set();     // registry keys of the rows he has open
let BOARD_FOLD = false;           // is the quiet-projects fold open
const LIGHT_RANK = {green: 0, yellow: 1, orange: 2, red: 3};

/* 0-3 for an authored colour, 4 for a project nobody has set. The scan's
   words (`active`, `dormant`) are observations, not decisions, so they all
   sort as unset however lively they read. */
function boardRank(p) {
  const lit = light(p);
  return lit.authored && lit.colour in LIGHT_RANK ? LIGHT_RANK[lit.colour] : 4;
}

/* green, yellow, orange, red, then unset; inside a colour, the most recently
   active first, then by name so equal rows never shuffle between polls. */
function boardSort(rows) {
  return rows.slice().sort((a, b) => boardRank(a) - boardRank(b)
    || (b.last_seen || 0) - (a.last_seen || 0)
    || String(a.name || "").localeCompare(String(b.name || "")));
}

/* One section of the board, or null before the first read. A board read that
   FAILED answers every section as unavailable, so no cell can mistake the
   failure for "not asked yet". */
function boardSec(d, name) {
  if (d && d.unavailable) return {unavailable: d.unavailable};
  return (d && d.sections && d.sections[name]) || null;
}

/* "loading" is a section STILL BEING READ: a leg the server has not finished
   within its budget (the first read after a restart), or every other
   project's pipeline, read in the background. It is neither unread nor
   unknown, and it never draws as a number. */
function boardSecState(sec) {
  return !sec ? "unread" : sec.unavailable ? "unknown" : sec.loading ? "loading"
    : sec.stale ? "stale" : "ok";
}

/* the one sentence for a section's state, for titles and detail lines */
function boardSecWord(sec) {
  const st = boardSecState(sec);
  if (st === "unread") return "not read yet";
  if (st === "unknown") return "UNKNOWN — " + sec.unavailable;
  if (st === "loading") return "still being read";
  // with no clock it is stale because nothing measured when it was read,
  // and no bound is claimed (review 3631, round 3)
  if (st === "stale")
    return typeof sec.age_s !== "number" ? "STALE — age unknown, no reading time was measured"
      : "STALE — read " + lrAgo(sec.age_s) + (sec.limit_s ? ", past its " + lrDur(sec.limit_s) + " bound" : "");
  return "read " + lrAgo(sec.age_s);
}

/* QUIET is the server's call (web_board._quiet: nothing seen for thirty
   days, nothing open, no light set in thirty days), made at response time, so
   a light he sets unfolds its row on the next read. The page folds a row the
   server called quiet only while the backlog that decision rests on is
   current: a count nobody could read, or one past its bound, is not zero. */
function boardQuiet(j, d) {
  return boardSecState(boardSec(d, "tasks")) === "ok" && !!(j && j.quiet === true);
}

/* WHICH ROWS LEAD AND WHICH FOLD, as data, so the arrangement is one pure
   function the tests run. `shown` is every row the filter admits, folded or
   not: folding hides a row from the eye and from no count. A filter shows
   every match, quiet ones included, so a folded project is always findable. */
function boardLayout(rows, d, q, retired, lit) {
  // a harness name finds the projects it has sessions in, as it always did
  const hit = p => !q || [p.name, p.path, ...Object.keys(p.sessions || {})].join(" ").toLowerCase().includes(q);
  // THE LIGHT FILTER (task/3445): one colour, or "unset" for nobody set it
  const hue = p => !lit || (light(p).authored ? light(p).colour : "unset") === lit;
  const shown = boardSort(rows.filter(p => (retired || !p.retired) && hit(p) && hue(p)));
  const quiet = p => boardQuiet(d && d.projects ? d.projects[pkey(p)] : undefined, d);
  const all = q || lit;
  return {shown, lead: all ? shown : shown.filter(p => !quiet(p)),
          quiet: all ? [] : shown.filter(quiet)};
}

/* THE CAPACITY LINE: two plain facts — "21 lanes running · 14 seats able to
   work" — then where the lanes are (helm 13 · gtp 2 · …), the green count,
   and one chip per model family in its credit colour. They are NOT a
   fraction: a seat running subagents holds several lanes at once, so lanes
   can outnumber seats, and "R of M" would read as nonsense when they do.
   Lanes are the live worktree claims across every project plus one for each
   usable seat at work with no claim; seats are the ones able to take work
   right now, one each. A tap opens Fleet's seats. Nothing is drawn over a
   number that was not read, and a roster past its bound reads STALE. */
function boardCapacity(d, active) {
  if (!d) return '<span class="bcap bmut">lanes: not read yet</span>';
  if (d.unavailable)
    return '<span class="bcap bunk">board UNKNOWN</span> <span class="bmut">— ' + esc(d.unavailable) + "</span>";
  const head = d.headline || {}, lanes = head.lanes || {};
  const seats = boardSec(d, "seats"), sst = boardSecState(seats);
  const read = sst === "ok" && typeof lanes.running === "number" && typeof lanes.possible === "number";
  const able = n => "<b>" + n + " seat" + (n === 1 ? "" : "s") + " able to work</b>";
  const lanesTxt = sst === "stale"
    ? '<span class="bunk">lanes: STALE</span> <span class="bmut">(the roster was read ' + esc(lrAgo(seats.age_s)) + ")</span>"
    // THE ROSTER READ AND THE REGISTRY DID NOT: the seats are known, but a
    // seat at work cannot be placed on a project, so R is not drawn — and
    // the sentence blames the registry, which is what failed
    : sst === "ok" && typeof lanes.running !== "number" && typeof lanes.possible === "number"
      ? '<span class="bunk">lanes UNKNOWN</span> <span class="bmut">(the project registry could not be'
        + " read, so a seat at work cannot be placed)</span> · " + able(lanes.possible)
    // THE FIRST READ AFTER A RESTART: the roster is still being read, and
    // the page asks again in a few seconds
    : sst === "loading"
      ? '<span class="bmut">lanes and seats: still being read</span>'
    : !read
      ? '<span class="bunk">lanes UNKNOWN</span> <span class="bmut">(' + esc((seats && seats.unavailable) || "the roster was not read") + ")</span>"
      : "<b>" + lanes.running + " lane" + (lanes.running === 1 ? "" : "s") + " running</b>"
        // SOME OF R MAY ALREADY BE ON MAIN: a hand land releases no lease (auto-land releases the lanes it lands), so a
        // landed lane stays a live claim until its holder releases it. R keeps
        // counting it and says how many — the same running[] verdicts the
        // kanban draws in its landed column.
        + (typeof lanes.landed === "number" && lanes.landed
          ? '<span class="bmut">, ' + lanes.landed + " of them landed (lease still held)</span>" : "")
        + " · <b>" + lanes.possible + " seat" + (lanes.possible === 1 ? "" : "s") + " able to work</b>"
        + (typeof lanes.seats === "number" && lanes.seats
          ? ' <span class="bmut">(' + lanes.claimed + " claimed, " + lanes.seats + " seat"
            + (lanes.seats === 1 ? "" : "s") + " at work)</span>" : "");
  // WHERE THE LANES ARE is each project's own line now (task/3445: every
  // project listed once), so this line names only the lanes on NO project's
  // line — claims on projects with no row — so the lines still add up
  const alloc = read && lanes.offboard
    ? ' <span class="balloc">' + lanes.offboard + " on no project's line</span>" : "";
  const loose = read && Array.isArray(lanes.unscoped) ? lanes.unscoped : [];
  const unscoped = loose.length
    ? ' <span class="bmut" title="' + esc(loose.join(", ") + " — at work in a directory no project"
      + " claims, so counted in no project's lanes") + '">· ' + loose.length + " seat"
      + (loose.length === 1 ? "" : "s") + " unscoped: " + esc(loose.join(", ")) + "</span>"
    : "";
  const green = boardSecState(boardSec(d, "lights")) === "ok" && typeof head.green === "number"
    ? head.green : null;
  // "N active" is the scan's own word (a project it saw worked lately),
  // the count the overview carried before the rows replaced its cards
  const act = typeof active === "number" ? " · " + active + " active" : "";
  const greenTxt = green === null ? '<span class="bunk">green UNKNOWN</span>' + act
    : "<b>" + green + " green" + act + "</b>";
  // NO FAMILY CHIP (task/3445): supply is measured once for the whole fleet
  // and drawn once, at the head of Fleet › credit; this line keeps its counts
  return '<a class="bcap" href="#roster" title="lanes running: live worktree lanes across every project, plus one for each usable seat at work with no lane claimed — a seat running subagents can hold several. seats able to work: up, not paused, not walled and on a family whose credit is not RED, one each. Tap for the seats.">'
    + lanesTxt + "</a>" + alloc + unscoped + " · " + greenTxt;
}

/* THE PROJECT'S TEAM, in its line (task/3445): "team v5 · 7/10 live" and
   the share marks (`teamMini`) of a binding team, "team proposed · 2/3 live",
   or "no team". The team itself is the project's Team tab; which families
   its seats spend, and their colours, are there too. A teams leg not read
   says so and never "no team". */
function boardTeam(p, j, d) {
  const st = boardSecState(boardSec(d, "teams"));
  if (st !== "ok" && st !== "stale")
    return '<span class="bteam bmut">' + (st === "unknown" ? "team ?" : "team reading…") + "</span>";
  const t = j && j.team;
  if (!t) return '<span class="bteam bmut">no team</span>';
  const mem = ((teamCurrent(pkey(p), j) || {}).members || []).filter(m => !m.gone);
  return '<span class="bteam"><span class="bteamv">' + (t.authored ? "team v" + esc(t.v) : "team proposed")
    + " · " + mem.filter(m => m.state === "live").length + "/" + mem.length + " live</span>"
    + (t.binding ? teamMini(p, j, d) : "") + "</span>";
}

/* THE ONE COUNT a collapsed row carries (task/3643): its to-do and
   under-way work, off the Work page's own read (`wkProjectCount` over
   /api/work), so the row, its Work tab, the nav badge and Home count one set
   of cards; "reading…" until it is read, "?" when it could not be, and
   "at least" over a project whose work was not read. */
function boardCount(key) {
  return wkProjectCount(WORK && WORK.d, key);
}
/* THE COUNTS AND THE LAST LAND REDRAWN IN PLACE as the work read lands
   (both read it), without redrawing a row a reader may be typing in. */
function boardCountsPaint() {
  document.querySelectorAll("#brows .brow[data-key]").forEach(row => {
    const c = row.querySelector(".bline .bcount"), land = row.querySelector(".bline .bland");
    if (c) c.outerHTML = boardCount(row.dataset.key);
    const p = land && projects.find(x => pkey(x) === row.dataset.key);
    if (p) land.innerHTML = boardLand(p, BOARD && BOARD.projects ? BOARD.projects[row.dataset.key] : undefined, BOARD);
  });
}

/* ONE PROJECT'S RUNNING LANES and the seats working them, off the roster's
   worktree claims, with the land requests held for him when this is the
   project the pipeline projects. */
function boardLanes(j, d) {
  const seats = boardSec(d, "seats"), st = boardSecState(seats);
  if (st !== "ok")
    return '<span class="' + (st === "loading" ? "bmut" : "bunk") + '" title="' + esc("lanes " + boardSecWord(seats)) + '">'
      + (st === "stale" ? "STALE" : st === "unknown" ? "lanes ?" : "reading…") + "</span>";
  const run = (j && j.running) || [];
  const holds = j && j.owner ? j.owner.holds : null;
  const seated = run.filter(r => r.kind === "seat").length;
  return (run.length
    ? '<span title="' + esc(run.map(boardLaneWord).join(" · "))
      + '">' + run.length + " lane" + (run.length === 1 ? "" : "s")
      // A SEAT AT WORK IS A LANE BY COUNT, NOT A CLAIM, and says so
      + (seated ? " (" + (run.length > seated ? run.length - seated + " claimed, " : "")
        + seated + " seat" + (seated === 1 ? "" : "s") + " at work)" : "") + "</span>"
    : '<span class="bmut">no lanes</span>')
    + (holds ? ' <span class="bwarn">· ' + holds + " on you</span>" : "");
}

/* THE WORDS for a landed lane whose room holds uncommitted work — the CLI's
   own "the room is DIRTY (commit or --park first)" beside its LANDED line */
const BOARD_DIRTY = "room DIRTY (commit or park first)";

/* one running lane in words: a claimed lane and the seats holding it, or a
   seat at work with no lane claimed */
function boardLaneWord(r) {
  return r.kind === "seat" ? (r.seats || []).join(", ") + " at work, no lane claimed"
    : r.lane + " (" + (r.seats || []).join(", ") + ")"
      + (r.landed && r.landed.state === "landed" ? " — landed on main, lease still held"
        + (r.dirty === true ? ", " + BOARD_DIRTY : "")
        : r.on_gate ? " — on the gate" + (r.on_gate.label ? " (" + r.on_gate.label + ")" : "") : "");
}

/* A WEEK OF PROGRESS: the commits on the project's own main (its
   first-parent commits: a train's merge, a hand merge, a commit made on main
   itself), then the backlog's net arrow — tasks opened against tasks closed.
   Down is good. ONE WORD PER NOUN (console walk 4, P1 3): "land" is what
   helm records, and a project that merges by hand has none, so this count
   is "commits", never "lands". The trunk is named as the About's newest
   commit names it (`last_land.ref`: main, master), so a project trunked on
   master never reads "on main". -> {cell, line}; neither half draws a count
   it did not read. */
function boardProgress(j, d) {
  const trunk = boardSec(d, "trunk"), tst = boardSecState(trunk);
  const tasks = boardSec(d, "tasks"), kst = boardSecState(tasks);
  const pg = (j && j.progress) || {}, ref = ((j && j.last_land) || {}).ref || "main";
  const commits = tst === "ok" && typeof pg.lands7 === "number" ? pg.lands7 : null;
  const commitTxt = tst === "stale" ? "STALE" : tst === "unknown" ? "commits ?" : tst !== "ok" ? "reading…"
    : commits === null ? "commits ?" : commits + " commit" + (commits === 1 ? "" : "s");
  // THE WEEK'S TASK FIGURE IS THE ONE READER'S net_7d (task/3745): the same
  // number the row's health line and `helm task health` print, so there is
  // one count, not a second one this page keeps for itself.
  const h = (j && j.health) || null;
  const flow = kst === "ok" && h && typeof h.net_7d === "number";
  const net = flow ? h.net_7d : null;
  const arrow = net === null ? ""
    : ' · <span class="' + (net > 0 ? "bwarn" : "bgood") + '">'
      + (net > 0 ? "↑" + net : net < 0 ? "↓" + -net : "→0") + "</span>";
  const commitLine = commits !== null ? commits + " commit" + (commits === 1 ? "" : "s") + " on " + ref
    : "commits on " + ref + " " + (tst !== "ok" ? boardSecWord(trunk) : "not read here");
  const taskLine = flow ? "7-day net " + (net > 0 ? "+" + net : net)
    : "tasks " + boardSecWord(tasks);
  return {cell: '<span title="the last seven days: the commits on this project\'s ' + esc(ref) + ', and its tasks opened against closed">'
      + esc(commitTxt) + "</span>" + arrow,
    line: "this week: " + commitLine + " · " + taskLine};
}

/* ONE REPOSITORY'S BADGE. A visibility gh answered links to the repository; an
   unknown one, one still being checked, and one never asked link nowhere and
   never pass for an answer. */
function boardRepoBadge(r) {
  const vis = r.visibility;
  const who = (r.slug || "a remote not on GitHub") + " · " + (r.remote || "?");
  if (vis === "public" || vis === "private" || vis === "internal")
    return '<a class="rbadge ' + vis + '" href="' + esc(r.url) + '" target="_blank" rel="noopener noreferrer" title="'
      + esc(who + " — " + vis + " on GitHub" + (r.stale ? "; the answer is older than a day and is being asked again" : ""))
      + '">' + esc(vis) + "</a>";
  const word = vis === "pending" ? "checking…" : vis === "unasked" ? "not checked" : "unknown";
  const why = vis === "pending" ? "gh is being asked"
    : vis === "unasked" ? "a quiet project's repositories are not sent to gh"
    : r.why || "gh could not say";
  return '<span class="rbadge ' + (vis === "pending" || vis === "unasked" ? "rwait" : "unknown")
    + '" title="' + esc(who + " — " + why) + '">' + esc(word) + "</span>";
}

/* A PROJECT'S REPOSITORIES: a badge each, the fork before the repository it
   came from. `named` (the open row) lists every remote with its owner/name.
   The row's own cell keeps to what fits: one badge per GitHub repository,
   however many remotes point at it, and the remotes that are not on GitHub —
   a checkout can carry a dozen, one per build box — as ONE unknown badge
   that names them on hover. */
function boardRepos(j, named) {
  if (!j || j.repos === undefined) return '<span class="bmut">repos not read yet</span>';
  if (j.repos === null)
    return '<span class="bunk" title="' + esc(j.repos_unavailable || "the checkout could not be read") + '">repos ?</span>'
      + (named ? ' <span class="bmut">' + esc(j.repos_unavailable || "") + "</span>" : "");
  if (!j.repos.length) return '<span class="bmut" title="this checkout has no git remote">no remote</span>';
  if (named)
    return j.repos.map(r => '<span class="rrepo"><span class="rname">'
      + esc(r.slug || r.remote + " (not on GitHub)") + "</span> " + boardRepoBadge(r) + "</span>").join(" ");
  const seen = new Set(), off = [];
  const badges = j.repos.filter(r => {
    if (!r.slug) { off.push(r.remote); return false; }
    if (seen.has(r.slug)) return false;
    seen.add(r.slug);
    return true;
  }).map(r => '<span class="rrepo">' + boardRepoBadge(r) + "</span>");
  if (off.length)
    badges.push('<span class="rbadge unknown" title="' + esc(off.join(", ")
      + " — not GitHub remotes, so no visibility is known") + '">'
      + (badges.length ? "+" + off.length + " unknown" : "unknown") + "</span>");
  return badges.join(" ");
}

/* THE LAST LAND CELL. ONE LANDED TIME (walk 2, finding 17): the project
   that lands by train says "landed" at its newest train's push time, the
   time the Work page's Landed column and every card's land proof print
   (`/api/work`); a project that merges by hand has no land record, so its
   cell says "merged" at its trunk's newest commit, never "landed". The
   train's project never falls through to "merged by hand": with no train
   in the day's window it is its last DONE train, else "no land in 24 h". */
function boardLand(p, j, d) {
  const trunk = boardSec(d, "trunk"), tst = boardSecState(trunk), last = j && j.last_land;
  const trains = WORK && WORK.d && WORK.d.trains, mine = !!trains && trains.project === pkey(p);
  const tl = mine && trains.last, pushed = mine && ((trains.recent || [])[0]
    || (tl && tl.state === "DONE" && tl.at ? tl : null));
  if (mine && !(pushed && pushed.at)) return '<span class="bmut" title="no train landed in the last 24 h">no land in 24 h</span>';
  const land = pushed && pushed.at
    ? '<span title="' + esc(pushed.name + (pushed.land ? " · LAND " + pushed.land : "") + " · pushed to the shared code") + '">landed '
      + esc(lrAgo(Math.max(0, Date.now() / 1e3 - pushed.at))) + "</span>"
    : tst !== "ok"
    ? '<span class="' + (tst === "stale" || tst === "unknown" ? "bunk" : "bmut") + '" title="'
      + esc("last land " + boardSecWord(trunk)) + '">'
      + (tst === "stale" ? "STALE" : tst === "unknown" ? "land ?" : "reading…") + "</span>"
    : last && typeof last.age_s === "number"
      ? '<span title="' + esc("newest on " + (last.ref || "main") + ": " + (last.sha || "?")
        + (last.how === "push" ? " · pushed from this checkout" : " · its commit time")
        + " · merged by hand, so helm records no land") + '">merged '
        + esc(lrAgo(last.age_s)) + "</span>"
      : '<span class="bmut" title="' + esc((last && last.unavailable) || "no trunk was read for this project")
        + '">not read here</span>';
  return land;
}
/* THE DESKTOP CELLS: running lanes, the last land (`boardLand`), the last
   activity, the repositories. The week's progress is the project's About
   tab. */
function boardWide(p, j, d) {
  /* THE NEWER OF TWO READINGS: the registry's last session, which is only as
     fresh as the last `helm sync`, and the newest beat of a seat on the
     project, which the roster reads live. */
  const at = Math.max(p.last_seen || 0, (j && j.active_at) || 0);
  return '<span class="bwide bwork">' + boardLanes(j, d) + "</span>"
    + '<span class="bwide bland">' + boardLand(p, j, d) + "</span>"
    + '<span class="bwide bact" title="the newest activity seen here: a seat\'s last beat, or the newest session the registry recorded">'
    + (at ? "active " + esc(ago(at)) : "no activity seen") + "</span>"
    + '<span class="bwide brepo">' + boardRepos(j, false) + "</span>";
}

/* AN OPEN PROJECT IS TABS, one at a time (task/3445), so an open project is
   at most a screen: TEAM (the light setter, then the team — `teamParts`),
   WORK (the Work page locked to this project, task/3643: its Lanes and Tasks
   tabs were its share of the land board and of the backlog, and they are one
   page now) and ABOUT (its week, its repositories, what is on file). An old
   `tab=lanes` or `tab=tasks` address opens WORK at the pipeline or the
   backlog (`projRoute`). `tab` is PROJ_TAB. */
const PROJ_TABS = [["team", "Team"], ["work", "Work"], ["about", "About"]];
/* -> {tabs, body}: the tab strip rides the open row's sticky head with its
   name (task/3475), and the body scrolls under them. */
function boardDetail(p, j, d, tab) {
  const on = PROJ_TABS.some(t => t[0] === tab) ? tab : "team";
  return {tabs: '<div class="ptabs" role="tablist" aria-label="' + esc(p.name) + '">'
    + PROJ_TABS.map(t => '<button type="button" role="tab" class="ptab' + (t[0] === on ? " on" : "")
      + '" aria-selected="' + (t[0] === on) + '" data-ptab="' + t[0] + '">' + t[1] + "</button>").join("")
    + "</div>",
    body: '<div class="ptabbody" data-tab="' + on + '">' + projTab(p, j, d, on) + "</div>"};
}

/* ONE TAB'S BODY. */
function projTab(p, j, d, tab) {
  const line = t => "<div class='dline'>" + esc(t) + "</div>";
  const sec = (h, body) => "<div class='dsec'><h4>" + esc(h) + "</h4>" + body + "</div>";
  if (tab === "team") return lightset(p) + teamSection(p, j, d);
  if (tab === "work") {
    wkProjFor(pkey(p));
    // a card already open (a deep link, or a tab opened again) asks for its
    // crossings once the tab is in the page: wkHTML is pure and reads none
    if (WK.proj.view.card && !(WK.proj.ev && WK.proj.ev.key === WK.proj.view.card)) setTimeout(() => wkPaint(WK.proj), 0);
    return wkHTML(WK.proj);
  }
  const trunk = boardSec(d, "trunk"), last = j && j.last_land;
  const landLine = boardSecState(trunk) !== "ok" ? line("newest on main " + boardSecWord(trunk))
    : last && typeof last.age_s === "number"
      ? line("newest commit on " + (last.ref || "main") + " " + (last.sha || "?") + ", " + lrAgo(last.age_s)
        + (last.how === "push" ? " (pushed from this checkout)" : " (its commit time)"))
      : line("newest commit not read here: " + ((last && last.unavailable) || "no trunk was read"));
  return sec("progress", line(boardProgress(j, d).line))
    + sec("repos", "<div class='dline'>" + boardRepos(j, true) + "</div>")
    + sec("on file", landLine + (lineageN(p) ? "<span class='lchip'>⑂ lineage</span>" : "")
      + "<div class='ppath copy' data-copy='" + esc(p.path || "") + "' title='click to copy'>" + esc(p.path || "") + "</div>")
    + "<div class='dwrap'>" + detailPane(p) + "</div>";
}

/* ONE PROJECT, ONCE (task/3445): its line — light, name, team, tasks, and
   on a desktop its lanes, last land, activity and repositories — and, open,
   its tabs. `tab` is the open tab (PROJ_TAB). AN OPEN PROJECT'S LINE AND
   TABS STICK BELOW THE NAVIGATION (task/3475): the helm project's Team tab
   is 4,443 px tall at 1440 px and 6,426 at 420, and its name and tab strip
   scrolled away with it; `.bstick` holds both while the body scrolls. */
/* THE PROJECT'S HEALTH LINE, under its name (task/3745): the one reader's
   facts — open stories, today's flow, the 7-day net — the same line `helm
   task health` prints, so the board and the CLI cannot disagree. Compact
   here (it wraps under the name, and a phone has no hover for the long
   form, which the tooltip holds): "2 open · today +1 −0 · week +3". A
   project with no rows still reads it: zeros, not absence. */
function boardHealth(j, d) {
  const h = (j && j.health) || null;
  if (!h || typeof h.open_stories !== "number" || typeof h.net_7d !== "number")
    return "";
  const sgn = n => (n > 0 ? "+" + n : n < 0 ? "−" + (-n) : "0");
  const day = (typeof h.opened_today === "number" && typeof h.closed_today === "number")
    ? " · today " + sgn(h.opened_today) + " −" + h.closed_today : "";
  return '<span class="bhealth" title="the one reader: its open stories, and the week\'s flow — today\'s opened and closed, and the 7-day net (opened minus closed); the same line `helm task health` prints">'
    + h.open_stories + " open" + day
    + " · week " + sgn(h.net_7d) + "</span>";
}
function boardRowHTML(p, d, open, tab) {
  const lit = light(p), key = pkey(p);
  const j = d && d.projects ? d.projects[key] : undefined;
  const line = '<div class="bline">'
    + '<button type="button" class="blight" title="' + esc(lit.colour + " · " + lit.why + " — tap to set")
    + '"><span class="' + esc("dot " + lit.colour + (lit.authored ? " authored" : "")) + '"></span></button>'
    + '<span class="bname"><span class="bname-t">' + esc(p.name) + "</span>" + boardHealth(j, d)
    + "</span>"
    + boardTeam(p, j, d) + boardCount(key) + boardWide(p, j, d)
    + "</div>";
  const det = open ? boardDetail(p, j, d, tab) : null;
  return '<article class="brow ' + (lit.authored ? esc(lit.colour) : "unset") + (open ? " open" : "")
    + '" data-key="' + esc(key) + '">'
    + (det ? '<div class="bstick">' + line + det.tabs + "</div>"
      + '<div class="bdetail">' + det.body + "</div>" : line)
    + "</article>";
}

/* THE OPEN ROW'S STICKY HEAD HEIGHT as --bstickh, so a target inside the row
   (the Work tab's band and drawer) clears the head as well as the nav; 0
   with no row open. */
function publishStickHeight() {
  const s = document.querySelector("#brows .brow.open>.bstick");
  const h = s ? Math.round(s.getBoundingClientRect().height) : 0;
  document.documentElement.style.setProperty("--bstickh", h + "px");
  return h;
}
window.addEventListener("resize", () => publishStickHeight());

/* MAY A REDRAW LAND WORK'S OPEN PROJECT AGAIN? Only while Work is shown and
   the window is exactly where Work's last landing put it: a reader who has
   scrolled since is never moved. PURE. */
function boardLandAgain(cur, at, scrollY) {
  return cur === "work" && !!at && at.v === "work" && Math.round(scrollY || 0) === at.y;
}

/* "N active" on the lanes line: the projects the scan calls active (its own
   word for a project it saw worked lately), whatever their light says. */
function boardActive(rows) {
  return rows.filter(p => p.status === "active").length;
}

/* Draw the whole board from what the page holds: the registry rows and the
   last board read. Quiet projects fold under one line at the bottom, unless
   he is filtering, when every match shows. */
function renderBoard() {
  const host = $("#brows");
  if (!host) return;
  const q = $("#q").value.trim().toLowerCase();
  const d = BOARD;
  const lay = boardLayout(projects, d, q, showRetired, PROJ_LIGHT);
  const vis = lay.shown;
  const row = p => boardRowHTML(p, d, BOARD_OPEN.has(pkey(p)), PROJ_TAB);
  /* AN OPEN WORK TAB SURVIVES THE MINUTE'S REDRAW: its drawer, its menus,
     a comment being written and the search caret are the reader's, so the
     live component moves into the redrawn row rather than being drawn again
     from its read. */
  const tasks = host.querySelector('.wk[data-wk="proj"]'), typing = document.activeElement;
  const tasksKey = tasks && tasks.closest(".brow") ? tasks.closest(".brow").dataset.key : null;
  host.innerHTML = lay.lead.map(row).join("")
    + (lay.quiet.length ? '<details class="bfold"' + (BOARD_FOLD ? " open" : "")
      + ' title="no activity, no open task and no light set in thirty days"><summary>'
      + "quiet (" + lay.quiet.length + ")</summary>" + lay.quiet.map(row).join("") + "</details>" : "");
  const redrawn = host.querySelector('.wk[data-wk="proj"]');
  if (tasks && redrawn && redrawn.closest(".brow").dataset.key === tasksKey) {
    redrawn.replaceWith(tasks);
    if (typing && tasks.contains(typing) && typing.focus) typing.focus();
  }
  const fold = host.querySelector(".bfold");
  if (fold) fold.addEventListener("toggle", () => { BOARD_FOLD = fold.open; });
  const retired = projects.filter(p => p.retired).length;
  $("#togRetired").textContent = "retired · " + retired;
  $("#togRetired").classList.toggle("avail", retired > 0);
  $("#count").textContent = vis.length === projects.length ? vis.length + " projects" : vis.length + " of " + projects.length;
  $("#empty").classList.toggle("show", !projects.length);
  $("#bheadline").innerHTML = boardCapacity(d, boardActive(projects));
  famRender();
  // the accounts table's group headers name the families each vendor serves
  if ($("#view-quota").classList.contains("on")) renderAccts();
  // THE OPEN PROJECT'S ABOUT TAB asks the detail door for what is on file
  const open = [...BOARD_OPEN][0], orow = open && host.querySelector('.brow[data-key="' + CSS.escape(open) + '"]');
  const op = open && projects.find(x => pkey(x) === open);
  if (orow && op && PROJ_TAB === "about") loadDetail(orow, op);
  publishStickHeight();
  // A LINK TO AN OPEN PROJECT LANDS ON IT (task/3475): #work/projects?open=
  // helm&tab=team landed at scrollY 0 with the project 1,720 px down,
  // because its row is drawn by a read that arrives after the page is shown.
  // The row lands when it is drawn, and again as the page above it grows,
  // for as long as the window is where the last landing left it.
  if (orow && boardLandAgain(showView.cur, goTarget.at, window.scrollY)) goTarget("work", orow);
  projHash();
  homeRender();
}

/* Open or close one row in place. A tap on the light always opens, and puts
   the caret in the setter's reason box: the light is set from where it is
   drawn. Opening asks the detail door for what is on file, once. */
function boardToggle(row, atLight) {
  if (!row) return;
  const key = row.dataset.key;
  const p = projects.find(x => pkey(x) === key);
  if (!p) return;
  const open = atLight || !BOARD_OPEN.has(key);
  // ONE PROJECT OPEN AT A TIME (task/3445), and the URL holds it; a tap on
  // the light opens it at the Team tab, where the setter is
  const other = [...BOARD_OPEN].some(k => k !== key);
  BOARD_OPEN.clear();
  if (open) BOARD_OPEN.add(key);
  if (atLight) PROJ_TAB = "team";
  if (other) renderBoard();
  else row.outerHTML = boardRowHTML(p, BOARD, open, PROJ_TAB);
  // the in-place swap opens or closes a sticky head: publish it now, or a
  // pager scrolled inside this row still clears a head of 0 (P2-3)
  publishStickHeight();
  projHash();
  const fresh = document.querySelector('.brow[data-key="' + CSS.escape(key) + '"]');
  if (!open || !fresh) return;
  if (other) fresh.scrollIntoView({block: "nearest"});
  if (PROJ_TAB === "about") loadDetail(fresh, p);
  if (atLight) {
    const why = fresh.querySelector(".lightwhy");
    if (why) why.focus();
  }
}

/* THE PROJECTS SECTION'S STATE IN THE URL (task/3445):
   #work/projects?q=&light=&open=helm&tab=team, so a link opens a project at
   a tab. `projQuery` writes it from the page, `projRoute` reads it back. */
let PROJ_TAB = "team";
let PROJ_LIGHT = "";
const PROJ_LIGHTS = ["green", "yellow", "orange", "red", "unset"];
function projQuery() {
  const s = new URLSearchParams(), q = (($("#q") || {}).value || "").trim(), open = [...BOARD_OPEN][0];
  if (q) s.set("q", q);
  if (PROJ_LIGHT) s.set("light", PROJ_LIGHT);
  if (open) { s.set("open", open); s.set("tab", PROJ_TAB); }
  // AN OPEN WORK TAB'S VIEW rides along, its search as `wq` (this page's
  // `q` is the project filter's) and its drawer as `card`
  if (open && PROJ_TAB === "work" && WK.proj.key === open)
    new URLSearchParams(wkQuery(WK.proj.view, "flow", WK.proj.lock, "wq").slice(1)).forEach((v, k) => s.set(k, v));
  const t = s.toString().replace(/%2C/g, ",");
  return t ? "?" + t : "";
}
function projRoute(query) {
  const s = new URLSearchParams(query || ""), tab = s.get("tab");
  if ($("#q")) $("#q").value = s.get("q") || "";
  PROJ_LIGHT = PROJ_LIGHTS.indexOf(s.get("light")) >= 0 ? s.get("light") : "";
  if ($("#lightf")) $("#lightf").value = PROJ_LIGHT;
  BOARD_OPEN.clear();
  if (s.get("open")) BOARD_OPEN.add(s.get("open"));
  // THE OLD LANES AND TASKS TABS open the Work tab at the pipeline and at
  // the backlog (task/3643)
  const old = {lanes: WK_ENTRY.pipeline, tasks: Object.assign({}, WK_ENTRY.backlog, {q: s.get("tq") || ""})}[tab];
  PROJ_TAB = old ? "work" : PROJ_TABS.some(t => t[0] === tab) ? tab : "team";
  if (s.get("open") && PROJ_TAB === "work") wkProjFor(s.get("open"), Object.assign(wkParse(query, "wq"), old || {}));
  renderBoard();
}
function projHash() {
  viewHashSync("work");
}
/* THE FAMILY CREDIT'S OWN STATE after its "?" (task/3445): the family its
   sheet shows (#quota?family=grok). A query names what it names and nothing
   else; an unknown or empty one is the page's default. */
function famQuery() {
  return FAM_SEL ? "?" + new URLSearchParams({family: FAM_SEL}).toString() : "";
}
function famRoute(query) {
  FAM_SEL = new URLSearchParams(query || "").get("family") || null;
  famRender();
  // A FAMILY LINK LANDS ON ITS CARD, below the sticky nav, however far down
  // the page it was followed from was scrolled (after the page is shown)
  if (FAM_SEL) setTimeout(() => { const c = $("#flagcard"); if (c) c.scrollIntoView({block: "start"}); }, 0);
}
/* ONE READER AND ONE ROUTER over every view's query, so showView, the boot
   and a followed link all hand a view the same state (Fleet › models' model
   or seat, #models?model= and #models?seat=, is task/3448's). */
function viewQuery(v) {
  return v === "work" ? projQuery() : pageOf(v) === "flow" ? wkQuery(WK.main.view, v, null, "q")
    : v === "quota" ? famQuery() : v === "models" ? modelsQuery() : "";
}
function viewRoute(v, query) {
  if (pageOf(v) === "flow") wkRoute(v, query);
  else if (v === "work") projRoute(query);
  else if (v === "quota") famRoute(query);
  else if (v === "models") modelsRoute(query);
}
/* the address bar follows a pick made on the page, while that page is shown */
function viewHashSync(v) {
  if (showView.cur !== v) return;
  const h = "#" + viewHash(v) + viewQuery(v);
  if (location.hash !== h) history.replaceState(null, "", h);
}

/* A TAB PICKED on the open project. The strip sticks, so a pick made deep
   inside a long tab swaps the body under a window that stays there: whether
   the row's top was under the nav is read BEFORE the swap, and then the
   fresh row lands, its new tab starting just below the head (task/3475). */
function projTabSwap(t) {
  const row = t.closest(".brow"), key = row && row.dataset.key;
  const p = key && projects.find(x => pkey(x) === key);
  if (!p) return;
  const stuck = row.getBoundingClientRect().top < (publishNavHeight() || 0);
  PROJ_TAB = t.dataset.ptab;
  row.outerHTML = boardRowHTML(p, BOARD, true, PROJ_TAB);
  projHash();
  const fresh = document.querySelector('.brow[data-key="' + CSS.escape(key) + '"]');
  if (fresh && PROJ_TAB === "about") loadDetail(fresh, p);
  publishStickHeight();
  if (fresh && stuck) goTarget("work", fresh);
}

/* A TAB of the open project. (A Work tab's controls are the Work page's own,
   wired in 52-work.) */
document.addEventListener("click", ev => {
  const t = ev.target.closest("[data-ptab]");
  if (t) projTabSwap(t);
});
$("#lightf").addEventListener("change", ev => { PROJ_LIGHT = ev.target.value; renderBoard(); });
/* WHEN TO ASK AGAIN, in ms, or null: soon while any section is still being
   read, backing off from BOARD_RETRY_MS, and never once the wait would reach
   the minute's own read. */
function boardRetryMs(d, tries) {
  const secs = (d && d.sections) || {};
  const wait = BOARD_RETRY_MS * 2 ** (tries || 0);
  return Object.keys(secs).some(k => secs[k] && secs[k].loading) && wait < BOARD_POLL_MS ? wait : null;
}

/* is a page that draws the board on screen — Work's projects, Home, or
   Fleet › credit's Families card: the quick read asks only then, and the
   minute's read runs on any page (the work reader reads the board) */
function boardShown() {
  return ($("#view-work").classList.contains("on")
    || $("#view-home").classList.contains("on")
    || $("#view-quota").classList.contains("on")) && !document.hidden;
}

/* A failed read is drawn as UNKNOWN, never as the last board: the sections'
   own clocks are what let an old reading stand, and a read that did not
   arrive has no clock. A read that names a section still being read is
   followed by a quick one (`boardRetryMs`). */
async function loadBoard() {
  try {
    BOARD = await j("/api/board", BOARD_FETCH_MS);
  } catch (e) {
    BOARD = {unavailable: (e && e.message) || "the board read failed"};
  }
  renderBoard();
  clearTimeout(BOARD_AGAIN);
  const wait = boardRetryMs(BOARD, BOARD_TRIES);
  BOARD_TRIES = wait === null ? 0 : BOARD_TRIES + 1;
  BOARD_AGAIN = wait === null ? null : setTimeout(() => boardShown() && loadBoard(), wait);
}

async function boardReload() {
  await Promise.all([loadRegistry().catch(() => {}), loadBoard()]);
}

loadBoard();
setInterval(() => {
  if (boardShown()) boardReload();
  // THE WORK READER READS THE BOARD (task/3643), and the nav badge it feeds
  // has to reach him from any page: the minute's read runs on every page
  else if (!document.hidden) loadBoard();
}, BOARD_POLL_MS);
