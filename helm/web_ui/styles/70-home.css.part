/* ---------- SYSTEM DASHBOARD (home, above the fold) ----------
   Tufte, applied: no box, no badges — hairline rules between rows, direct
   labels beside data, tabular numerals, colour only as CLASS (the lr card's
   own law: --ok is a verified fact, --warn/--bad are alarms, everything
   unproven is neutral). Each row is the same shape — label · data · numbers —
   so the eye COMPARES components instead of parsing 90 rows of equal weight
   (the wall this band replaced; the land requests are Work page cards now).
   Every cell distinguishes ZERO from UNREAD: "not read yet" / UNKNOWN are
   words, never a blank or a fabricated 0 — the console's governing finding
   ("helm's claims about itself are not checked") applies to the dashboard
   FIRST, because it is the first thing the owner reads. */
.hsum .dhead{display:flex;align-items:baseline;gap:10px;padding-bottom:3px}
.hsum .dlabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
.hsum .drow{display:flex;align-items:baseline;gap:10px;padding:5px 0;border-top:1px solid var(--line)}
.hsum .dlab{flex:0 0 52px;font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
.hsum .dval{flex:1 1 auto;min-width:0;display:flex;flex-wrap:wrap;gap:2px 10px;align-items:baseline;color:var(--fg)}
.hsum .dnum{font-variant-numeric:tabular-nums;font-weight:var(--w-med);color:var(--fg)}
.hsum .dmut{color:var(--mut)}
.hsum .dsub{color:var(--sub);font-size:var(--f0)}
.hsum .dok{color:var(--ok);font-weight:var(--w-med)}
.hsum .dwarn{color:var(--warn);font-weight:var(--w-med)}
.hsum .dbad{color:var(--bad);font-weight:var(--w-med)}
/* UNKNOWN is a STATE, not styling noise: always the word, always --warn, so
   an unread tile can never be skimmed past as a quiet zero. */
.hsum .dunk{color:var(--warn);font-weight:700}
/* the fleet's seat dots reuse the roster's .rdot colour classes verbatim —
   one presence vocabulary across the whole console, learned once. */
.hsum .dseat{white-space:nowrap;color:var(--fg)}
.hsum .dseat .rdot{margin-right:2px}
/* phone (390px is the design floor): the label rides ABOVE its data — which
   needs the row to WRAP; without flex-wrap a 100%-basis label just shoves the
   whole data cell off the right edge (caught on a real 390px render, not by
   any string test — screenshots are part of this band's definition of done). */
@media (max-width:680px){.hsum .drow{flex-wrap:wrap;row-gap:1px}.hsum .dlab{flex-basis:100%;padding-bottom:0}}

/* a row's jump to the surface that holds its detail */
.hsum .dslink{color:var(--accent);cursor:pointer;white-space:nowrap}
.hsum .dslink:hover{text-decoration:underline}
/* EVERY CARD NAMES ITS SOURCE READ AND THAT READ'S AGE (the home-card law).
   Muted and on its own line: it is provenance the owner checks when a number
   surprises him, never a number competing with the ones above it. */
.hsum .dcsrc{flex:1 1 100%;color:var(--mut)}
/* who-signed share meters: one bar per signer, widths COMPARE against the
   busiest signer in the list — data-ink, no legend (the number is beside it) */
.lmeter{display:inline-block;width:64px;height:5px;border-radius:2px;background:color-mix(in srgb,var(--fg) 8%,transparent);vertical-align:2px}
.lmeter i{display:block;height:100%;border-radius:2px;background:var(--accent)}
/* ANSWERS FOR YOU (owner ruling, task/2364) — one small card, and small is the
   ruling rather than a taste: "do not go overboard", and NO NEW COLOURS, so it
   borrows the band's own tokens and adds none. The author's name is the strong
   part because the reply is a person answering him; the age is tabular so four
   rows read as a column; the text truncates because the room is the record and
   this is the glance that sends him to it. */
#danswers{margin:8px 0;padding:6px 8px;border:1px solid var(--line2);border-radius:6px}
#danswers .dahead{font-size:var(--f0);letter-spacing:.03em;text-transform:uppercase;color:var(--sub);margin-bottom:2px}
#danswers .dahead .dnum{color:var(--fg);font-weight:700;font-variant-numeric:tabular-nums}
#danswers .darow{display:flex;gap:8px;align-items:baseline;padding:1px 0;min-width:0}
#danswers .dafrom{flex:0 0 auto;font-weight:var(--w-med)}
#danswers .datext{flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--fg)}
#danswers .daage{flex:0 0 auto;color:var(--mut);font-size:var(--f0);font-variant-numeric:tabular-nums;min-width:7ch;text-align:right}
#danswers .dasub{font-size:var(--f0);color:var(--sub);margin-top:2px}
/* the band scopes .dunk/.dsub under #dash, so this card restates them rather
   than inheriting a colour it never gets — no NEW colour, the same two tokens */
#danswers .dsub{color:var(--sub);font-size:var(--f0)}
#danswers .dunk{color:var(--warn);font-weight:700}
#danswers .dslink{color:var(--accent);cursor:pointer;white-space:nowrap}
#danswers .dslink:hover{text-decoration:underline}
@media (max-width:680px){#danswers .darow{flex-wrap:wrap}#danswers .datext{flex:1 1 100%}}
/* ---------- HOME (task/3445 L3) ----------
   One screen in the owner's browser pane (960 wide and up): the greeting,
   the on-you strip (only while something waits), then a grid of headline
   tiles — three columns, the away switch one slim row across them. Below 960
   two columns, the away switch a tile of its own; a phone stacks them. Each
   tile is a label that links to its page, then one or two lines. */
#view-home #hello{margin:14px 0 8px;color:var(--mut);font-size:var(--f2)}
.hstrip{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;margin:0 0 12px;padding:9px 14px;background:var(--card);border:1px solid color-mix(in srgb,var(--warn) 45%,var(--line));border-radius:12px;cursor:pointer;font-size:var(--f2)}
.hstrip[hidden]{display:none}
.hgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.htile{min-width:0;padding:10px 14px 12px;background:var(--card);border:1px solid var(--line);border-radius:12px;cursor:pointer;overflow:hidden}
.htile:hover,.hstrip:hover{border-color:var(--accent)}
/* the work tile prints the stage row, word for word: two columns wide (task/3643) */
.htile.hwide{grid-column:span 2}
.hlab{display:inline-block;margin:0 0 6px;font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub);text-decoration:none}
.hlab::after{content:" →"}
.hstrip .hlab{margin:0}
.htile:hover .hlab,.hlab:focus-visible{color:var(--accent)}
.hval{font-size:var(--f1);min-width:0;overflow-wrap:anywhere}
.hval+.hval{margin-top:4px}
.hbig{font-size:var(--f3)}
.hbig b{font-weight:700}
.hnote{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.htile .dsub{font-size:var(--f1)}
.hstale{color:var(--mut);font-size:var(--f1)}
#view-home #posturesec{grid-column:1/-1;margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:2px 16px}
#view-home #posturesec>*{margin:0}
#view-home #posturesec .pfold[open]{flex-basis:100%}
#view-home #danswers{margin:16px 0 0}
#homenotes{margin:16px 0 0}
@media (max-width:959px){.hgrid{grid-template-columns:repeat(2,minmax(0,1fr))}#view-home #posturesec{grid-column:auto}}
@media (max-width:620px){.hgrid{grid-template-columns:minmax(0,1fr)}.htile.hwide{grid-column:auto}}
#nav a.brand{color:inherit;text-decoration:none;border-radius:var(--r-sm);padding:2px 6px 2px 2px}
#nav a.brand:hover,#nav a.brand.on{background:var(--card)}
#nav a.brand:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.hsum{margin:14px 0 0;padding:4px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1)}
.hsum .drow:first-child{border-top:0}
#fleetsum{margin:0 0 14px}
