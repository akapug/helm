/* palette: the predecessors' warm token family — helm is dark-first, light derived in-family.
   data-theme overrides (after the media query, so the toggle wins both ways) ported from the predecessor. */
:root{--bg:#14110d;--fg:#e8e4df;--mut:#8a8680;--sub:#6a6560;--line:#2a251f;--line2:#3a3530;--card:#1a1612;--elev:#211c16;--hover:#1f1a15;--accent:#7eb8a2;--accent-soft:rgba(126,184,162,.15);--claude:#e0a561;--codex:#4ea8de;--opencode:#b39ddb;--pi:#d982c8;--code:#211c16;--codefg:#cbb98f;--hl:#2a231a;--ok:#7ecb8b;--warn:#e8c96a;--bad:#e8594f;--ext:#4ea8de;--shadow:0 1px 3px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.22)}
@media (prefers-color-scheme:light){:root{--bg:#faf7f2;--fg:#1c1813;--mut:#7a7167;--sub:#a39a8e;--line:#e8e2d8;--line2:#ded6c9;--card:#fff;--elev:#fdfbf7;--hover:#f4efe7;--accent:#3e8a6e;--accent-soft:rgba(62,138,110,.12);--claude:#c9772e;--codex:#3f7fae;--opencode:#7a5fc0;--pi:#a84491;--code:#f1ece3;--codefg:#5a4a34;--hl:#efe7d8;--ok:#2f9e57;--warn:#a87a1d;--bad:#c24339;--ext:#3f7fae;--shadow:0 1px 3px rgba(28,24,19,.07),0 4px 14px rgba(28,24,19,.05)}}
:root[data-theme=dark]{--bg:#14110d;--fg:#e8e4df;--mut:#8a8680;--sub:#6a6560;--line:#2a251f;--line2:#3a3530;--card:#1a1612;--elev:#211c16;--hover:#1f1a15;--accent:#7eb8a2;--accent-soft:rgba(126,184,162,.15);--claude:#e0a561;--codex:#4ea8de;--opencode:#b39ddb;--pi:#d982c8;--code:#211c16;--codefg:#cbb98f;--hl:#2a231a;--ok:#7ecb8b;--warn:#e8c96a;--bad:#e8594f;--ext:#4ea8de;--shadow:0 1px 3px rgba(0,0,0,.3),0 6px 18px rgba(0,0,0,.22)}
:root[data-theme=light]{--bg:#faf7f2;--fg:#1c1813;--mut:#7a7167;--sub:#a39a8e;--line:#e8e2d8;--line2:#ded6c9;--card:#fff;--elev:#fdfbf7;--hover:#f4efe7;--accent:#3e8a6e;--accent-soft:rgba(62,138,110,.12);--claude:#c9772e;--codex:#3f7fae;--opencode:#7a5fc0;--pi:#a84491;--code:#f1ece3;--codefg:#5a4a34;--hl:#efe7d8;--ok:#2f9e57;--warn:#a87a1d;--bad:#c24339;--ext:#3f7fae;--shadow:0 1px 3px rgba(28,24,19,.07),0 4px 14px rgba(28,24,19,.05)}
/* THE `hidden` ATTRIBUTE OUTRANKS EVERY AUTHOR `display`, which is the only
   way it can mean what the markup says it means. The UA stylesheet's
   `[hidden]{display:none}` is an ATTRIBUTE selector, so any author rule with
   an id in it wins on specificity and the element stays on screen while every
   script that reads it — `el.hidden`, `hasAttribute("hidden")` — correctly
   reports it hidden. The two disagree silently and nothing in the JS is wrong.

   MEASURED, three separate times in this tree, each cured only where it was
   found: the retired pipeline wall's `[hidden]`, `#declform[hidden]` and `#declfill[hidden]`
   in the quota sheet. The fourth was the stale-build offer, which reached the
   owner: `#stalebuild{display:flex}` pinned it under the top edge permanently,
   so it announced "helm has changed since you opened this page" on a page that
   was current, survived every reload, and its "not now" button set
   `bar.hidden = true` to no visible effect at all. In the browser:
   `hidden === true`, `getComputedStyle(el).display === "flex"`, 52px tall.

   ONE RULE INSTEAD OF A FOURTH PATCH. `!important` is the point and not a
   shortcut — it is what makes the guarantee hold against an author rule of any
   specificity, including ones not written yet. An element that must be laid
   out is not given `hidden`; that is what a class is for.
   tests/test_web_hidden_attribute.py holds this line against regression. */
[hidden]{display:none !important}

/* ---------- design tokens: ONE type scale + radii, so the whole UI reads as
   one system. Six steps (was ~30 ad-hoc sizes); three weights; tabular numerals
   are the default so every column of numbers aligns (Tufte: strict alignment).
   Colours stay in the palette above and carry signal only. ---------- */
:root{
  --f0:.72rem;   /* micro: uppercase labels, chips, flags */
  --f1:.82rem;   /* small: secondary meta, table sub-lines */
  --f2:.9rem;    /* base: body text, table cells */
  --f3:1rem;     /* control: inputs, primary buttons */
  --f4:1.15rem;  /* section head, card title */
  --f5:1.4rem;   /* page title */
  --w-reg:400;--w-med:600;--w-bold:700;
  --r-sm:6px;--r:9px;--r-lg:13px;--r-pill:999px;
  --mono:ui-monospace,Menlo,Consolas,monospace;
  --num:tabular-nums;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:var(--f2)/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;font-variant-numeric:var(--num)}
/* brand accent lives ON the nav's top edge (contained) — the old full-screen
   fixed hairline painted over the tray + drawer (z-conflict); this cannot. */
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(14px,3vw,36px);position:relative}
code,.mono{font-family:var(--mono);font-size:.9em}
code{background:var(--code);color:var(--codefg);padding:1px 5px;border-radius:var(--r-sm)}
button{font:inherit}

/* ---------- nav ----------
   A stable single row: brand · tabs · (flexible spacer) · stats · theme · tray.
   The spacer is the only flexible cell, so the stats + controls stay pinned
   right and never wrap into the tray button (a baseline-screenshot bug).
   flex-wrap:wrap is the escape hatch for when that row genuinely cannot fit.
   The row needs ~1000px; the only degrade rule was at 680px, so from 681px to
   ~1017px the nav ran off the right edge and dragged the WHOLE DOCUMENT into a
   horizontal scroll — every view, not just this one. Wrapping costs nothing
   above ~1017px (the items still fit one line, so the declaration never
   applies) and below it the tray button stays reachable instead of off-screen.
   The row-gap only exists once a second line does. */
#nav{position:sticky;top:0;z-index:20;display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;padding:9px clamp(14px,3vw,36px);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(10px);border-top:2px solid var(--accent);border-bottom:1px solid var(--line)}
#nav .brand{display:flex;align-items:center;gap:8px;font-size:var(--f4);font-weight:var(--w-bold);letter-spacing:-.03em;margin-right:4px}
#nav .brand .mark{width:24px;height:24px;border-radius:var(--r-sm);background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 50%,var(--claude)));display:grid;place-items:center;font-size:15px;color:var(--bg)}
/* THREE AREAS, THEN THE OPEN AREA'S SECTIONS ON THEIR OWN ROW. The areas
   wrapper keeps display:contents so the three buttons stay DIRECT flex items
   of #nav beside the brand, which is what puts them on the brand's row without
   a nested box of their own. The section strip is a real box at EVERY width:
   order:5 with a 100% basis puts it on its own line under the areas row, which
   is what "sections under the area" has to mean in layout and not only in
   wording.
   It keeps its own overflow, so a long section row scrolls inside itself
   instead of dragging the document, and revealActiveTab keeps the selected
   section on screen (a no-op while the row fits, which is the desktop case). */
.navareas{display:contents}
.navtabs{display:flex;order:5;flex:1 0 100%;gap:8px;overflow-x:auto;padding-bottom:2px;scrollbar-width:thin}
/* the closed areas stay in the DOM: their badges keep rendering and every
   data-v stays queryable, which is what lets the roll-up badge be honest. The
   open group is flex:none so a narrow pane SCROLLS the strip rather than
   squeezing the group — the squeeze would leave its buttons overflowing a box
   the strip does not know is too small, so nothing would scroll. */
.navsec{display:none}
.navsec.on{display:flex;flex:none;gap:8px}
/* an area of one page (Work, Chat, History) has no section row to show */
.navtabs.solo{display:none}
.navsec .navtab{flex:none}
/* an area is the quiet tier: card-filled when open, no accent — the accent
   belongs to the one selected section, so "where am I" stays a single mark. */
.navarea{padding:6px 13px;border-radius:var(--r-pill);border:1px solid transparent;cursor:pointer;font-weight:var(--w-med);font-size:var(--f2);color:var(--mut);background:none}
.navarea.on{color:var(--fg);border-color:var(--line2);background:var(--card)}
.navarea:hover:not(.on){color:var(--fg)}
.navtab{padding:6px 14px;border-radius:var(--r-pill);border:1px solid transparent;cursor:pointer;font-weight:var(--w-med);font-size:var(--f2);color:var(--mut);background:none}
.navtab.on{color:var(--accent);border-color:var(--accent);background:var(--card)}
.navtab:hover:not(.on){color:var(--fg)}
/* the chat tab's unread badge (owner_unread/mentions off every /api/chat poll):
   quiet count for plain unread, accent fill when an @mention addresses the
   owner — palette vars only, so both themes carry it. */
.navbadge{margin-left:7px;padding:1px 7px;border-radius:var(--r-pill);font-size:var(--f0);font-weight:var(--w-bold);font-variant-numeric:tabular-nums;background:var(--line2);color:var(--fg)}
.navbadge.mention{background:var(--accent);color:var(--bg)}
#nav .spacer{flex:1 1 auto}
/* stats: fixed label+value pairs, right-aligned, single row, never wraps */
#nav .stats{display:flex;gap:16px;font-size:var(--f1);color:var(--mut);white-space:nowrap;overflow:hidden}
#nav .stats .stat{display:flex;flex-direction:column;line-height:1.15;text-align:right}
#nav .stats .stat b{color:var(--fg);font-weight:var(--w-med);font-size:var(--f2)}
#nav .stats .stat span{font-size:var(--f0);color:var(--sub);text-transform:uppercase;letter-spacing:.04em}
/* THE OFFICE WEATHER (task/3902): the nav's last row, full width, at most two
   lines (the whole line is its title), coloured by the word. */
#navweather{order:20;flex:1 0 100%;font-size:var(--f1);line-height:1.35;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}
#navweather .wx-sunny{color:var(--ok)}
#navweather .wx-cloudy{color:var(--mut)}
#navweather .wx-stormy{color:var(--bad);font-weight:var(--w-med)}
#navweather .wx-unread{color:var(--sub)}
#nav .icon{width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--line);border-radius:var(--r-sm);background:var(--card);color:var(--mut);cursor:pointer;font-size:var(--f2);flex:none}
#nav .icon:hover{color:var(--fg);border-color:var(--line2)}
/* narrow screens (orca mobile is the primary touch surface — this is graceful
   degrade, not a mobile nav system): wrap the tabs and drop the spacer + stats
   so the theme/tray controls never slide off-screen. Placed after the base
   #nav rules so it wins on source order at matching specificity. */
/* WITHHOLDING MUST NOT REMOVE REACH. This rule used to display:none the stats,
   which deletes them from the page — on the surface the owner reads on a phone
   through Orca, and they carry real content (41 chars measured live, not a
   placeholder). They now become their own full-width row that scrolls INSIDE
   itself: reachable by a swipe, and its overflow stays in its own box rather
   than dragging the document, which is the bug the 680px rule was written to
   avoid in the first place.
   order:10 is load-bearing — without it the 100% basis pushes the theme/tray
   icons onto a THIRD line instead of sharing the first with the tabs. */
@media (max-width:680px){
  #nav{flex-wrap:wrap;gap:8px 10px}
  #nav .spacer{display:none}
  /* Ten tabs would wrap onto still more lines at 390px — the measured nine-tab
     layout already took THREE lines and four nav rows before any content on a
     phone. Since the three areas open one section group at a time, at most six
     sections are on that swipeable line now instead of ten.
     order 5 / 10 puts brand+controls first, then sections, then stats: a fixed
     three-row nav whose row meanings never shuffle as tab labels change. The
     section strip carries its own order/basis in the base rule; only the
     wrapping areas row needs anything here. */
  .navareas{display:flex;order:4;flex:1 0 100%;gap:4px;overflow-x:auto;scrollbar-width:thin}
  /* four areas and their badges fit 390px without the row scrolling */
  .navareas .navarea{flex:none;padding:6px 9px}
  #nav .stats{order:10;flex:1 0 100%;gap:14px;overflow-x:auto;padding-bottom:2px;scrollbar-width:thin}
  #nav .stats .stat{text-align:left;flex:none}
}

/* ---------- views ---------- */
.view{display:none}.view.on{display:block}
/* EVERY IN-PAGE TARGET LANDS BELOW THE STICKY NAVIGATION (task/3475): a
   link that scrolled a heading to the viewport top put it UNDER the nav.
   Zero specificity, so a target with its own clearance keeps it. */
:where(.view [id],.view .brow){scroll-margin-top:calc(var(--navh,48px) + 8px)}
.placeholder{padding:72px 20px;text-align:center;color:var(--mut)}
.placeholder .glyph{font-size:2rem;opacity:.4}
.empty{padding:24px;text-align:center;color:var(--mut)}

/* ---------- header (helm view) ---------- */
header{padding:18px 0 4px}
.brandrow{display:flex;align-items:center;gap:11px}
.brandrow .mark{width:30px;height:30px;border-radius:var(--r);background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 50%,var(--claude)));display:grid;place-items:center;font-size:18px;color:var(--bg)}
.brandrow h1{margin:0;font-size:var(--f5);font-weight:var(--w-bold);letter-spacing:-.03em}
.brandrow .stats{margin-left:auto;display:flex;gap:16px}
.brandrow .stats .stat{display:flex;flex-direction:column;text-align:right;line-height:1.15}
.brandrow .stats .stat b{color:var(--fg);font-weight:var(--w-med);font-size:var(--f3)}
.brandrow .stats .stat span{font-size:var(--f0);color:var(--sub);text-transform:uppercase;letter-spacing:.04em}
#hello{margin:9px 0 0;font-size:var(--f3);color:var(--mut)}
#hello b{color:var(--fg);font-weight:var(--w-med)}

/* ---------- banner ---------- */
#banner{display:none;margin:14px 0 0;padding:9px 14px;border:1px solid color-mix(in srgb,var(--warn) 55%,transparent);border-radius:10px;background:var(--card);color:var(--warn);font-size:var(--f2)}
#banner.show{display:block}
#stalebanner{display:none;margin:14px 0 0;padding:9px 14px;border:1px solid color-mix(in srgb,var(--warn) 45%,transparent);border-radius:10px;background:var(--card);color:var(--warn);font-size:var(--f2)}
#stalebanner.show{display:block}

/* ---------- readiness gauge (may forward work resume? `helm ready`) ---------- */
#readysec{margin:16px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1)}
#readysec .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
#readysec .rhead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
#readysec .rverdict{font-weight:700}
#readysec .rhow{margin-left:auto;color:var(--mut);font-size:var(--f0)}
#readysec .rok{color:var(--ok)}
#readysec .rbad{color:var(--bad)}
#readysec .runk{color:var(--warn);font-weight:700}
#readysec .rmut{color:var(--mut)}
.rrows{margin-top:7px;display:flex;flex-direction:column;gap:4px}
.rrow{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;padding:3px 8px;border-radius:8px;border-left:3px solid transparent;background:color-mix(in srgb,var(--fg) 4%,transparent)}
.rrow.rsok{border-left-color:var(--ok)}
.rrow.rsbad{border-left-color:var(--bad);background:color-mix(in srgb,var(--bad) 8%,transparent)}
.rrow.rsunk{border-left-color:var(--warn)}
.rrow .rsig{font-weight:700;min-width:64px}
.rrow .rstate{font-size:var(--f0);font-weight:700;min-width:56px}
.rrow .rev{color:var(--sub)}
.rrow .rnote,.rrow .rfix{flex-basis:100%;color:var(--mut);font-size:var(--f0)}
.rrow .rfix{color:var(--warn)}

/* ---------- guard refusals + the owner's dial (`helm friction`) ----------
   Palette tokens only, so both themes are one rule set. The status line and
   the value hold their size when empty or when the number gains a digit: a
   press must never move the button out from under the finger that made it. */
#frictionsec{margin:16px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f2)}
#frictionsec .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
#frictionsec .fhead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
#frictionsec .fhow{color:var(--mut);font-size:var(--f1)}
#frictionsec .fline{margin:6px 0 0}
#frictionsec .fmut{color:var(--mut);font-size:var(--f1)}
#frictionsec .fwarn{color:var(--warn);font-weight:var(--w-med)}
#frictionsec .fguards{margin:4px 0 0;padding:0 0 0 18px}
#frictionsec .fguard{font-family:var(--mono);font-size:.9em}
#frictionsec .fdial{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0 0}
#frictionsec .fstep{width:44px;height:44px;border:1px solid var(--line2);border-radius:var(--r);background:var(--elev);color:var(--fg);font-size:var(--f5);line-height:1;cursor:pointer}
#frictionsec .fstep:hover:not(:disabled){border-color:var(--accent);background:var(--hover)}
#frictionsec .fstep:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
#frictionsec .fstep:disabled{opacity:.4;cursor:not-allowed}
#frictionsec .fval{display:inline-block;min-width:3ch;text-align:center;font-size:var(--f5);font-weight:var(--w-bold)}
#frictionsec .fwho{color:var(--mut);font-size:var(--f1);flex:1 1 220px}
#frictionsec .fmsg{margin:6px 0 0;min-height:1.5em;font-size:var(--f1)}
#frictionsec .fmsg.fok{color:var(--ok)}
#frictionsec .fmsg.fbad{color:var(--bad)}

/* ---------- away mode (the owner's away flag + notice to every agent) ----------
   A phone is his door: 44px targets, rows that wrap, a text box that fills the
   width, and a status line that keeps its height so nothing moves under a
   finger after a press. */
#posturesec{margin:16px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f2)}
#posturesec .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
#posturesec .phead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
#posturesec .phow{color:var(--mut);font-size:var(--f1)}
#posturesec .psub{margin:12px 0 0}
#posturesec .pline{margin:6px 0 0}
#posturesec .pmut{color:var(--mut);font-size:var(--f1)}
#posturesec .pwarn{color:var(--warn);font-weight:var(--w-med)}
#posturesec .ptext{font-style:italic}
#posturesec .prow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0 0}
#posturesec .pbtn{min-height:44px;padding:0 16px;border:1px solid var(--line2);border-radius:var(--r);background:var(--elev);color:var(--fg);font-size:var(--f2);font-weight:var(--w-med);cursor:pointer}
#posturesec .pbtn:hover:not(:disabled){border-color:var(--accent);background:var(--hover)}
#posturesec .pbtn:focus-visible,#posturesec .ppre:focus-visible,#posturesec .pnote:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
#posturesec .pbtn.psec{background:transparent;color:var(--sub)}
#posturesec .ppres{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
#posturesec .ppre{min-height:44px;padding:0 12px;border:1px dashed var(--line2);border-radius:var(--r);background:transparent;color:var(--sub);font-size:var(--f1);cursor:pointer}
#posturesec .pnote{box-sizing:border-box;display:block;width:100%;margin:8px 0 0;padding:8px 10px;border:1px solid var(--line2);border-radius:var(--r);background:var(--elev);color:var(--fg);font:inherit;font-size:var(--f2);resize:vertical}
#posturesec .pmsg{margin:6px 0 0;min-height:1.5em;font-size:var(--f1)}
#posturesec .pmsg:empty{display:none}
#posturesec .pfold{display:inline-block;margin:6px 16px 0 0;vertical-align:top}
#posturesec .pfold[open]{display:block}
#posturesec .pfold>summary{cursor:pointer;color:var(--sub);font-size:var(--f1)}
#posturesec .pfold>summary:hover{color:var(--fg)}
#posturesec .pmsg.pok{color:var(--ok)}
#posturesec .pmsg.pbad{color:var(--bad)}

/* ---------- fleet notes (what the fleet left the owner; `helm note`) ---------- */
#notesec{display:none;margin:16px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1)}
#notesec.show{display:block}
#notesec .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
#notesec .nhead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
#notesec .ncount{color:var(--sub);font-size:var(--f1)}
#notesec .nhow{margin-left:auto;color:var(--mut);font-size:var(--f0)}
.nrows{margin-top:7px;display:flex;flex-direction:column;gap:6px}
.nrow{padding:6px 8px;border-radius:8px;background:color-mix(in srgb,var(--fg) 4%,transparent)}
.nrow .nkey{font-weight:700;color:var(--accent)}
.nrow .nmeta{color:var(--mut);font-size:var(--f0);font-variant-numeric:tabular-nums}
.nrow .nheadline{margin-top:2px;color:var(--fg);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nrow details{margin-top:3px;color:var(--sub)}
.nrow details summary{cursor:pointer;font-size:var(--f0);color:var(--mut)}
.nrow .ndetail{padding:4px 0 1px;white-space:pre-wrap;word-break:break-word}
.nrow .ngoto{display:inline-block;margin-top:4px;color:var(--accent);font-size:var(--f0);font-weight:700;text-decoration:none}
.nrow .ngoto:hover{text-decoration:underline}
/* the older-notes fold: DIMMED, never hidden. A stale note is one click away
   and its rows render identically inside — same key, author, age and detail. */
#notesec .nolder{margin-top:8px;border-top:1px solid var(--line);padding-top:6px}
#notesec .nolder summary{cursor:pointer;color:var(--mut);font-size:var(--f0);list-style:revert}
#notesec .nolder summary:hover{color:var(--sub)}
#notesec .nolder .nrow{opacity:.72}

/* ---------- store strip ---------- */
#store{display:none;margin:16px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;align-items:baseline;gap:4px 16px;flex-wrap:wrap;font-size:var(--f1)}
#store.show{display:flex}
#store .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
.stype{white-space:nowrap;color:var(--mut)}
.stype b{color:var(--fg);font-variant-numeric:tabular-nums;margin-right:4px}
#store .stot{margin-left:auto;color:var(--sub);font-size:var(--f1)}
#sessions{display:none;margin:10px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1)}
#sessions.show{display:block}
#sessions .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}

/* ---------- skills strip (collapsible; enable/disable/delete) ---------- */
#skillsec{display:none;margin:10px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1)}
#skillsec.show{display:block}
#skillsec .slabel{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
#skillsec .shead{display:flex;align-items:baseline;gap:10px;cursor:pointer;user-select:none}
#skillsec .scount{color:var(--sub);font-size:var(--f1)}
#skillsec .chev{margin-left:auto;color:var(--sub);font-size:var(--f0);transition:transform .15s}
#skillsec.open .chev{transform:rotate(90deg)}
.skrows{display:none;margin-top:6px;flex-direction:column}
#skillsec.open .skrows{display:flex}
.skrow{display:flex;align-items:center;gap:9px;padding:3px 6px;border-radius:8px;overflow:hidden}
.skrow:hover{background:var(--hover)}
.skrow .skname{font-weight:600;min-width:11em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.skrow.off .skname{color:var(--mut);font-weight:500}
.skrow .skhome{color:var(--sub);font:var(--f1) ui-monospace,Menlo,Consolas,monospace;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}
.skflag{flex:none;font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 7px;border-radius:5px;white-space:nowrap}
.skflag.off{background:color-mix(in srgb,var(--mut) 16%,transparent);color:var(--mut)}
.skflag.shadowed{background:color-mix(in srgb,var(--warn) 16%,transparent);color:var(--warn)}
.skflag.diverged{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}
.skbtn{flex:none;border:1px solid var(--line);border-radius:8px;padding:2px 10px;background:transparent;color:var(--mut);font:var(--f1) inherit;cursor:pointer;transition:border-color .12s,color .12s}
.skbtn:hover{border-color:var(--line2);color:var(--fg)}
.skbtn.armed{border-color:var(--bad);color:var(--bad);background:color-mix(in srgb,var(--bad) 12%,transparent)}
.skbtn.failed{border-color:var(--bad);color:var(--bad)}
.srows{margin-top:6px;display:flex;flex-direction:column}
.srow{display:flex;align-items:baseline;gap:10px;padding:3px 6px;border-radius:8px;cursor:copy;overflow:hidden}
.srow:hover{background:var(--line)}
.srow.copied{outline:1px solid var(--sub)}
.srow .sage{color:var(--sub);font-size:var(--f1);min-width:3.2em;font-variant-numeric:tabular-nums}
.srow .sproj{color:var(--mut);min-width:9em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.srow .stitle{color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}

/* ---------- controls ---------- */
#controls{display:flex;gap:8px;align-items:center;margin:16px 0 0;flex-wrap:wrap}
#q{flex:1 1 240px;min-width:180px;background:var(--card);border:1px solid var(--line);color:var(--fg);border-radius:10px;padding:9px 13px;font-size:var(--f3);outline:none}
#q:focus{border-color:var(--accent)}
#q::placeholder{color:var(--sub)}
.tog{border:1px solid var(--line);border-radius:16px;padding:5px 13px;background:var(--card);color:var(--mut);font:var(--f1) inherit;cursor:pointer;display:none}
.tog.avail{display:inline-block}
.tog.on{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
#count{color:var(--sub);font-size:var(--f1);margin-left:auto;white-space:nowrap}

/* ---------- the project light (the dot that leads every board row) ---------- */
.dot{width:9px;height:9px;border-radius:50%;flex:none;align-self:center;background:var(--sub)}
.dot.active{background:var(--ok);box-shadow:0 0 6px color-mix(in srgb,var(--ok) 60%,transparent)}
.dot.dormant{background:var(--sub);opacity:.55}
.dot.external{background:var(--ext)}
/* The AUTHORED half of the same light. `green` is what `active` always meant,
   so it renders identically; yellow/orange/red are the three things only a
   person can say. The ring is the provenance made visible — without it a
   glance cannot tell a decision from an observation. */
.dot.green{background:var(--ok);box-shadow:0 0 6px color-mix(in srgb,var(--ok) 60%,transparent)}
.dot.yellow{background:#d9a441;box-shadow:0 0 6px color-mix(in srgb,#d9a441 60%,transparent)}
.dot.orange{background:#d97a2b;box-shadow:0 0 6px color-mix(in srgb,#d97a2b 60%,transparent)}
.dot.red{background:#c4503c;box-shadow:0 0 6px color-mix(in srgb,#c4503c 60%,transparent)}
.dot.authored{outline:2px solid color-mix(in srgb,var(--fg) 28%,transparent);outline-offset:2px}
.hchip{font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:2.5px 8px;border-radius:5px;white-space:nowrap}
.h-claude{background:color-mix(in srgb,var(--claude) 18%,transparent);color:var(--claude)}
.h-codex{background:color-mix(in srgb,var(--codex) 18%,transparent);color:var(--codex)}
.h-opencode{background:color-mix(in srgb,var(--opencode) 20%,transparent);color:var(--opencode)}
.h-pi{background:color-mix(in srgb,var(--pi) 20%,transparent);color:var(--pi)}
.h-other{background:color-mix(in srgb,var(--mut) 18%,transparent);color:var(--mut)}
.lchip{font-size:var(--f0);padding:2.5px 8px;border-radius:5px;color:var(--accent);background:var(--accent-soft);white-space:nowrap}
.ppath{margin:4px 0 0;font:var(--f1) ui-monospace,Menlo,Consolas,monospace;color:var(--sub);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ---------- an open board row's sections (see 72-board.css.part) ---------- */
.lightrow{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.setlight{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border:1px solid var(--line);border-radius:6px;background:transparent;color:inherit;cursor:pointer}
.setlight:hover,.setlight:focus-visible{border-color:var(--accent)}
.setlight.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent)}
.lightwhy{width:100%;box-sizing:border-box;padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:transparent;color:inherit;font:inherit}
.lightmsg:empty{display:none}
.dsec{break-inside:avoid;margin:0 0 12px}
.dsec h4{margin:0 0 4px;font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--sub)}
.dline{font-size:var(--f1);color:var(--mut);margin:2px 0;word-break:break-all}
.dline.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:var(--f1)}
.dline b{color:var(--fg);font-weight:600}
/* THE PANE'S THREE NON-ANSWERS, EACH VISIBLY ITS OWN. What is on file for a
   project is fetched when its row opens, so the pane has states no other section has:
   waiting on the door, read-and-empty, and could-not-read. They are drawn
   differently because they mean different things — an owner who cannot tell
   "nothing on file" from "the fetch failed" will read a broken pane as a fact
   about his project. */
.dmore[data-state=pending] .dline{opacity:.55;font-style:italic}
.dmore[data-state=none] .dline{opacity:.7}
.dmore[data-state=failed] .dline{color:var(--bad);cursor:pointer}
.edge .rel{color:var(--accent);font-weight:600}
.edge .enote{color:var(--sub);font-style:italic}
.unconf{color:var(--warn);font-size:var(--f0);font-style:normal}
.copy{cursor:copy;border-radius:5px;padding:0 3px;margin:0 -3px}
.copy:hover{background:var(--hover);color:var(--fg)}
.copy.did{color:var(--ok)}

/* ---------- empty / footer ---------- */
#empty{display:none;padding:52px 20px;text-align:center;color:var(--mut)}
#empty.show{display:block}
#empty .glyph{font-size:2rem;opacity:.4}
footer{margin:26px 0 46px;font-size:var(--f1);color:var(--sub);display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
footer .fmark{color:color-mix(in srgb,var(--accent) 70%,var(--sub))}

