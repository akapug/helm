/* ================= chat view (simple DOM — works from the Orca mobile browser) ================= */
#chatcard{margin:14px 0 0;background:var(--card);border:1px solid var(--line);border-radius:14px;display:flex;height:calc(100dvh - 130px);min-height:300px}
#chatrooms{flex:0 0 var(--railw,172px);display:flex;flex-direction:column;border-right:1px solid var(--line);padding:8px 6px;min-width:0}
@media (max-width:560px){#chatrooms{flex-basis:116px}}
#chatroomlist{flex:1;overflow-y:auto;overflow-x:hidden}
/* section header — melds are SEPARATE, not hidden (owner ruling) */
.crsec{display:flex;align-items:center;gap:6px;margin:10px 0 2px;padding:0 8px;
  font-size:calc(var(--f1) - 1px);letter-spacing:.08em;text-transform:uppercase;
  color:var(--mut);opacity:.7}
.crsecn{opacity:.6}
.crsec.crfold{cursor:pointer}
.crsec.crfold:hover{opacity:1;color:var(--fg)}
.crsec.crfold .crn{margin-left:auto;padding:0 6px;border-radius:var(--r-pill);font-size:var(--f0);font-weight:var(--w-bold);font-variant-numeric:tabular-nums;background:var(--line2);color:var(--fg);letter-spacing:0}
.crsec.crfold .crn.mention{background:var(--accent);color:var(--bg)}
/* the quiet-group row — folded rooms live BEHIND it, expandable, never gone */
.crquiet{padding:4px 8px;border-radius:8px;font-size:var(--f0);color:var(--sub);cursor:pointer;font-variant-numeric:tabular-nums}
.crquiet:hover{background:var(--hover);color:var(--fg)}
.crquiet.open{color:var(--mut)}
/* inline member dots on a meld row — presence at a glance, one row per meld */
.crm .crsn i{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--line2);margin:0 1px;vertical-align:middle}
.crm .crsn i.fresh{background:var(--ok,#3fb96b)}
.crm .crsn i.quiet{background:var(--warn,#d9a13b)}
/* the drag handle between a rail and its pane (chat + configs share it) */
.raildrag{flex:0 0 6px;align-self:stretch;cursor:col-resize;border-radius:3px;touch-action:none}
.raildrag:hover,.raildrag.live{background:var(--accent-soft)}
.crm{display:flex;align-items:center;flex-wrap:wrap;gap:6px;padding:5px 8px;border-radius:8px;font-size:var(--f1);color:var(--mut);cursor:pointer}
.crm:hover{background:var(--hover);color:var(--fg)}
.crm.on{color:var(--accent);background:var(--accent-soft);font-weight:var(--w-med)}
.crm .crname{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.crm .crn{padding:0 6px;border-radius:var(--r-pill);font-size:var(--f0);font-weight:var(--w-bold);font-variant-numeric:tabular-nums;background:var(--line2);color:var(--fg)}
.crm .crn.mention{background:var(--accent);color:var(--bg)}
.crm .crsn{padding:0 5px 0 3px;border-radius:var(--r-pill);font-size:var(--f0);color:var(--sub);background:var(--line2);flex:0 0 auto;font-variant-numeric:tabular-nums;opacity:.75}
.crm .crsn:hover{opacity:1;color:var(--fg)}
.crm .crsn.live{color:var(--ok,#3fb96b)}
.crm.open .crsn{opacity:1}
.crm .crseats{flex-basis:100%;display:flex;flex-wrap:wrap;gap:3px;margin-top:2px}
.crm .crseat{font-size:var(--f0);color:var(--mut);display:flex;align-items:center;gap:3px;min-width:0}
.crm .crseat i{width:6px;height:6px;border-radius:50%;background:var(--line2);flex:0 0 auto}
.crm .crseat.fresh i{background:var(--ok,#3fb96b)}
.crm .crseat.quiet i{background:var(--warn,#d9a13b)}
.crm .crseat span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.crm .crseat .crrt{color:var(--sub);font-size:.9em;flex:none}
#chatnewroom{margin-top:6px;width:100%;box-sizing:border-box;background:var(--bg);border:1px solid var(--line);color:var(--fg);border-radius:8px;padding:5px 8px;font-size:var(--f1)}
#chatnewroom:focus{border-color:var(--accent);outline:none}
#chatmain{flex:1;display:flex;flex-direction:column;min-width:0}
/* the fleet presence STRIP — one glance line; click it for the full dense
   roster table (its own tab). Replaced the ICQ-style multi-row bar, which was
   duplicate roster ink — the roster tab is the one home for it now. */
#chatpresence{flex:0 0 auto;border-bottom:1px solid var(--line);padding:5px 12px;font-size:var(--f1);color:var(--mut);cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#chatpresence:hover{background:var(--hover)}
#chatpresence .psseat{color:var(--fg);font-weight:var(--w-med)}
#chatpresence .psrt{color:var(--sub);font-size:.9em}
#chatpresence .psmore{color:var(--sub)}
#chatpresence .pslink{color:var(--accent)}
#chatlog{flex:1;overflow-y:auto;padding:14px 16px}
.chatmsg{margin:0 0 10px;font-size:var(--f2)}
.chatmsg .cwho{font-weight:700}
.chatmsg.owner .cwho{color:var(--accent)}
.chatmsg .cts{font-size:var(--f0);color:var(--sub);margin-left:7px;font-variant-numeric:tabular-nums}
.chatmsg .ctxt{white-space:pre-wrap;word-break:break-word}
.chatmsg .ctick{font-size:var(--f0);color:var(--sub);margin-left:6px;cursor:default}
.chatmsg .cdiag{font-size:var(--f0);color:var(--bad);margin:2px 0 0;border-left:2px solid var(--bad);padding-left:6px}
.chatmsg .creacts{font-size:var(--f1);margin:2px 0 0 2px;color:var(--sub)}
.chatmsg .creacts span{margin-right:8px}
.chatmsg .rbar{display:none;font-size:var(--f1);margin-left:8px}
.chatmsg:hover .rbar{display:inline}
.chatmsg .rbtn{cursor:pointer;border:none;background:none;padding:0 2px;font-size:var(--f1);opacity:.55}
.chatmsg .rbtn:hover{opacity:1}
#chattransport{font-size:var(--f0);color:var(--sub);align-self:center;white-space:nowrap}
#chatbar{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--line);flex-wrap:wrap}
#chatname{flex:0 1 110px;min-width:70px;background:var(--bg);border:1px solid var(--line);color:var(--fg);border-radius:9px;padding:8px 10px;font-size:var(--f2)}
#chattext{flex:1 1 200px;background:var(--bg);border:1px solid var(--line);color:var(--fg);border-radius:9px;padding:8px 12px;font-size:var(--f3)}
#chattext:focus,#chatname:focus{border-color:var(--accent);outline:none}
/* ---- threading + the owner UX pass (additive: nothing above is restyled) ---- */
#chatmain{position:relative}
.chatmsg .cquote{display:flex;gap:6px;align-items:baseline;font-size:var(--f1);color:var(--sub);border-left:2px solid var(--line2);padding:1px 0 1px 7px;margin:0 0 2px;cursor:pointer;max-width:100%}
.chatmsg .cquote:hover{border-left-color:var(--accent);color:var(--fg)}
.chatmsg .cquote b{font-weight:var(--w-med);flex:0 0 auto}
.chatmsg .cquote span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chatmsg .cquote.orphan{cursor:default;font-style:italic;opacity:.7}
.chatmsg.flash{background:var(--accent-soft);border-radius:8px}
.chatmsg .creplies:not(:empty){display:inline-block;font-size:var(--f0);color:var(--sub);margin-left:7px;cursor:pointer}
.chatmsg .creplies:hover{color:var(--accent)}
.chatmsg .ctxt.clamp{max-height:14em;overflow:hidden;-webkit-mask-image:linear-gradient(180deg,#000 70%,transparent);mask-image:linear-gradient(180deg,#000 70%,transparent)}
.chatmsg .cmore{border:none;background:none;color:var(--accent);font-size:var(--f0);cursor:pointer;padding:2px 0}
.chatmsg .cmore:hover{text-decoration:underline}
#chatdivider{display:flex;align-items:center;gap:8px;margin:10px 0;color:var(--bad);font-size:var(--f0);text-transform:uppercase;letter-spacing:.06em}
#chatdivider:before,#chatdivider:after{content:"";flex:1;height:1px;background:var(--bad);opacity:.5}
#chatjump{position:absolute;right:16px;bottom:64px;z-index:3;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:var(--r-pill);padding:5px 12px;font-size:var(--f1);cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.25)}
#chatjump:hover{border-color:var(--accent);color:var(--accent)}
#chatreply{display:flex;align-items:center;gap:8px;padding:6px 12px;border-top:1px solid var(--line);font-size:var(--f1);color:var(--sub);min-width:0}
#chatreply b{color:var(--fg);font-weight:var(--w-med);flex:0 0 auto}
#chatreply .rqt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#chatreply button{margin-left:auto;border:none;background:none;color:var(--sub);cursor:pointer;font-size:var(--f2)}
#chatreply button:hover{color:var(--bad)}
#chatac{border-top:1px solid var(--line);max-height:170px;overflow-y:auto}
#chatac .acr{display:flex;gap:8px;align-items:center;padding:5px 12px;font-size:var(--f2);cursor:pointer}
#chatac .acr.on,#chatac .acr:hover{background:var(--hl)}
#chatac .acr i{width:6px;height:6px;border-radius:50%;background:var(--line2);flex:0 0 auto}
#chatac .acr.fresh i{background:var(--ok,#3fb96b)}
#chatac .acr.quiet i{background:var(--warn,#d9a13b)}
#chatac .acr .acage{margin-left:auto;color:var(--sub);font-size:var(--f0)}
#chatlegend{font-size:var(--f0);color:var(--sub);padding:6px 2px 0;line-height:1.5;border-top:1px solid var(--line);margin-top:6px}
#chatlegend i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--line2);margin-right:3px}
#chatlegend i.fresh{background:var(--ok,#3fb96b)}
#chatlegend i.quiet{background:var(--warn,#d9a13b)}
.crm .crage{font-size:var(--f0);color:var(--sub);font-variant-numeric:tabular-nums;flex:0 0 auto}
.crm.hot .crname{color:var(--fg);font-weight:var(--w-med)}
.crm.cold{opacity:.62}
/* one seat per line, name ellipsized, age pinned right — a 172px rail must
   still say WHICH seat and HOW LONG AGO (the truncation the owner flagged) */
.crm .crseat{flex:1 1 100%;min-width:0}
.crm .crseat>span{flex:0 1 auto;min-width:0}
.crm .crseat b{margin-left:auto;flex:0 0 auto;font-weight:400;font-variant-numeric:tabular-nums;padding-left:4px}

