/* ================= configs view (CSS ported from the predecessor, on helm's variables) ================= */
#cfgbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:14px 0 12px}
#cfgFilter{flex:1;min-width:200px;padding:7px 12px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:var(--f2)}
#cfgFilter:focus{border-color:var(--accent);outline:none}
.cfgmut{font-size:var(--f1);color:var(--mut)}
#cfgsplit{display:grid;grid-template-columns:var(--railw,minmax(280px,38%)) 6px 1fr;gap:16px 5px;align-items:start}
@media(max-width:820px){#cfgsplit{grid-template-columns:1fr}#cfgraildrag{display:none}}
#cfgtree,#cfgdetail{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;max-height:76vh;overflow:auto}
.cfgnode{user-select:none}
.cfgrow{display:flex;align-items:center;gap:6px;padding:3px 5px;border-radius:6px;cursor:pointer;font-size:var(--f2);white-space:nowrap}
.cfgrow:hover{background:var(--hl)}
.cfgrow.sel{background:var(--accent);color:var(--bg)}
.cfgrow.sel .cfgbadge{border-color:var(--bg);color:var(--bg)}
.cfgtw{display:inline-block;width:12px;color:var(--mut);text-align:center}
.cfgname{font-weight:600}
.cfgkids{margin-left:14px;border-left:1px solid var(--line);padding-left:4px}
.cfgbadge{font-size:var(--f0);border:1px solid var(--line);border-radius:5px;padding:0 4px;color:var(--mut);font-weight:700;letter-spacing:.03em}
.cfgbadge.mcp{color:#5470c6;border-color:#5470c6}.cfgbadge.hooks{color:#b4442e;border-color:#b4442e}
.cfgbadge.memory{color:#3f7d54;border-color:#3f7d54}.cfgbadge.settings{color:#b58a2e;border-color:#b58a2e}
.cfgbadge.rule{color:#8a5fc0;border-color:#8a5fc0}
.cfgsec{margin:0 0 16px}
.cfgsec h4{font-size:var(--f0);text-transform:uppercase;letter-spacing:.06em;color:var(--mut);margin:0 0 6px;border-bottom:1px solid var(--line);padding-bottom:4px}
details.cfgsec>summary{cursor:pointer;font-size:var(--f0);text-transform:uppercase;letter-spacing:.06em;color:var(--mut);border-bottom:1px solid var(--line);padding-bottom:4px;margin-bottom:6px;list-style:revert}
details.cfgsec>summary:hover{color:var(--fg)}
/* store review — the candidate + provisional owner queue (near configs) */
/* owner decision queue — the storerev idiom, first section of the WORK tab */
#odqbadge{flex:none}
#odqbadge a{text-decoration:none;border-color:var(--accent);color:var(--accent);font-weight:700}
#odq{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:14px 0 16px}
#odqhead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
#odqlist{display:flex;flex-direction:column;gap:8px}
.odqcard{border:1px solid var(--line);border-radius:9px;padding:9px 11px;background:var(--bg);transition:opacity .12s}
.odqtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
/* a task title can carry one unbreakable token (a dotted test id), and on a
   phone that token pushed the whole Work page sideways */
.odqtitle{font-weight:700;min-width:0;overflow-wrap:anywhere}
#view-work .cfgmut,.odqmeta>span{min-width:0;overflow-wrap:anywhere}
.odqid{font-size:var(--f0);color:var(--mut)}
/* "you asked" — the owner's own provenance mark. Accent-soft so it reads as
   an identity, not an alarm: these rows are not more URGENT than the rest,
   they are HIS, and the whole point is that he can pick them out of a long
   backlog at a glance. Legacy rows carry no mark at all (see 50-work.js). */
.otqasked{font-size:var(--f0);font-weight:700;color:var(--accent);background:var(--accent-soft);border-radius:var(--r-sm,6px);padding:1px 6px;white-space:nowrap}
/* THE RANK CHIP. P0 borrows the warn colour because a fleet blocker should
   read differently from an ordinary rank at a glance; P1..P3 share one muted
   treatment, because the distinction the eye needs first is "is this the
   urgent one", not four shades. An UNRANKED row draws no chip at all. */
.otqrank{font-size:var(--f0);font-weight:700;border-radius:var(--r-sm,6px);padding:1px 6px;white-space:nowrap;color:var(--fg-mut,#888);border:1px solid var(--bd,#333)}
.otqrankP0{color:var(--warn,#e5534b);border-color:var(--warn,#e5534b)}
/* THE QUEUE HEADER (task/2622). Numbers first, big enough to read from the
   pane split beside the integrator without leaning in — the owner reads
   totals here, never row text. It renders in TWO places off one function
   (this card's head and the board home's band cell), so the classes are
   UNSCOPED: scoping them under #otq would style the card and leave the band
   cell bare, which is how one headline becomes two. */
.tqhead{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:0 0 9px;font-size:var(--f1)}
.tqn{white-space:nowrap;color:var(--fg)}
.tqn b{font-variant-numeric:tabular-nums;font-weight:700;font-size:var(--f2)}
.tqmut{color:var(--mut)}
.tqwarn{color:var(--warn,#e5534b)}
/* UNKNOWN IS NOT A SMALL NUMBER. When a read fails, carries no totals, or goes
   past this card's freshness bound, every field of the headline renders the
   WORD — and it has to LOOK different from a count, because a reader scanning
   for five numbers must not mistake "we cannot say" for "it is low". Same
   class in both places the line renders, unscoped for the reason above. */
.tqunk{color:var(--warn,#e5534b)}
.tqunk b{font-variant-numeric:normal;font-size:var(--f1);letter-spacing:.02em}
.tqchips{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 10px}
.tqchip.on{border-color:var(--accent);color:var(--accent);font-weight:700}
/* UNOWNED IS LOUD BECAUSE IT IS ACTIONABLE, not because it is broken: the row
   is in the pool an idle seat may take. Warn colour, no background — an alarm
   chip on a third of a 477-row board would make the board itself read red. */
.tqunowned{font-weight:700;color:var(--warn,#e5534b)}
.tqstale{font-size:var(--f0);font-weight:700;color:var(--warn,#e5534b);border:1px solid var(--warn,#e5534b);border-radius:var(--r-sm,6px);padding:0 5px;white-space:nowrap}
/* The row's own edge, not a fill: a stale row must be findable while scrolling
   and must not shout over the rank chip that says how much it matters. */
.tqstalerow{border-left:2px solid var(--warn,#e5534b)}
.tqlastnote{color:var(--mut);font-size:var(--f1)}
.tqlastnote b{color:var(--fg)}
/* The comment disclosure. Prose is the point here, so the body gets reading
   width and preserved newlines rather than the meta row's terse flex. */
.otqnotes{margin:6px 0 2px;font-size:var(--f1)}
.otqnotes>summary{cursor:pointer;color:var(--mut)}
.otqnotes>summary:hover{color:var(--fg)}
.otqnotebody{margin:6px 0 2px;display:flex;flex-direction:column;gap:8px}
.otqnote{border-left:2px solid var(--line2);padding-left:9px}
.otqnoteby{font-weight:700}
.otqnotetext{margin-top:3px;white-space:pre-wrap;word-break:break-word;color:var(--fg)}
.odqctx{margin:6px 0 4px;font-size:var(--f2);color:var(--fg);word-break:break-word;white-space:pre-wrap}
.odqmeta{font-size:var(--f1);color:var(--mut);display:flex;gap:12px;flex-wrap:wrap}
.odqopts{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.odqopt{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.odqopt .chip.rec{border-color:var(--accent);color:var(--accent);font-weight:700}
.odqcons{font-size:var(--f1);color:var(--mut)}
.odqacts{display:flex;align-items:center;gap:6px;margin-top:8px;flex-wrap:wrap}
.odqcomment{flex:1;min-width:140px;padding:5px 9px;border-radius:7px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:var(--f1)}
.odqcomment:focus{border-color:var(--accent);outline:none}
.odqundeliv{font-size:var(--f1);color:#b4442e;margin-top:6px}
#storerev{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin:14px 0 16px}
#storerevhead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
#storerevlist{display:flex;flex-direction:column;gap:8px}
.srevrow{border:1px solid var(--line);border-radius:9px;padding:9px 11px;background:var(--bg);transition:opacity .12s}
.srevtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.srevbadge{font-size:var(--f0);border-radius:5px;padding:1px 6px;font-weight:700;letter-spacing:.03em;text-transform:uppercase}
.srevbadge.candidate{color:#b58a2e;border:1px solid #b58a2e}
.srevbadge.provisional{color:#3f7d54;border:1px solid #3f7d54}
.srevtype{font-size:var(--f0);color:var(--mut);border:1px solid var(--line);border-radius:5px;padding:0 4px;font-weight:700}
.srevid{font-weight:700}
.srevstmt{margin:6px 0 4px;font-size:var(--f2);color:var(--fg);word-break:break-word}
.srevmeta{font-size:var(--f1);color:var(--mut);display:flex;gap:12px;flex-wrap:wrap}
.srevacts{display:flex;align-items:center;gap:6px;margin-top:8px;flex-wrap:wrap}
.srevreason{flex:1;min-width:140px;padding:5px 9px;border-radius:7px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:var(--f1)}
.srevreason:focus{border-color:var(--accent);outline:none}
.chip.srevok{border-color:#3f7d54;color:#3f7d54}
.chip.srevno{border-color:#b4442e;color:#b4442e}
.cfgitem{display:flex;align-items:center;gap:8px;padding:5px 6px;border-radius:7px;font-size:var(--f2)}
.cfgitem:hover{background:var(--hl)}
.cfgitem .src{font-size:var(--f0);color:var(--mut);margin-left:auto;white-space:nowrap}
.cfgitem.cfgshadow{opacity:.5}
.cfgitem.cfgshadow b{text-decoration:line-through}
.cfgitem.cfgshadow .src{color:var(--bad)}
.cfgfile{cursor:pointer;color:var(--accent);text-decoration:underline;text-decoration-style:dotted}
.cfgcascade{list-style:none;margin:0;padding:0}
.cfgcascade li{position:relative;padding:4px 0 4px 20px;font-size:var(--f2)}
.cfgcascade li:before{content:"↳";position:absolute;left:4px;color:var(--mut)}
.cfgcascade li:first-child:before{content:"⌂"}
.cfgwarn{background:color-mix(in srgb,var(--bad) 12%,transparent);border:1px solid var(--bad);border-radius:8px;padding:8px 10px;font-size:var(--f1);margin:4px 0;color:var(--fg)}
.cfged{margin-top:10px}
.cfged textarea{width:100%;min-height:280px;font:var(--f1) ui-monospace,Menlo,monospace;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--fg);padding:10px;resize:vertical;box-sizing:border-box}
.cfgedbar{display:flex;gap:8px;align-items:center;margin:8px 0;flex-wrap:wrap}
.cfgpath{font:var(--f1) ui-monospace,monospace;color:var(--mut);word-break:break-all}
.cfgro{color:var(--bad);font-size:var(--f1);font-weight:700}
.cfgpick{padding:5px 10px;border-radius:7px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:var(--f1)}
.cfgdiff{font:var(--f1) ui-monospace,Menlo,monospace;word-break:break-all;padding:2px 6px;border-radius:6px}
.cfgdiff.add{color:var(--ok)}.cfgdiff.del{color:var(--bad)}.cfgdiff.chg{color:var(--warn)}

