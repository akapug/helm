/* the injection pack — what helm put in a seat's context, and the doors to
   change it. The totals band leads because the owner reads TOTALS: four
   numbers he can compare sit above every row of text on the page, and the
   agent-to-agent prose (an entry's statement, the per-turn evidence) is one
   disclosure below them. A table that opened with sixty rows of premise text
   would be true and unread. */
.ipktot{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 10px}
.ipkbig{flex:1 1 120px;background:var(--card);border:1px solid var(--line);
  border-radius:10px;padding:10px 12px;min-width:110px}
.ipkbig b{display:block;font-size:22px;line-height:1.15;font-variant-numeric:tabular-nums}
.ipkbig span{display:block;font-size:11px;opacity:.7;margin-top:3px}
.ipkline{font-size:12px;opacity:.85;margin:0 0 8px}
.ipklane{display:inline-block;margin:0 10px 6px 0;font-size:12px;
  font-variant-numeric:tabular-nums}
.ipklane i{font-style:normal;opacity:.6;margin-right:4px}
.ipktab{width:100%;border-collapse:collapse;font-size:12px}
.ipktab th{text-align:left;font-weight:600;opacity:.6;font-size:11px;
  padding:4px 6px;border-bottom:1px solid var(--line)}
.ipktab td{padding:4px 6px;border-bottom:1px solid var(--line);vertical-align:top}
.ipktab td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.ipkid{word-break:break-word}
.ipktext{display:block;opacity:.6;font-size:11px;margin-top:2px}
.ipkact{background:transparent;border:1px solid var(--line);border-radius:6px;
  cursor:pointer;font:inherit;font-size:11px;padding:1px 7px;margin:0 3px 2px 0;
  color:inherit}
.ipkact:hover{border-color:currentColor}
.ipkform{margin-top:4px;display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.ipkform input{flex:1 1 180px;min-width:120px;font:inherit;font-size:11px;
  padding:2px 6px;border:1px solid var(--line);border-radius:6px;
  background:var(--card);color:inherit}
.ipkwhy{font-size:11px;opacity:.75;margin-top:4px}
