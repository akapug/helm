/* ================= ledger view (the turn ledger + seat activity, on helm's variables) ================= */
#ledgerstrip{display:flex;gap:14px;flex-wrap:wrap;align-items:baseline;margin:14px 0 0;padding:9px 14px;background:var(--card);border:1px solid var(--line);border-radius:12px;font-size:var(--f1);color:var(--mut);font-variant-numeric:tabular-nums}
#ledgerstrip b{color:var(--fg)}
#ledgerstrip .offline{color:var(--warn)}
#ledgertiers{display:grid;gap:20px;margin:14px 0 0}
/* min-width:0 is LOAD-BEARING, not tidying. A grid item defaults to
   min-width:auto, so it refuses to shrink below its min-content width. The land
   kanban (.lrkb) holds five rigid 250px columns = 1282px min-content, and a
   plain block's min-content propagates upward even though .lrkb already carries
   overflow-x:auto. So #tierpipeline was pinned at 1312px inside its 1108px
   track and spilled 204px past the right edge of .wrap — which reads to the eye
   as "the whole page is shoved right", because .wrap itself stayed centred
   while every tier under it hung off the right. Releasing the automatic minimum
   on the tier chain lets the shrink reach .lrkb, where the existing
   overflow-x:auto finally does its job and the kanban scrolls in its own box. */
.ltier{display:grid;gap:9px;min-width:0}
.ltier>*{min-width:0}
.ltierhead{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;font-size:var(--f1);color:var(--sub);line-height:1.35}
.ltierhead b{font-size:var(--f0);text-transform:uppercase;letter-spacing:.08em;color:var(--fg);white-space:nowrap}
.ltiergrid{display:grid;grid-template-columns:1fr;gap:14px;align-items:start;min-width:0}
@media(min-width:860px){.ltiergrid{grid-template-columns:5fr 3fr}}
/* the unsigned tier reads visually second-class: dashed, never solid */
#tierlocal .lcard{border-style:dashed}
.lseat{font-family:ui-monospace,monospace;font-weight:700}
.lcard{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.lcard>h3{margin:0;padding:10px 14px;border-bottom:1px solid var(--line);font-size:var(--f0);font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--sub);display:flex;gap:8px;align-items:baseline}
.lcard>h3 .lsub{margin-left:auto;text-transform:none;letter-spacing:0;font-weight:400;font-size:var(--f1)}
.lrows{max-height:68vh;overflow-y:auto}
.lrow{padding:8px 14px;border-bottom:1px solid var(--line);font-size:var(--f2)}
.lrow:last-child{border-bottom:none}
.lrow:hover{background:var(--hover)}
.lhead{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.lhead .lidx{font-weight:700;font-variant-numeric:tabular-nums}
.lhead .lage{margin-left:auto;color:var(--sub);font-size:var(--f1);white-space:nowrap;font-variant-numeric:tabular-nums}
.seatrn{font-size:var(--f0);padding:1px 8px;border-radius:6px;background:none;border:1px solid var(--line);color:var(--mut);cursor:pointer}
.seatjump{cursor:pointer;border-radius:5px;padding:0 3px;margin:0 -3px}
.seatjump:hover{background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent)}
.ephsa summary:hover{color:var(--fg)}
.seatpop{position:fixed;z-index:60;min-width:230px;max-width:320px;background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.4);padding:12px 14px;font-size:var(--f2)}
.spname{font-family:ui-monospace,monospace;font-weight:700;font-size:var(--f3);margin-bottom:8px;word-break:break-all}
.spgrid{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;align-items:baseline}
.spk{color:var(--sub);font-size:var(--f0);text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}
.spv{color:var(--fg);font-size:var(--f1);word-break:break-word}
.spjump{margin-top:10px;width:100%;text-align:left;font-size:var(--f1);padding:6px 10px;border-radius:7px;background:color-mix(in srgb,var(--accent) 14%,transparent);border:1px solid var(--accent);color:var(--accent);cursor:pointer}
.spjump:hover{background:color-mix(in srgb,var(--accent) 24%,transparent)}
/* the dregg ticker, FOLDED INTO the dashboard's RECORD row (owner:
   "i dont love duplication of UI" — one signing pulse, one place; it was born
   as a global strip per an earlier ask and the dashboard superseded that
   position). Same 8s pulse, same click -> the full ledger tab. */
#dreggstrip{color:var(--mut);cursor:pointer;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#dreggstrip:hover{color:var(--fg)}
#dreggstrip .dsok{color:var(--ok);font-weight:var(--w-med)}
#dreggstrip .dsbad{color:var(--warn);font-weight:var(--w-med)}
#dreggstrip .dsturn{color:var(--fg)}
#dreggstrip .dslink{color:var(--accent)}

