/* ---------- FLEET › MODELS (task/3448) ----------
   The model scorecard: a totals line, one ranked table, a model's detail in
   place, and the apprenticeship rungs under it. The table's own tokens are
   the credit table's: tabular numerals, a hairline between rows, colour as
   signal only. A thin row (prior only) is quieter than a measured one. */
#modelscard,#modelsrungs{margin:14px 0 0;padding:12px 14px;background:var(--card);border:1px solid var(--line);border-radius:14px}
#modelsrungs:empty{display:none}
#modelscard .qonetop{align-items:center}
#modelswin{display:inline-flex;gap:6px}
#modelswin .chip{padding:4px 10px;font-size:var(--f1)}
.mlink{margin-left:auto;color:var(--accent);text-decoration:none;font-size:var(--f1)}
.mlink:hover,.mlink:focus-visible{text-decoration:underline}
.mtotals{margin:4px 2px 10px;font-size:var(--f2)}
.mtotals .gmeta{display:block;margin-top:2px;white-space:normal}
/* the page's long lines (the rungs' evidence, a model's sources) wrap: the
   global .gmeta is one line, which pushed this page past the viewport */
#view-models .gmeta{white-space:normal}
.mrung .gmeta,.mdet .gmeta{display:block}
.mempty{padding:10px 2px;color:var(--mut)}
.munk{color:var(--warn)}
.mscroll{overflow-x:auto}
/* the lanes no model is named for: one line under the table, not a row */
.mfoot{display:block;margin:8px 2px 0}
table.mtable{width:100%;border-collapse:collapse;font-size:var(--f2)}
table.mtable th{text-align:left;font-size:var(--f0);text-transform:uppercase;letter-spacing:.06em;color:var(--mut);padding:6px 10px;border-bottom:1px solid var(--line2);font-weight:600;white-space:nowrap}
table.mtable td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:baseline}
table.mtable .mnum{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr.mrow{cursor:pointer}
tr.mrow:hover td,tr.mrow.open td{background:var(--hover)}
tr.mrow.mthin td{color:var(--sub)}
.mname .gmeta{display:block;font-size:var(--f0)}
.mscore b{font-size:var(--f3);font-variant-numeric:tabular-nums}
.mband{color:var(--mut);font-size:var(--f1);font-variant-numeric:tabular-nums}
tr.mdetail td{background:var(--bg)}
.mdet{display:grid;gap:6px;padding:4px 2px;font-size:var(--f2)}
.mdet a{color:var(--accent)}
.mgap{color:var(--warn)}
.mrung{padding:8px 2px;border-top:1px solid var(--line)}
.mrungword{padding:1px 8px;border-radius:var(--r-pill);border:1px solid var(--line2);font-size:var(--f1)}
.tsn a,a.tsn{color:inherit;text-decoration:none}
a.tsn:hover,a.tsn:focus-visible{color:var(--accent);text-decoration:underline}
